---
import keychainIcon from '@/assets/dapps/keychain.svg'

interface DownloadDef {
  readonly id: string
  readonly label: string
  readonly href: string
  readonly badge: string
}

const downloads: readonly DownloadDef[] = [
  {
    id: 'chrome',
    label: 'Chrome',
    href: 'https://chrome.google.com/webstore/detail/hive-keychain/jcacnejopjdphbnjgfaaobbfafkihpep?hl=en',
    badge: 'Extensión',
  },
  {
    id: 'firefox',
    label: 'Firefox',
    href: 'https://addons.mozilla.org/en-US/firefox/addon/hive-keychain/',
    badge: 'Extensión',
  },
  {
    id: 'android',
    label: 'Android',
    href: 'https://play.google.com/store/apps/details?id=com.mobilekeychain',
    badge: 'Google Play',
  },
  {
    id: 'ios',
    label: 'iOS',
    href: 'https://apps.apple.com/us/app/hive-keychain/id1552190010',
    badge: 'App Store',
  },
]

const iconPath: Record<string, string> = {
  chrome: '/assets/chrome.svg',
  firefox: '/assets/firefox.svg',
  android: '/assets/android.svg',
  ios: '/assets/ios.svg',
}
---

<section id="keychain" class="mx-auto max-w-5xl px-6 py-24">
  <div class="mb-14 text-center">
    <img
      src={keychainIcon.src}
      alt="Hive Keychain"
      class="w-18 mx-auto mb-6 h-auto"
    />
    <h2
      class="text-foreground mb-2 text-2xl font-bold tracking-tight md:text-3xl"
    >
      Descargar Hive Keychain
    </h2>
    <p class="text-muted-foreground text-sm">
      Gestiona tus claves y firma transacciones
    </p>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {
      downloads.map(d => (
        <a
          href={d.href}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border bg-card hover:border-primary/40 focus:ring-primary/40 group flex flex-col items-center gap-3 rounded-lg border px-4 py-6 text-center transition-colors focus:outline-none focus:ring-2"
          data-download={d.id}
        >
          <img
            src={iconPath[d.id]}
            alt={d.label}
            class="h-8 w-8 opacity-60 transition-opacity group-hover:opacity-100"
          />
          <div class="flex flex-col items-center gap-1">
            <span class="text-foreground text-sm font-semibold">{d.label}</span>
            <span class="text-muted-foreground text-[11px] uppercase tracking-wide">
              {d.badge}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
