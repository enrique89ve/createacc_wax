---
import peakdIcon from '@/assets/dapps/peakd.svg'
import ecencyIcon from '@/assets/dapps/ecency.svg'
import hiveblogIcon from '@/assets/dapps/hiveblog.png'
import threespeakIcon from '@/assets/dapps/threespeak.svg'
import inleoIcon from '@/assets/dapps/inleo.avif'
import liketuIcon from '@/assets/dapps/liketu.png'
import { Image } from 'astro:assets'

interface AppDef {
  readonly id: string
  readonly name: string
  readonly href: string
  readonly description: string
  readonly icon: ImageMetadata | string
  readonly favorite?: boolean
}

const apps: readonly AppDef[] = [
  {
    id: 'peakd',
    name: 'PeakD',
    href: 'https://peakd.com',
    description: 'Plataforma social avanzada',
    icon: peakdIcon,
    favorite: true,
  },
  {
    id: 'hiveblog',
    name: 'Hive.blog',
    href: 'https://hive.blog',
    description: 'Portal social clásico',
    icon: hiveblogIcon,
  },
  {
    id: 'threespeak',
    name: '3Speak',
    href: 'https://3speak.tv',
    description: 'Video descentralizado',
    icon: threespeakIcon,
    favorite: true,
  },
  {
    id: 'ecency',
    name: 'Ecency',
    href: 'https://ecency.com',
    description: 'Social + mobile',
    icon: ecencyIcon,
  },
  {
    id: 'inleo',
    name: 'InLeo',
    href: 'https://inleo.io',
    description: 'Microblogging & finance',
    icon: inleoIcon,
  },
  {
    id: 'liketu',
    name: 'Liketu',
    href: 'https://liketu.com',
    description: 'Fotos y lifestyle',
    icon: liketuIcon,
    favorite: true,
  },
]
---

<section class="mx-auto max-w-6xl py-24" id="apps">
  <div class="mb-12 text-center">
    <h2
      class="text-foreground mb-3 text-3xl font-bold tracking-tight md:text-4xl"
    >
      Aplicaciones del ecosistema
    </h2>
    <p
      class="text-muted-foreground mx-auto max-w-2xl text-sm leading-relaxed md:text-base"
    >
      Explora y comienza a interactuar con la comunidad usando estas DApps.
    </p>
  </div>

  <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      apps.map(app => (
        <a
          href={app.href}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border/60 bg-card/70 hover:bg-card focus:ring-primary/40 group relative flex flex-col items-center rounded-xl border p-6 text-center backdrop-blur transition-all hover:-translate-y-1 focus:outline-none focus:ring-2"
          data-app={app.id}
          aria-label={`${app.name} - ${app.description}`}
        >
          {app.favorite && (
            <span class="bg-primary text-primary-foreground absolute right-3 top-3 rounded-full px-2 py-1 text-[10px] font-semibold uppercase tracking-wide shadow">
              Favorita
            </span>
          )}
          <div class="flex h-16 w-16 items-center justify-center">
            {typeof app.icon === 'string' ? (
              <img
                src={app.icon}
                alt=""
                aria-hidden="true"
                class="max-h-full max-w-full object-contain"
              />
            ) : (
              <Image
                src={app.icon}
                alt={'Icono' + app.name}
                aria-hidden="true"
                class="max-h-full max-w-full object-contain"
              />
            )}
          </div>
          <div class="mt-5 flex w-full flex-1 flex-col">
            <span class="text-foreground group-hover:text-primary text-base font-semibold tracking-tight transition-colors">
              {app.name}
            </span>
            <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
              {app.description}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>
