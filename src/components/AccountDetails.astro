---
import { DEFAULT_LOCALE, getMessages } from '@/i18n'
import DownloadFormatModal from '@/components/ui/DownloadFormatModal.astro'
import ProgressModal from '@/components/ui/ProgressModal.astro'
import Tooltip from '@/components/ui/Tooltip.astro'

interface Props {
  readonly username: string
  readonly ticket?: string
}

const { username, ticket } = Astro.props
const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
---

<section class="flex w-full items-start justify-center px-4 py-2 md:px-6">
  <div class="w-full max-w-lg">
    <div
      class="border-border bg-card/95 supports-[backdrop-filter]:bg-card/90 rounded-xl border p-4 shadow-lg backdrop-blur sm:p-6"
    >
      <header
        class="mb-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-left"
      >
        <h1
          class="text-foreground text-xl font-bold tracking-tight sm:text-2xl"
        >
          {copy.details.title}
        </h1>
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-muted-foreground text-xs font-medium sm:text-sm">
            {copy.details.accountToCreate}
          </p>
          <span
            class="border-border text-primary inline-flex w-fit items-center rounded-md border bg-white px-2 py-1 text-base font-semibold"
            data-username={username}
            data-ticket={ticket ?? ''}>@{username}</span
          >
        </div>
      </header>
      <!-- Keys Container (always visible) -->
      <div id="keys-container" class="space-y-3">
        <p class="text-foreground mb-2 text-xs font-semibold">
          {copy.details.masterPasswordLabel}:
        </p>
        <div
          class="border-border bg-background relative min-h-[2.75rem] overflow-hidden rounded-md border px-2 text-xs leading-relaxed transition-colors motion-reduce:transition-none"
        >
          <!-- Loading State inside key field -->
          <div
            id="key-loading"
            class="flex h-full min-h-[2rem] items-center justify-center gap-3 transition-opacity duration-300 motion-reduce:transition-none"
          >
            <div role="status">
              <svg
                aria-hidden="true"
                class="inline h-6 w-6 animate-spin fill-gray-600 text-gray-200 motion-reduce:animate-none dark:fill-gray-300 dark:text-gray-600"
                viewBox="0 0 100 101"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z"
                  fill="currentColor"></path>
                <path
                  d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z"
                  fill="currentFill"></path>
              </svg>
              <span class="sr-only">{copy.common.loading}</span>
            </div>
            <p class="text-foreground text-sm">
              {copy.details.generatingKeys}
            </p>
          </div>
          <div class="flex min-h-[2.75rem] items-center gap-1">
            <div id="master-key-content" class="min-w-0 flex-1">
              <p
                id="master-key-placeholder"
                class="text-muted-foreground hidden min-h-[2.75rem] min-w-0 items-center font-mono text-base tracking-[0.28em]"
              >
                <span aria-hidden="true">••••••••••••</span>
                <span class="sr-only">{copy.details.masterPasswordHidden}</span>
              </p>
              <p
                id="master-key-display"
                class="text-foreground/90 focus-visible:ring-primary/40 hidden min-h-[2.75rem] min-w-0 select-all items-center overflow-x-auto whitespace-nowrap font-mono text-xs tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset"
                tabindex="0"
              >
              </p>
            </div>
            <button
              type="button"
              id="btn-reveal-master"
              class="text-muted-foreground hover:bg-muted/60 hover:text-foreground focus-visible:ring-primary/40 hidden min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 motion-reduce:transition-none"
              aria-label={copy.details.showMasterPassword}
              aria-pressed="false"
              aria-controls="master-key-content"
            >
              <svg
                aria-hidden="true"
                data-reveal-icon="show"
                class="h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"
                ></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg
                aria-hidden="true"
                data-reveal-icon="hide"
                class="hidden h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m3 3 18 18"></path>
                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                <path
                  d="M9.9 5.2A11 11 0 0 1 12 5c6.5 0 10 7 10 7a15 15 0 0 1-3 3.8"
                ></path>
                <path d="M6.6 6.6C3.7 8.4 2 12 2 12s3.5 7 10 7c1 0 2-.2 2.9-.5"
                ></path>
              </svg>
            </button>
          </div>
        </div>
        <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
          {copy.details.beforeContinueHelp}
        </p>
        <div class="mt-4 grid w-full grid-cols-2 gap-2">
          <button
            type="button"
            id="btn-download-keys"
            class="border-border inline-flex min-h-12 w-full cursor-pointer items-center justify-center whitespace-nowrap rounded-md border bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm transition-colors hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-300 disabled:cursor-not-allowed disabled:opacity-60 motion-reduce:transition-none"
            aria-label={copy.details.downloadKeysAria}
            disabled
          >
            {copy.common.download}
          </button>
          <button
            type="button"
            id="btn-copy-master"
            class="border-border bg-background text-foreground hover:bg-muted inline-flex min-h-12 w-full cursor-pointer items-center justify-center whitespace-nowrap rounded-md border px-3 py-2 text-sm font-medium shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-300 disabled:cursor-not-allowed disabled:opacity-60 motion-reduce:transition-none"
            aria-label={copy.details.copyMasterPassword}
            aria-live="polite"
            disabled
          >
            {copy.details.copy}
          </button>
        </div>
      </div>
      <form
        id="form-confirm"
        class="mt-6 space-y-4"
        aria-busy="false"
        aria-describedby="form-error"
      >
        <div class="space-y-2">
          <label
            class="text-foreground hover:bg-muted/50 focus-within:bg-muted/50 hover:border-border/30 group flex cursor-pointer select-none items-center gap-3 rounded-lg border border-transparent px-3 py-3 transition-all duration-200 motion-reduce:transition-none sm:gap-3"
          >
            <input
              id="chk-keys-safety"
              type="checkbox"
              class="peer sr-only focus-visible:outline-none"
              aria-labelledby="chk-keys-safety-label"
            />
            <span
              class="border-muted-foreground/40 peer-focus-visible:outline-primary/40 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground hover:border-muted-foreground/60 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-md border-2 bg-white text-transparent transition-all duration-200 ease-out peer-checked:scale-105 peer-checked:shadow-md peer-focus-visible:outline peer-focus-visible:outline-offset-2 motion-reduce:transform-none motion-reduce:transition-none peer-checked:[&>svg]:opacity-100"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4 opacity-0 transition-all duration-200 peer-checked:opacity-100 motion-reduce:transition-none"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 5.29a1 1 0 0 1 0 1.42l-7.01 7.01a1 1 0 0 1-1.414 0L3.296 8.737a1 1 0 1 1 1.414-1.414l4.012 4.011 6.303-6.303a1 1 0 0 1 1.414 0Z"
                  clip-rule="evenodd"></path>
              </svg>
            </span>
            <span
              id="chk-keys-safety-label"
              class="text-foreground/90 min-w-0 flex-1 text-sm font-medium leading-snug sm:text-sm"
            >
              {copy.details.keysSafetyCheckbox}
            </span>
          </label>
        </div>
        <div id="form-error" class="sr-only" role="status" aria-live="polite">
        </div>
        <div class="relative">
          <button
            id="btn-create-account"
            type="submit"
            disabled
            data-default-label={copy.details.createAccount}
            data-loading-label={copy.details.creatingAccount}
            data-tooltip-target="tooltip-download-keys"
            data-tooltip-style="light"
            class="bg-primary text-primary-foreground hover:enabled:bg-primary/90 focus-visible:ring-primary/40 w-full cursor-pointer rounded-lg px-5 py-3 text-sm font-semibold tracking-wide shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 disabled:cursor-not-allowed disabled:opacity-60 motion-reduce:transition-none"
          >
            {copy.details.createAccount}
          </button>
          <Tooltip
            id="tooltip-download-keys"
            message={copy.details.downloadKeysRequired}
            style="light"
          />
        </div>
      </form>
    </div>
  </div>

  <!-- Modal to select download format -->
  <DownloadFormatModal />

  <!-- Account creation progress modal (pre-rendered, updated via JS) -->
  <ProgressModal />

  <script>
    import { publicCopy } from '@/i18n'
    import type { DownloadFormat } from '@/utils/key-download-manager'
    import type {
      ExtendedWindow,
      DOMElements,
      AppState,
    } from '@/lib/details/types'
    import { KEYS_SESSION_KEY } from '@/lib/details/types'
    import {
      ClientKeySession,
      KEY_SESSION_PHASE,
      bindActiveKeySession,
      destroyActiveKeySession,
    } from '@/lib/details/client-key-session'
    import {
      confirmKeysDownloaded,
      initiateKeyDownload,
      preSolvePowBundle,
    } from '@/lib/details/download-handler'
    import {
      resolvePow,
      submitAccountCreation,
    } from '@/lib/details/account-submit'
    import { getAccountCreationMessage } from '@/lib/details/account-creation-message'
    import { recoverCreationSessionForKeyConfirmation } from '@/lib/details/session-recovery'
    import {
      showProgressModal,
      hideProgressModal,
      updateStepStates,
      showProgressError,
      hideProgressError,
    } from '@/lib/details/progress-controller'

    class AccountDetailsManager {
      private elements: DOMElements
      private state: AppState
      private isSubmitting = false
      private isGeneratingKeys = false
      private isConfirmingKeys = false
      private keyConfirmationPromise: Promise<boolean> | null = null
      private tornDown = false
      private sessionRecoveryPromise: Promise<boolean> | null = null
      private copyFeedbackTimeout: number | undefined
      private readonly pageAbort = new AbortController()
      private readonly extWindow = window as Window & ExtendedWindow

      constructor() {
        this.elements = this.queryDOM()
        this.state = this.initializeState()
        this.setupEventListeners()
        this.setupGlobalMethods()
      }

      private queryDOM(): DOMElements {
        return {
          keysSafetyConfirmed:
            document.querySelector<HTMLInputElement>('#chk-keys-safety'),
          submitBtn: document.querySelector<HTMLButtonElement>(
            '#btn-create-account'
          ),
          downloadBtn:
            document.querySelector<HTMLButtonElement>('#btn-download-keys'),
          copyBtn:
            document.querySelector<HTMLButtonElement>('#btn-copy-master'),
          revealBtn:
            document.querySelector<HTMLButtonElement>('#btn-reveal-master'),
          loadingEl: document.querySelector<HTMLElement>('#key-loading'),
          keysContainer: document.querySelector<HTMLElement>('#keys-container'),
          masterKeyDisplay: document.querySelector<HTMLElement>(
            '#master-key-display'
          ),
          masterKeyPlaceholder: document.querySelector<HTMLElement>(
            '#master-key-placeholder'
          ),
          formError: document.querySelector<HTMLElement>('#form-error'),
          form: document.querySelector<HTMLFormElement>('#form-confirm'),
          progressModal: document.querySelector<HTMLElement>('#progress-modal'),
          progressErrorActions: document.querySelector<HTMLElement>(
            '[data-progress-error-actions]'
          ),
          closeProgressBtn: document.querySelector<HTMLButtonElement>(
            '#btn-close-progress'
          ),
          retryKeyConfirmationBtn: document.querySelector<HTMLButtonElement>(
            '#btn-retry-key-confirmation'
          ),
          keyConfirmationStatus: document.querySelector<HTMLElement>(
            '#key-confirmation-status'
          ),
        }
      }

      private initializeState(): AppState {
        const usernameEl =
          document.querySelector<HTMLElement>('[data-username]')
        const username = usernameEl?.getAttribute('data-username') || ''
        const ticketAttr = usernameEl?.getAttribute('data-ticket')?.trim()
        const ticket = ticketAttr ? ticketAttr : undefined

        return {
          keySession: null,
          masterKeyRevealed: false,
          username,
          keysConfirmedOnServer: false,
          ticket,
          preSolvedBundle: null,
        }
      }

      private hasBackup(): boolean {
        return (
          this.state.keySession?.phase === KEY_SESSION_PHASE.BACKUP_CONFIRMED
        )
      }

      private async recoverCreationSession(): Promise<boolean> {
        if (this.sessionRecoveryPromise) return this.sessionRecoveryPromise

        this.sessionRecoveryPromise = (async (): Promise<boolean> => {
          return recoverCreationSessionForKeyConfirmation(
            this.state.username,
            this.state.ticket
          ).finally(() => {
            this.sessionRecoveryPromise = null
          })
        })()

        return this.sessionRecoveryPromise
      }

      private async generateKeys(): Promise<void> {
        if (this.isGeneratingKeys || this.tornDown) return
        this.isGeneratingKeys = true
        try {
          if (!this.state.username) throw new Error('Username not found')

          const session = await ClientKeySession.generate(this.state.username)
          if (this.tornDown) {
            session.destroy()
            return
          }
          bindActiveKeySession(session)
          this.state.keySession = session
          this.state.masterKeyRevealed = false

          const storedKeyset = sessionStorage.getItem(KEYS_SESSION_KEY)
          if (storedKeyset === session.keysetId) {
            session.confirmBackup()
          }

          const nav = performance.getEntriesByType('navigation')[0]
          const isReload =
            nav && (nav as PerformanceNavigationTiming).type === 'reload'
          if (isReload && this.extWindow.showToast) {
            this.extWindow.showToast(
              'warning',
              publicCopy().details.reloadNewKeys,
              6000
            )
          }

          this.showGeneratedKeyUi()
        } catch {
          if (!this.tornDown) this.showErrorState()
        } finally {
          this.isGeneratingKeys = false
        }
      }

      private showGeneratedKeyUi(): void {
        this.elements.loadingEl?.classList.add('opacity-0')

        setTimeout(() => {
          this.elements.loadingEl?.classList.add('hidden')
          this.hideMasterInDom()
          this.elements.masterKeyPlaceholder?.classList.remove('hidden')
          this.elements.masterKeyPlaceholder?.classList.add('flex')
          this.elements.revealBtn?.classList.remove('hidden')
          this.elements.revealBtn?.classList.add('flex')
          this.elements.downloadBtn?.removeAttribute('disabled')
          this.elements.copyBtn?.removeAttribute('disabled')
        }, 300)
      }

      private hideMasterInDom(): void {
        if (this.elements.masterKeyDisplay) {
          this.elements.masterKeyDisplay.textContent = ''
          this.elements.masterKeyDisplay.classList.add('hidden')
          this.elements.masterKeyDisplay.classList.remove(
            'flex',
            'items-center'
          )
        }
        this.elements.masterKeyPlaceholder?.classList.remove('hidden')
        this.elements.masterKeyPlaceholder?.classList.add('flex')
        this.setMasterRevealControl(false)
        this.state.masterKeyRevealed = false
      }

      private revealMasterInDom(): void {
        const session = this.state.keySession
        if (!session || !session.isAlive() || !this.elements.masterKeyDisplay)
          return

        this.elements.masterKeyPlaceholder?.classList.add('hidden')
        this.elements.masterKeyPlaceholder?.classList.remove('flex')
        this.elements.masterKeyDisplay.textContent = session.revealMaster()
        this.elements.masterKeyDisplay.classList.remove('hidden')
        this.elements.masterKeyDisplay.classList.add('flex', 'items-center')
        this.setMasterRevealControl(true)
        this.state.masterKeyRevealed = true
      }

      private setMasterRevealControl(revealed: boolean): void {
        const button = this.elements.revealBtn
        if (!button) return

        const copy = publicCopy().details
        button.setAttribute('aria-pressed', String(revealed))
        button.setAttribute(
          'aria-label',
          revealed ? copy.hideMasterPassword : copy.showMasterPassword
        )
        button
          .querySelector('[data-reveal-icon="show"]')
          ?.classList.toggle('hidden', revealed)
        button
          .querySelector('[data-reveal-icon="hide"]')
          ?.classList.toggle('hidden', !revealed)
      }

      private toggleMasterReveal(): void {
        if (this.state.masterKeyRevealed) {
          this.hideMasterInDom()
          return
        }
        this.revealMasterInDom()
      }

      private async handleCopyMasterPassword(): Promise<void> {
        const session = this.state.keySession
        const button = this.elements.copyBtn
        if (!session?.isAlive() || !button) return

        const copy = publicCopy().details
        try {
          await navigator.clipboard.writeText(session.revealMaster())
        } catch {
          if (this.extWindow.showToast) {
            this.extWindow.showToast(
              'error',
              copy.masterPasswordCopyFailed,
              6000
            )
          } else {
            alert(copy.masterPasswordCopyFailed)
          }
          return
        }

        if (this.tornDown) return
        if (this.copyFeedbackTimeout !== undefined) {
          window.clearTimeout(this.copyFeedbackTimeout)
        }
        button.textContent = copy.copied
        button.setAttribute('aria-label', copy.masterPasswordCopied)
        this.copyFeedbackTimeout = window.setTimeout(() => {
          button.textContent = copy.copy
          button.setAttribute('aria-label', copy.copyMasterPassword)
          this.copyFeedbackTimeout = undefined
        }, 1600)
      }

      teardownSecrets(): void {
        this.tornDown = true
        this.hideMasterInDom()
        if (this.copyFeedbackTimeout !== undefined) {
          window.clearTimeout(this.copyFeedbackTimeout)
          this.copyFeedbackTimeout = undefined
        }
        if (this.elements.copyBtn) {
          const copy = publicCopy().details
          this.elements.copyBtn.textContent = copy.copy
          this.elements.copyBtn.setAttribute(
            'aria-label',
            copy.copyMasterPassword
          )
        }
        this.state.keySession?.destroy()
        this.state.keySession = null
        destroyActiveKeySession()
        if (!this.pageAbort.signal.aborted) {
          this.pageAbort.abort()
        }
      }

      private showErrorState(): void {
        if (!this.elements.loadingEl) return
        this.elements.loadingEl.replaceChildren()

        const errorContainer = document.createElement('div')
        errorContainer.className =
          'flex flex-col items-center justify-center gap-2 py-2 text-red-400'

        const errorIcon = document.createElement('span')
        errorIcon.textContent = '\u2717'

        const errorMessage = document.createElement('p')
        errorMessage.className = 'text-sm'
        errorMessage.textContent = publicCopy().details.generateKeysError

        errorContainer.appendChild(errorIcon)
        errorContainer.appendChild(errorMessage)

        const retryButton = document.createElement('button')
        retryButton.type = 'button'
        retryButton.className =
          'rounded-md border border-border px-3 py-1 text-sm text-foreground hover:bg-muted'
        retryButton.textContent = publicCopy().details.retryKeyGeneration
        retryButton.addEventListener('click', () => void this.generateKeys(), {
          once: true,
        })
        errorContainer.appendChild(retryButton)
        this.elements.loadingEl.appendChild(errorContainer)
      }

      private updateSubmitState(): void {
        if (!this.elements.submitBtn || !this.elements.keysSafetyConfirmed)
          return

        const ok =
          this.elements.keysSafetyConfirmed.checked &&
          this.hasBackup() &&
          this.state.keysConfirmedOnServer
        this.elements.submitBtn.disabled = !ok
        this.elements.submitBtn.title = !this.hasBackup()
          ? publicCopy().details.submitDisabledTitle
          : !this.state.keysConfirmedOnServer
            ? publicCopy().details.keyConfirmationRequired
            : ''

        if (this.hasBackup()) {
          const tooltipTarget = this.elements.submitBtn.getAttribute(
            'data-tooltip-target'
          )
          if (tooltipTarget) {
            this.elements.submitBtn.removeAttribute('data-tooltip-target')
            document.getElementById(tooltipTarget)?.remove()
          }
        }
      }

      private openDownloadModal(): void {
        const modal = document.querySelector('#download-format-modal')
        modal?.classList.remove('hidden')
        modal?.classList.add('flex')
      }

      private closeDownloadModal(): void {
        const modal = document.querySelector('#download-format-modal')
        modal?.classList.add('hidden')
        modal?.classList.remove('flex')
      }

      private confirmKeysOnServer(): Promise<boolean> {
        if (this.keyConfirmationPromise) return this.keyConfirmationPromise
        if (this.state.keysConfirmedOnServer) return Promise.resolve(true)
        const session = this.state.keySession
        if (!session || !session.isAlive()) return Promise.resolve(false)

        this.isConfirmingKeys = true
        const confirmationPromise = (async (): Promise<boolean> => {
          try {
            const result = await confirmKeysDownloaded(
              session.getPublicKeys(),
              () => this.recoverCreationSession()
            )
            const confirmed = result.status === 'confirmed'
            if (confirmed) {
              this.state.keysConfirmedOnServer = true
              this.elements.retryKeyConfirmationBtn?.classList.add('hidden')
              if (this.elements.keyConfirmationStatus) {
                this.elements.keyConfirmationStatus.textContent =
                  publicCopy().details.keyConfirmationSucceeded
                this.elements.keyConfirmationStatus.classList.remove('hidden')
                this.elements.keyConfirmationStatus.classList.remove(
                  'text-destructive'
                )
                this.elements.keyConfirmationStatus.classList.add(
                  'text-green-500'
                )
              }
            } else {
              this.elements.retryKeyConfirmationBtn?.classList.remove('hidden')
              if (this.elements.keyConfirmationStatus) {
                this.elements.keyConfirmationStatus.textContent =
                  publicCopy().details.keyConfirmationFailed
                this.elements.keyConfirmationStatus.classList.remove(
                  'hidden',
                  'text-green-500'
                )
                this.elements.keyConfirmationStatus.classList.add(
                  'text-destructive'
                )
              }
            }
            return confirmed
          } catch {
            this.elements.retryKeyConfirmationBtn?.classList.remove('hidden')
            return false
          } finally {
            this.isConfirmingKeys = false
            this.keyConfirmationPromise = null
            this.updateSubmitState()
          }
        })()
        this.keyConfirmationPromise = confirmationPromise
        return confirmationPromise
      }

      private async handleKeyConfirmationRetry(): Promise<void> {
        if (this.isConfirmingKeys) return
        const button = this.elements.retryKeyConfirmationBtn
        if (button) {
          button.disabled = true
          button.textContent = publicCopy().details.retryingKeyConfirmation
        }

        const confirmed = await this.confirmKeysOnServer()
        if (button) {
          button.disabled = false
          button.textContent = publicCopy().details.retryKeyConfirmation
        }
        if (this.extWindow.showToast) {
          this.extWindow.showToast(
            confirmed ? 'success' : 'error',
            confirmed
              ? publicCopy().details.keyConfirmationSucceeded
              : publicCopy().details.keyConfirmationFailed,
            6000
          )
        }
      }

      private markFormatDownloaded(format: DownloadFormat): void {
        const defaultIcon = document.querySelector<HTMLElement>(
          `#icon-${format}-default`
        )
        const doneIcon = document.querySelector<HTMLElement>(
          `#icon-${format}-done`
        )
        const desc = document.querySelector<HTMLElement>(`#desc-${format}`)

        if (defaultIcon && doneIcon) {
          defaultIcon.classList.add('hidden')
          doneIcon.classList.remove('hidden')
          doneIcon.classList.add('flex')
        }
        if (desc) {
          desc.textContent = publicCopy().details.downloadStarted
          desc.classList.remove('text-muted-foreground')
          desc.classList.add('text-green-500')
        }
      }

      private async handleDownload(format: DownloadFormat): Promise<void> {
        const session = this.state.keySession
        if (!session || !session.isAlive()) return

        try {
          await initiateKeyDownload(session, format)
        } catch {
          if (this.extWindow.showToast) {
            this.extWindow.showToast(
              'error',
              publicCopy().details.fileDownloadFailed
            )
          } else {
            alert(publicCopy().details.fileDownloadFailed)
          }
          return
        }

        this.markFormatDownloaded(format)
        if (session.phase === KEY_SESSION_PHASE.GENERATED) {
          session.confirmBackup()
        }
        sessionStorage.setItem(KEYS_SESSION_KEY, session.keysetId)
        this.updateSubmitState()

        const serverConfirmed = await this.confirmKeysOnServer()
        if (!serverConfirmed && this.extWindow.showToast) {
          this.extWindow.showToast(
            'error',
            publicCopy().details.keyConfirmationFailed,
            8000
          )
        }

        const txtDone = document
          .querySelector<HTMLElement>('#icon-txt-default')
          ?.classList.contains('hidden')
        const pdfDone = document
          .querySelector<HTMLElement>('#icon-pdf-default')
          ?.classList.contains('hidden')
        const bothDone = txtDone && pdfDone
        if (bothDone && serverConfirmed) {
          this.closeDownloadModal()
          if (this.extWindow.showToast) {
            this.extWindow.showToast(
              'success',
              publicCopy().details.keysDownloadedBoth
            )
          }
        }

        if (!this.state.preSolvedBundle) {
          this.state.preSolvedBundle = preSolvePowBundle().catch(() => {
            this.state.preSolvedBundle = null
            return null
          })
        }
      }

      private resetSubmitButton(): void {
        this.elements.form?.setAttribute('aria-busy', 'false')
        if (!this.elements.submitBtn) return
        this.elements.submitBtn.textContent =
          this.elements.submitBtn.dataset.defaultLabel ??
          publicCopy().details.createAccount
        this.elements.submitBtn.disabled = false
        this.updateSubmitState()
      }

      private async handleFormSubmit(e: Event): Promise<void> {
        e.preventDefault()
        const session = this.state.keySession
        if (
          this.isSubmitting ||
          !session ||
          !this.hasBackup() ||
          !this.state.username
        )
          return
        this.isSubmitting = true
        this.elements.form?.setAttribute('aria-busy', 'true')
        if (this.elements.formError) this.elements.formError.textContent = ''

        const { progressModal, progressErrorActions, submitBtn } = this.elements
        if (!progressModal) {
          this.isSubmitting = false
          this.elements.form?.setAttribute('aria-busy', 'false')
          return
        }

        // Show progress modal at step 0
        showProgressModal(progressModal)
        updateStepStates(progressModal, 0, [], -1)
        if (progressErrorActions) hideProgressError(progressErrorActions)

        if (submitBtn) {
          submitBtn.disabled = true
          submitBtn.textContent =
            submitBtn.dataset.loadingLabel ??
            publicCopy().details.creatingAccount
        }

        // Resolve PoW + timing token (throws if token unavailable)
        let pow, timingTokenId
        try {
          const resolved = await resolvePow(this.state.preSolvedBundle)
          this.state.preSolvedBundle = null
          pow = resolved.pow
          timingTokenId = resolved.timingTokenId
        } catch {
          this.state.preSolvedBundle = null
          this.isSubmitting = false
          if (this.elements.formError) {
            this.elements.formError.textContent =
              publicCopy().details.verificationError
          }
          updateStepStates(progressModal, -1, [], 0)
          if (progressErrorActions) showProgressError(progressErrorActions)
          if (this.extWindow.showToast) {
            this.extWindow.showToast(
              'error',
              publicCopy().details.verificationError,
              6000
            )
          }
          this.resetSubmitButton()
          return
        }

        // Step 1: Creating account
        updateStepStates(progressModal, 1, [0], -1)

        let accountRequestStarted = false
        try {
          const publicKeys = session.getPublicKeys()
          accountRequestStarted = true
          const result = await submitAccountCreation(
            this.state.username,
            publicKeys,
            pow,
            timingTokenId
          )

          if (result.status === 'created') {
            const PROGRESS_STEP_DELAY_MS = 300
            const PROGRESS_COMPLETE_DELAY_MS = 400

            updateStepStates(progressModal, 2, [0, 1], -1)
            await new Promise(resolve =>
              setTimeout(resolve, PROGRESS_STEP_DELAY_MS)
            )
            updateStepStates(progressModal, -1, [0, 1, 2], -1)
            await new Promise(resolve =>
              setTimeout(resolve, PROGRESS_COMPLETE_DELAY_MS)
            )

            session.markSubmitted()
            this.teardownSecrets()
            window.location.href = `/success/${this.state.username}`
          } else {
            const outcomeIsUnresolved =
              result.status === 'pending' || result.status === 'unknown'
            updateStepStates(
              progressModal,
              outcomeIsUnresolved ? 1 : -1,
              [0],
              outcomeIsUnresolved ? -1 : 1
            )
            if (progressErrorActions) showProgressError(progressErrorActions)

            const message = getAccountCreationMessage(result)
            if (this.elements.formError) {
              this.elements.formError.textContent = message
            }
            if (this.extWindow.showToast) {
              this.extWindow.showToast('error', message, 8000)
            } else {
              alert(message)
            }
            this.isSubmitting = false
            this.resetSubmitButton()
          }
        } catch {
          const outcomeIsUnresolved = accountRequestStarted
          updateStepStates(
            progressModal,
            outcomeIsUnresolved ? 1 : -1,
            outcomeIsUnresolved ? [0] : [],
            outcomeIsUnresolved ? -1 : 0
          )
          if (progressErrorActions) showProgressError(progressErrorActions)

          const message = outcomeIsUnresolved
            ? getAccountCreationMessage({ status: 'unknown' })
            : publicCopy().details.verificationError
          if (this.elements.formError) {
            this.elements.formError.textContent = message
          }
          if (this.extWindow.showToast) {
            this.extWindow.showToast('error', message, 8000)
          } else {
            alert(message)
          }

          this.isSubmitting = false
          this.resetSubmitButton()
        }
      }

      private setupEventListeners(): void {
        const { signal } = this.pageAbort
        this.elements.keysSafetyConfirmed?.addEventListener(
          'change',
          () => this.updateSubmitState(),
          { signal }
        )

        this.elements.revealBtn?.addEventListener(
          'click',
          () => this.toggleMasterReveal(),
          { signal }
        )
        this.elements.copyBtn?.addEventListener(
          'click',
          () => void this.handleCopyMasterPassword(),
          { signal }
        )

        this.elements.downloadBtn?.addEventListener(
          'click',
          () => {
            if (!this.state.keySession?.isAlive()) return
            this.openDownloadModal()
          },
          { signal }
        )
        this.elements.retryKeyConfirmationBtn?.addEventListener(
          'click',
          () => this.handleKeyConfirmationRetry(),
          { signal }
        )

        this.elements.form?.addEventListener(
          'submit',
          e => this.handleFormSubmit(e),
          { signal }
        )

        this.elements.closeProgressBtn?.addEventListener(
          'click',
          () => {
            if (this.elements.progressModal)
              hideProgressModal(this.elements.progressModal)
            this.resetSubmitButton()
          },
          { signal }
        )

        window.addEventListener('pagehide', () => this.teardownSecrets(), {
          signal,
        })
        window.addEventListener('beforeunload', () => this.teardownSecrets(), {
          signal,
        })
      }

      private setupGlobalMethods(): void {
        this.extWindow.closeDownloadModal = () => this.closeDownloadModal()
        this.extWindow.handleFormatSelection = (format: DownloadFormat) =>
          this.handleDownload(format)
      }

      public async initialize(): Promise<void> {
        await this.generateKeys()
      }
    }

    let currentManager: AccountDetailsManager | null = null

    document.addEventListener('astro:page-load', () => {
      currentManager?.teardownSecrets()
      currentManager = null

      const extWin = window as Window & ExtendedWindow
      extWin.closeDownloadModal = undefined
      extWin.handleFormatSelection = undefined

      const form = document.querySelector<HTMLFormElement>('#form-confirm')
      if (!form) return
      if (form.dataset.initialized) return
      form.dataset.initialized = 'true'

      currentManager = new AccountDetailsManager()
      currentManager.initialize()
    })
  </script>
</section>
