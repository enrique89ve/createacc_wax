---
import DownloadFormatModal from '@/components/ui/DownloadFormatModal.astro'
import ProgressModal from '@/components/ui/ProgressModal.astro'
import Tooltip from '@/components/ui/Tooltip.astro'

interface Props {
	readonly username: string
}

const { username } = Astro.props
---

<section
	class="flex w-full items-start justify-center px-6 py-2 md:items-center"
>
	<div class="w-full max-w-lg">
		<div
			class="border-border bg-card/95 supports-[backdrop-filter]:bg-card/90 rounded-xl border p-6 shadow-lg backdrop-blur"
		>
			<header class="mb-5 flex flex-col items-center gap-2 text-center">
				<h1
					class="text-foreground text-2xl font-bold tracking-tight sm:text-3xl"
				>
					Detalles de la cuenta a crear
				</h1>
			</header>
			<div
				class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:gap-4"
			>
				<p class="text-muted-foreground text-sm font-medium">Cuenta a crear:</p>
				<span
					class="border-border text-primary inline-flex w-fit items-center rounded-md border bg-white px-2 py-1 text-lg font-semibold"
					data-username={username}>@{username}</span
				>
			</div>
			<!-- Keys Container (always visible) -->
			<div id="keys-container" class="space-y-5">
				<p class="text-foreground mb-2 text-xs font-semibold">
					Master Key:
				</p>
				<div class="group">
					<div
						class="border-border bg-background relative min-h-[2.5rem] overflow-hidden rounded-md border px-4 py-2 text-xs leading-relaxed transition-colors group-hover:border-gray-400"
					>
						<!-- Loading State inside key field -->
						<div
							id="key-loading"
							class="flex h-full min-h-[2rem] items-center justify-center gap-3 transition-opacity duration-300"
						>
							<div role="status">
								<svg
									aria-hidden="true"
									class="inline h-6 w-6 animate-spin fill-gray-600 text-gray-200 dark:fill-gray-300 dark:text-gray-600"
									viewBox="0 0 100 101"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z"
										fill="currentColor"></path>
									<path
										d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z"
										fill="currentFill"></path>
								</svg>
								<span class="sr-only">Loading...</span>
							</div>
							<p class="text-foreground text-sm">Generando claves seguras...</p>
						</div>
						<p
							id="master-key-placeholder"
							class="text-muted-foreground hidden min-h-[2rem] items-center font-mono text-[15px] tracking-tight"
						>
							La Master Key está oculta. Pulsa Mostrar para verla.
						</p>
						<p
							id="master-key-display"
							class="text-foreground/90 hidden min-h-[2rem] cursor-pointer break-all font-mono text-[15px] tracking-tight"
							title="Clic para copiar Master Key"
						>
						</p>
						<!-- Copy button overlay (appears on hover) -->
						<button
							id="master-key-copy-btn"
							type="button"
							class="bg-background/70 text-muted-foreground/80 absolute inset-0 hidden cursor-pointer items-center justify-center gap-2 rounded-md text-[12px] font-semibold opacity-0 backdrop-blur-sm transition-all duration-300 hover:opacity-100 focus:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300 group-hover:opacity-100"
							aria-label="Copiar Master Key"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 20 20"
								fill="currentColor"
								class="h-4 w-4"
								aria-hidden="true"
							>
								<path
									d="M6.75 2A2.75 2.75 0 0 0 4 4.75v7.5A2.75 2.75 0 0 0 6.75 15h2.5A2.75 2.75 0 0 0 12 12.25v-7.5A2.75 2.75 0 0 0 9.25 2h-2.5ZM5.5 4.75c0-.69.56-1.25 1.25-1.25h2.5c.69 0 1.25.56 1.25 1.25v7.5c0 .69-.56 1.25-1.25 1.25h-2.5c-.69 0-1.25-.56-1.25-1.25v-7.5Z"
								></path>
								<path
									d="M13.25 5A2.75 2.75 0 0 1 16 7.75v7.5A2.75 2.75 0 0 1 13.25 18h-2.5A2.75 2.75 0 0 1 8 15.25v-1a.75.75 0 0 1 1.5 0v1c0 .69.56 1.25 1.25 1.25h2.5c.69 0 1.25-.56 1.25-1.25v-7.5C14.5 6.56 13.94 6 13.25 6h-1a.75.75 0 0 1 0-1.5h1Z"
								></path>
							</svg>
							<span>Copiar</span>
						</button>
						<!-- Feedback for copy action -->
						<div
							id="master-key-feedback"
							class="pointer-events-none absolute inset-0 hidden items-center justify-center"
							role="status"
							aria-live="polite"
						>
							<span
								class="bg-success/90 text-success-foreground flex items-center gap-2 rounded-md px-3 py-1 text-[12px] font-semibold shadow-sm"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 20 20"
									fill="currentColor"
									class="h-4 w-4"
									aria-hidden="true"
								>
									<path
										fill-rule="evenodd"
										d="M16.704 5.29a1 1 0 0 1 0 1.42l-7.01 7.01a1 1 0 0 1-1.414 0L3.296 8.737a1 1 0 1 1 1.414-1.414l4.012 4.011 6.303-6.303a1 1 0 0 1 1.414 0Z"
										clip-rule="evenodd"></path>
								</svg>
								Master Key copiada
							</span>
						</div>
					</div>
				</div>
				<p class="text-muted-foreground mt-2 text-xs leading-relaxed">
					Descarga o copia tu Master Key antes de continuar.
				</p>
			</div>
			<div
				class="mb-6 mt-4 flex flex-col gap-3 md:flex-row md:items-center md:gap-4"
			>
				<button
					type="button"
					id="btn-download-keys"
					class="border-border inline-flex cursor-pointer items-center justify-center gap-2 rounded-md border bg-white px-4 py-2 text-[0.9rem] font-semibold text-gray-900 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-300"
					aria-label="Descargar claves"
				>
					Descargar claves
					<span aria-hidden="true">🔑</span>
				</button>
				<button
					type="button"
					id="btn-reveal-master"
					class="border-border bg-background text-foreground hover:bg-muted inline-flex cursor-pointer items-center justify-center gap-2 rounded-md border px-4 py-2 text-[0.9rem] font-medium shadow-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300"
					aria-label="Mostrar Master Key"
					aria-pressed="false"
				>
					Mostrar Master Key
				</button>
				<button
					type="button"
					id="btn-copy-master-cta"
					class="border-border bg-background text-foreground hover:bg-muted inline-flex cursor-pointer items-center justify-center gap-2 rounded-md border px-4 py-2 text-[0.9rem] font-medium shadow-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300"
					aria-label="Copiar Master Key"
				>
					Copiar Master Key
					<span aria-hidden="true">🗝️</span>
				</button>
			</div>
			<form id="form-confirm" class="space-y-4">
				<div class="space-y-2">
					<label
						class="text-foreground hover:bg-muted/50 focus-within:bg-muted/50 hover:border-border/30 group flex cursor-pointer select-none items-center gap-3 rounded-lg border border-transparent px-3 py-3 transition-all duration-200 sm:gap-3"
					>
						<input id="chk-keys-saved" type="checkbox" class="peer sr-only" />
						<span
							class="border-muted-foreground/40 peer-focus-visible:outline-primary/40 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground hover:border-muted-foreground/60 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-md border-2 bg-white text-transparent transition-all duration-200 ease-out peer-checked:scale-105 peer-checked:shadow-md peer-focus-visible:outline peer-focus-visible:outline-offset-2 peer-checked:[&>svg]:opacity-100"
							aria-hidden="true"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 20 20"
								fill="currentColor"
								class="h-4 w-4 opacity-0 transition-all duration-200 peer-checked:opacity-100"
							>
								<path
									fill-rule="evenodd"
									d="M16.704 5.29a1 1 0 0 1 0 1.42l-7.01 7.01a1 1 0 0 1-1.414 0L3.296 8.737a1 1 0 1 1 1.414-1.414l4.012 4.011 6.303-6.303a1 1 0 0 1 1.414 0Z"
									clip-rule="evenodd"></path>
							</svg>
						</span>
						<span
							class="text-foreground/90 text-sm font-medium leading-snug sm:text-sm"
						>
							He verificado que mis claves están guardadas.
						</span>
					</label>
					<label
						class="text-foreground hover:bg-muted/50 focus-within:bg-muted/50 hover:border-border/30 group flex cursor-pointer select-none items-center gap-3 rounded-lg border border-transparent px-3 py-3 transition-all duration-200 sm:gap-3"
					>
						<input id="chk-keys-ack" type="checkbox" class="peer sr-only" />
						<span
							class="border-muted-foreground/40 peer-focus-visible:outline-primary/40 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground hover:border-muted-foreground/60 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-md border-2 bg-white text-transparent transition-all duration-200 ease-out peer-checked:scale-105 peer-checked:shadow-md peer-focus-visible:outline peer-focus-visible:outline-offset-2 peer-checked:[&>svg]:opacity-100"
							aria-hidden="true"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 20 20"
								fill="currentColor"
								class="h-4 w-4 opacity-0 transition-all duration-200 peer-checked:opacity-100"
							>
								<path
									fill-rule="evenodd"
									d="M16.704 5.29a1 1 0 0 1 0 1.42l-7.01 7.01a1 1 0 0 1-1.414 0L3.296 8.737a1 1 0 1 1 1.414-1.414l4.012 4.011 6.303-6.303a1 1 0 0 1 1.414 0Z"
									clip-rule="evenodd"></path>
							</svg>
						</span>
						<span
							class="text-foreground/90 text-sm font-medium leading-snug sm:text-sm"
						>
							Reconozco que si pierdo mis claves, pierdo la cuenta.
						</span>
					</label>
				</div>
				<div class="relative">
					<button
						id="btn-create-account"
						type="submit"
						disabled
						data-default-label="Crear cuenta"
						data-loading-label="Creando cuenta..."
						data-tooltip-target="tooltip-download-keys"
						data-tooltip-style="light"
						class="bg-primary text-primary-foreground hover:enabled:bg-primary/90 focus:ring-primary/40 w-full cursor-pointer rounded-lg px-5 py-3 text-sm font-semibold tracking-wide shadow-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-60"
					>
						Crear cuenta
					</button>
					<Tooltip
						id="tooltip-download-keys"
						message="¡Debes descargar las claves!"
						style="light"
					/>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal to select download format -->
	<DownloadFormatModal />

	<!-- Account creation progress modal (pre-rendered, updated via JS) -->
	<ProgressModal />

	<script>
		import type { DownloadFormat } from '@/utils/key-download-manager'
		import { obtainPowSolution } from '@/utils/pow-solver'
		import type { ExtendedWindow, DOMElements, AppState } from '@/lib/details/types'
		import { KEYS_SESSION_KEY } from '@/lib/details/types'
		import {
			ClientKeySession,
			KEY_SESSION_PHASE,
			bindActiveKeySession,
			destroyActiveKeySession,
		} from '@/lib/details/client-key-session'
		import { copyMasterKey } from '@/lib/details/clipboard'
		import { downloadAndNotify, preSolvePowBundle } from '@/lib/details/download-handler'
		import { resolvePow, submitAccountCreation } from '@/lib/details/account-submit'
		import {
			showProgressModal,
			hideProgressModal,
			updateStepStates,
			showProgressError,
			hideProgressError,
		} from '@/lib/details/progress-controller'

		class AccountDetailsManager {
			private elements: DOMElements
			private state: AppState
			private isSubmitting = false
			private tornDown = false
			private sessionRecoveryPromise: Promise<boolean> | null = null
			private readonly pageAbort = new AbortController()
			private readonly extWindow = window as Window & ExtendedWindow

			constructor() {
				this.elements = this.queryDOM()
				this.state = this.initializeState()
				this.setupEventListeners()
				this.setupGlobalMethods()
			}

			private queryDOM(): DOMElements {
				return {
					chk1: document.querySelector<HTMLInputElement>('#chk-keys-saved'),
					chk2: document.querySelector<HTMLInputElement>('#chk-keys-ack'),
					submitBtn: document.querySelector<HTMLButtonElement>('#btn-create-account'),
					copyBtn: document.querySelector<HTMLButtonElement>('#btn-copy-master-cta'),
					downloadBtn: document.querySelector<HTMLButtonElement>('#btn-download-keys'),
					revealBtn: document.querySelector<HTMLButtonElement>('#btn-reveal-master'),
					loadingEl: document.querySelector<HTMLElement>('#key-loading'),
					keysContainer: document.querySelector<HTMLElement>('#keys-container'),
					masterKeyDisplay: document.querySelector<HTMLElement>('#master-key-display'),
					masterKeyPlaceholder: document.querySelector<HTMLElement>('#master-key-placeholder'),
					masterKeyCopyBtn: document.querySelector<HTMLButtonElement>('#master-key-copy-btn'),
					masterKeyFeedback: document.querySelector<HTMLElement>('#master-key-feedback'),
					form: document.querySelector<HTMLFormElement>('#form-confirm'),
					progressModal: document.querySelector<HTMLElement>('#progress-modal'),
					progressErrorActions: document.querySelector<HTMLElement>('[data-progress-error-actions]'),
					closeProgressBtn: document.querySelector<HTMLButtonElement>('#btn-close-progress'),
				}
			}

			private initializeState(): AppState {
				const usernameEl = document.querySelector<HTMLElement>('[data-username]')
				const username = usernameEl?.getAttribute('data-username') || ''

				return {
					keySession: null,
					masterKeyRevealed: false,
					copyFeedbackTimeout: undefined,
					username,
					preSolvedBundle: null,
				}
			}

			private hasBackup(): boolean {
				return this.state.keySession?.phase === KEY_SESSION_PHASE.BACKUP_CONFIRMED
			}

			private async recoverCreationSession(): Promise<boolean> {
				if (this.sessionRecoveryPromise) return this.sessionRecoveryPromise

				this.sessionRecoveryPromise = (async (): Promise<boolean> => {
					try {
						if (!this.state.username) return false
						const pow = await obtainPowSolution()
						const res = await fetch('/api/create/session', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ username: this.state.username, pow }),
						})
						return res.ok
					} catch {
						return false
					} finally {
						this.sessionRecoveryPromise = null
					}
				})()

				return this.sessionRecoveryPromise
			}

			private async generateKeys(): Promise<void> {
				try {
					if (!this.state.username) throw new Error('Username not found')

					const session = await ClientKeySession.generate(this.state.username)
					if (this.tornDown) {
						session.destroy()
						return
					}
					bindActiveKeySession(session)
					this.state.keySession = session
					this.state.masterKeyRevealed = false

					const storedKeyset = sessionStorage.getItem(KEYS_SESSION_KEY)
					if (storedKeyset === session.keysetId) {
						session.confirmBackup()
					}

					const nav = performance.getEntriesByType('navigation')[0]
					const isReload = nav && (nav as PerformanceNavigationTiming).type === 'reload'
					if (isReload && this.extWindow.showToast) {
						this.extWindow.showToast(
							'warning',
							'Se generaron unas claves nuevas. Debes descargar nuevamente.',
							6000
						)
					}

					this.showGeneratedKeyUi()
				} catch {
					this.showErrorState()
				}
			}

			private showGeneratedKeyUi(): void {
				this.elements.loadingEl?.classList.add('opacity-0')

				setTimeout(() => {
					this.elements.loadingEl?.classList.add('hidden')
					this.hideMasterInDom()
					this.elements.masterKeyPlaceholder?.classList.remove('hidden')
					this.elements.masterKeyPlaceholder?.classList.add('flex')
					this.elements.masterKeyCopyBtn?.classList.remove('hidden')
					this.elements.masterKeyCopyBtn?.classList.add('flex')
					this.elements.revealBtn?.classList.remove('hidden')
				}, 300)
			}

			private hideMasterInDom(): void {
				if (this.elements.masterKeyDisplay) {
					this.elements.masterKeyDisplay.textContent = ''
					this.elements.masterKeyDisplay.classList.add('hidden')
					this.elements.masterKeyDisplay.classList.remove('flex', 'items-center')
				}
				this.elements.masterKeyPlaceholder?.classList.remove('hidden')
				this.elements.masterKeyPlaceholder?.classList.add('flex')
				if (this.elements.revealBtn) {
					this.elements.revealBtn.textContent = 'Mostrar Master Key'
					this.elements.revealBtn.setAttribute('aria-pressed', 'false')
					this.elements.revealBtn.setAttribute('aria-label', 'Mostrar Master Key')
				}
				this.state.masterKeyRevealed = false
			}

			private revealMasterInDom(): void {
				const session = this.state.keySession
				if (!session || !session.isAlive() || !this.elements.masterKeyDisplay) return

				this.elements.masterKeyPlaceholder?.classList.add('hidden')
				this.elements.masterKeyPlaceholder?.classList.remove('flex')
				this.elements.masterKeyDisplay.textContent = session.revealMaster()
				this.elements.masterKeyDisplay.classList.remove('hidden')
				this.elements.masterKeyDisplay.classList.add('flex', 'items-center')
				if (this.elements.revealBtn) {
					this.elements.revealBtn.textContent = 'Ocultar Master Key'
					this.elements.revealBtn.setAttribute('aria-pressed', 'true')
					this.elements.revealBtn.setAttribute('aria-label', 'Ocultar Master Key')
				}
				this.state.masterKeyRevealed = true
			}

			private toggleMasterReveal(): void {
				if (this.state.masterKeyRevealed) {
					this.hideMasterInDom()
					return
				}
				this.revealMasterInDom()
			}

			private teardownSecrets(): void {
				this.tornDown = true
				this.hideMasterInDom()
				this.state.keySession?.destroy()
				this.state.keySession = null
				destroyActiveKeySession()
				if (!this.pageAbort.signal.aborted) {
					this.pageAbort.abort()
				}
			}

			private showErrorState(): void {
				if (!this.elements.loadingEl) return
				this.elements.loadingEl.replaceChildren()

				const errorContainer = document.createElement('div')
				errorContainer.className = 'flex items-center justify-center gap-3 text-red-400 py-2'

				const errorIcon = document.createElement('span')
				errorIcon.textContent = '\u2717'

				const errorMessage = document.createElement('p')
				errorMessage.className = 'text-sm'
				errorMessage.textContent = 'Error al generar claves. Por favor recarga la página.'

				errorContainer.appendChild(errorIcon)
				errorContainer.appendChild(errorMessage)
				this.elements.loadingEl.appendChild(errorContainer)
			}

			private updateSubmitState(): void {
				if (!this.elements.submitBtn || !this.elements.chk1 || !this.elements.chk2) return

				const ok = this.elements.chk1.checked && this.elements.chk2.checked && this.hasBackup()
				this.elements.submitBtn.disabled = !ok
				this.elements.submitBtn.title = !this.hasBackup() ? 'You must download the key file first' : ''

				if (this.hasBackup()) {
					const tooltipTarget = this.elements.submitBtn.getAttribute('data-tooltip-target')
					if (tooltipTarget) {
						this.elements.submitBtn.removeAttribute('data-tooltip-target')
						document.getElementById(tooltipTarget)?.remove()
					}
				}
			}

			private async handleCopy(trigger: HTMLElement): Promise<void> {
				const session = this.state.keySession
				if (!session || !session.isAlive()) return
				if (!this.elements.masterKeyFeedback || !this.elements.masterKeyDisplay) return
				this.state.copyFeedbackTimeout = await copyMasterKey(
					session.revealMaster(),
					trigger,
					{ feedback: this.elements.masterKeyFeedback, keyDisplay: this.elements.masterKeyDisplay },
					this.state.copyFeedbackTimeout,
				)
			}

			private openDownloadModal(): void {
				const modal = document.querySelector('#download-format-modal')
				modal?.classList.remove('hidden')
				modal?.classList.add('flex')
			}

			private closeDownloadModal(): void {
				const modal = document.querySelector('#download-format-modal')
				modal?.classList.add('hidden')
				modal?.classList.remove('flex')
			}

			private buildDownloadDeps() {
				return {
					keySession: this.state.keySession!,
					recoverSession: () => this.recoverCreationSession(),
				}
			}

			private markFormatDownloaded(format: DownloadFormat): void {
				const defaultIcon = document.querySelector<HTMLElement>(`#icon-${format}-default`)
				const doneIcon = document.querySelector<HTMLElement>(`#icon-${format}-done`)
				const desc = document.querySelector<HTMLElement>(`#desc-${format}`)

				if (defaultIcon && doneIcon) {
					defaultIcon.classList.add('hidden')
					doneIcon.classList.remove('hidden')
					doneIcon.classList.add('flex')
				}
				if (desc) {
					desc.textContent = 'Descargado'
					desc.classList.remove('text-muted-foreground')
					desc.classList.add('text-green-500')
				}
			}

			private async handleDownload(format: DownloadFormat): Promise<void> {
				const session = this.state.keySession
				if (!session || !session.isAlive()) return

				try {
					await downloadAndNotify(this.buildDownloadDeps(), format)

					this.markFormatDownloaded(format)

					if (session.phase === KEY_SESSION_PHASE.GENERATED) {
						session.confirmBackup()
					}
					sessionStorage.setItem(KEYS_SESSION_KEY, session.keysetId)
					this.updateSubmitState()

					// Auto-close modal when both formats downloaded
					const txtDone = document.querySelector<HTMLElement>('#icon-txt-default')?.classList.contains('hidden')
					const pdfDone = document.querySelector<HTMLElement>('#icon-pdf-default')?.classList.contains('hidden')
					const bothDone = txtDone && pdfDone
					if (bothDone) {
						this.closeDownloadModal()
						if (this.extWindow.showToast) {
							this.extWindow.showToast('success', 'Claves descargadas en TXT y PDF')
						}
					}

					// Pre-solve PoW + timing token in background
					if (!this.state.preSolvedBundle) {
						this.state.preSolvedBundle = preSolvePowBundle().catch(() => {
							this.state.preSolvedBundle = null
							return null
						})
					}
				} catch {
					if (this.extWindow.showToast) {
						this.extWindow.showToast('error', 'Error al descargar las claves. Inténtalo de nuevo.')
					}
				}
			}

			private resetSubmitButton(): void {
				if (!this.elements.submitBtn) return
				this.elements.submitBtn.textContent = this.elements.submitBtn.dataset.defaultLabel ?? 'Create account'
				this.elements.submitBtn.disabled = false
				this.updateSubmitState()
			}

			private async handleFormSubmit(e: Event): Promise<void> {
				e.preventDefault()
				const session = this.state.keySession
				if (this.isSubmitting || !session || !this.hasBackup() || !this.state.username) return
				this.isSubmitting = true

				const { progressModal, progressErrorActions, submitBtn } = this.elements
				if (!progressModal) {
					this.isSubmitting = false
					return
				}

				// Show progress modal at step 0
				showProgressModal(progressModal)
				updateStepStates(progressModal, 0, [], -1)
				if (progressErrorActions) hideProgressError(progressErrorActions)

				if (submitBtn) {
					submitBtn.disabled = true
					submitBtn.textContent = submitBtn.dataset.loadingLabel ?? 'Creating account...'
				}

				// Resolve PoW + timing token (throws if token unavailable)
				let pow, timingTokenId
				try {
					const resolved = await resolvePow(this.state.preSolvedBundle)
					this.state.preSolvedBundle = null
					pow = resolved.pow
					timingTokenId = resolved.timingTokenId
				} catch {
					this.state.preSolvedBundle = null
					this.isSubmitting = false
					updateStepStates(progressModal, -1, [], 0)
					if (progressErrorActions) showProgressError(progressErrorActions)
					if (this.extWindow.showToast) {
						this.extWindow.showToast('error', 'Error de verificación. Inténtalo de nuevo.', 6000)
					}
					this.resetSubmitButton()
					return
				}

				// Step 1: Creating account
				updateStepStates(progressModal, 1, [0], -1)

				try {
					const publicKeys = session.getPublicKeys()
					const result = await submitAccountCreation(
						this.state.username,
						publicKeys,
						pow,
						timingTokenId,
					)

					if (result.success) {
						const PROGRESS_STEP_DELAY_MS = 300
						const PROGRESS_COMPLETE_DELAY_MS = 400

						updateStepStates(progressModal, 2, [0, 1], -1)
						await new Promise(resolve => setTimeout(resolve, PROGRESS_STEP_DELAY_MS))
						updateStepStates(progressModal, -1, [0, 1, 2], -1)
						await new Promise(resolve => setTimeout(resolve, PROGRESS_COMPLETE_DELAY_MS))

						session.markSubmitted()
						this.teardownSecrets()
						window.location.href = `/success/${this.state.username}`
					} else {
						throw new Error(result.error)
					}
				} catch (error) {
					updateStepStates(progressModal, -1, [0], 1)
					if (progressErrorActions) showProgressError(progressErrorActions)

					const errorMessage = error instanceof Error ? error.message : String(error)
					if (this.extWindow.showToast) {
						this.extWindow.showToast('error', `Account creation failed: ${errorMessage}`, 8000)
					} else {
						alert(`Account creation failed: ${errorMessage}`)
					}

					this.isSubmitting = false
					this.resetSubmitButton()
				}
			}

			private setupEventListeners(): void {
				const { signal } = this.pageAbort
				this.elements.chk1?.addEventListener('change', () => this.updateSubmitState(), { signal })
				this.elements.chk2?.addEventListener('change', () => this.updateSubmitState(), { signal })

				this.elements.copyBtn?.addEventListener('click', () => this.handleCopy(this.elements.copyBtn!), { signal })
				this.elements.masterKeyDisplay?.addEventListener('click', () => this.handleCopy(this.elements.masterKeyDisplay!), { signal })
				this.elements.masterKeyCopyBtn?.addEventListener('click', () => this.handleCopy(this.elements.masterKeyCopyBtn!), { signal })
				this.elements.revealBtn?.addEventListener('click', () => this.toggleMasterReveal(), { signal })

				this.elements.downloadBtn?.addEventListener('click', () => {
					if (!this.state.keySession?.isAlive()) return
					this.openDownloadModal()
				}, { signal })

				this.elements.form?.addEventListener('submit', e => this.handleFormSubmit(e), { signal })

				this.elements.closeProgressBtn?.addEventListener('click', () => {
					if (this.elements.progressModal) hideProgressModal(this.elements.progressModal)
					this.resetSubmitButton()
				}, { signal })

				window.addEventListener('pagehide', () => this.teardownSecrets(), { signal })
				window.addEventListener('beforeunload', () => this.teardownSecrets(), { signal })
			}

			private setupGlobalMethods(): void {
				this.extWindow.closeDownloadModal = () => this.closeDownloadModal()
				this.extWindow.handleFormatSelection = (format: DownloadFormat) => this.handleDownload(format)
			}

			public async initialize(): Promise<void> {
				await this.generateKeys()
			}
		}

		let currentManager: AccountDetailsManager | null = null

		document.addEventListener('astro:page-load', () => {
			currentManager?.teardownSecrets()
			currentManager = null

			const extWin = window as Window & ExtendedWindow
			extWin.closeDownloadModal = undefined
			extWin.handleFormatSelection = undefined

			const form = document.querySelector<HTMLFormElement>('#form-confirm')
			if (!form) return
			if (form.dataset.initialized) return
			form.dataset.initialized = 'true'

			currentManager = new AccountDetailsManager()
			currentManager.initialize()
		})
	</script>
</section>
