---
interface Props {
  pulse?: boolean
}

const { pulse = false } = Astro.props
---

<div class="relative h-12 w-20 shrink-0" aria-hidden="true">
  <span
    class:list={[
      'bg-invite-diamond rounded-xs absolute top-1 right-2 size-8 rotate-45',
      pulse && 'motion-safe:animate-pulse',
    ]}
  ></span>
  <span
    class="bg-invite-diamond-muted rounded-xs absolute bottom-0 left-2 size-5 rotate-45"
  ></span>
  <span class="bg-invite-diamond rounded-xs absolute top-0 left-1 size-2 rotate-45"
  ></span>
</div>
