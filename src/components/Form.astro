---
import Spinner from '@/components/ui/Spinner.astro'
import Button from '@/components/ui/Button.astro'
import { DEFAULT_LOCALE, getMessages } from '@/i18n'

interface Props {
  readonly ticket?: string
}
const { ticket = '' } = Astro.props as Props
const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
---

<section id="formulario" class="mx-auto px-6 py-2">
  <div class="mx-auto w-full max-w-md">
    <!-- Card -->
    <div class="border-border bg-card rounded-xl border p-6">
      <div class="mb-8 text-center">
        <h1
          class="text-foreground mx-auto max-w-[18ch] text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          {copy.home.title}
        </h1>
      </div>

      <form id="registro-form" class="space-y-6">
        <!-- Usuario -->
        <div class="space-y-2">
          <label
            for="username"
            class="text-foreground block text-sm font-medium"
          >
            {copy.home.usernameLabel}
          </label>
          <div class="relative flex">
            <span
              class="border-border bg-muted text-muted-foreground inline-flex select-none items-center rounded-l-lg border border-r-0 px-3 text-sm font-medium"
            >
              @
            </span>
            <input
              id="username"
              name="username"
              type="text"
              maxlength="16"
              required
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              autocomplete="username"
              inputmode="text"
              placeholder=""
              class="lowercase-only border-border bg-muted placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 text-foreground min-h-12 w-full rounded-r-lg border px-3 py-2 pr-10 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />

            <div
              id="username-status-icon"
              class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2"
            >
              <div
                id="loading-icon"
                class="border-primary/60 hidden h-5 w-5 animate-spin rounded-full border-2 border-t-transparent"
              >
              </div>
              <div
                id="success-icon"
                class="hidden text-lg font-bold text-green-400"
              >
                ✓
              </div>
              <div
                id="error-icon"
                class="text-destructive hidden text-lg font-bold"
              >
                ✗
              </div>
            </div>
          </div>
          <div
            id="username-error"
            class="text-destructive hidden text-xs font-medium"
          >
          </div>
        </div>

        <!-- Ticket -->
        <div class="space-y-2">
          <label for="ticket" class="text-foreground block text-sm font-medium">
            {copy.home.accessCodeLabel}
          </label>

          <div class="flex gap-2">
            <input
              id="ticket"
              name="ticket"
              type="text"
              value={ticket}
              required
              autocomplete="off"
              spellcheck="false"
              inputmode="text"
              placeholder=""
              class="border-border bg-muted text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 min-h-12 w-full rounded-lg border px-3 py-2 text-sm font-medium uppercase tracking-wide focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
            <Button
              variant="secondary"
              id="ticket-apply-btn"
              type="button"
              disabled
              aria-busy="false"
              aria-label={copy.home.accessCodeVerify}
              class="min-h-12 w-28 shrink-0 px-3 py-2 tracking-normal disabled:opacity-40"
            >
              <Spinner id="ticket-apply-spinner" className="hidden" />
              <span id="ticket-apply-label">
                {copy.home.accessCodeVerify}
              </span>
              <svg
                id="ticket-apply-icon"
                class="hidden h-5 w-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  d="m4 10 4 4 8-8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </Button>
          </div>

          <div
            id="ticket-error"
            class="text-destructive hidden text-xs font-medium"
          >
          </div>
        </div>

        <Button
          variant="primary"
          id="form-siguiente"
          type="submit"
          disabled
          class="min-h-12 w-full px-5 py-3 tracking-wide disabled:opacity-50"
          >{copy.home.continue}</Button
        >
      </form>
    </div>
  </div>
</section>

<script>
  import { notify } from '@/utils/toast'
  import { fetchTimingToken, obtainPowSolution } from '@/utils/pow-solver'
  import { cleanTicket } from '@/utils/validate-ticket'
  import { verifyTicketInDatabase as checkTicketInDatabase } from '@/lib/form/ticket-verification'
  import { TICKET_VALIDATION_ERROR_CODES } from '@/consts/validation'
  import { TIMING_THRESHOLDS, TIMING_TOKEN_TTL_MS } from '@/consts/pow'
  import { ensureTimingMatured } from '@/utils/timing-maturation'
  import { navigate } from 'astro:transitions/client'

  import {
    type FormElements,
    queryFormElements,
    type FormState,
    createInitialState,
  } from '@/lib/form/types'
  import { getHiveChain, disposeHiveChain } from '@/lib/form/hive-chain-client'
  import { setUsernameFieldState } from '@/lib/form/username-ui'
  import { validateUsername } from '@/lib/form/username-validation'
  import {
    applyTicket,
    handleTicketInputChange,
    showTicketError,
  } from '@/lib/form/ticket-handlers'
  import { syncSubmitButton } from '@/lib/form/submit-button'
  import {
    resolveSubmitDependencies,
    createSession,
  } from '@/lib/form/form-submit'
  import { interpolate, publicCopy } from '@/i18n'

  let elements: FormElements | null = null
  let state: FormState = createInitialState()
  let debounceTimer: ReturnType<typeof setTimeout>
  let usernameValidationRequestId = 0
  let ticketTimingToken: string | undefined
  let ticketTimingTokenFetchedAt = 0

  async function ensureFlowTimingToken(): Promise<string> {
    if (state.flowTimingToken) return state.flowTimingToken
    const id = await fetchTimingToken()
    state.flowTimingToken = id
    state.flowTimingTokenFetchedAt = Date.now()
    return id
  }

  async function ensureTicketTimingToken(): Promise<string> {
    if (
      !ticketTimingToken ||
      Date.now() - ticketTimingTokenFetchedAt >= TIMING_TOKEN_TTL_MS - 60_000
    ) {
      ticketTimingToken = await fetchTimingToken()
      ticketTimingTokenFetchedAt = Date.now()
    }
    await ensureTimingMatured(
      ticketTimingTokenFetchedAt,
      TIMING_THRESHOLDS.ticketVerification
    )
    return ticketTimingToken
  }

  function refetchFlowTimingToken(): void {
    state.flowTimingToken = undefined
    state.flowTimingTokenFetchedAt = 0
    fetchTimingToken()
      .then(id => {
        state.flowTimingToken = id
        state.flowTimingTokenFetchedAt = Date.now()
      })
      .catch(() => {})
  }

  function sync(): void {
    if (elements) syncSubmitButton(elements, state)
  }

  async function handleUsernameInput(): Promise<void> {
    if (!elements) return
    const username = elements.usernameInput.value.toLowerCase().trim()
    const requestId = ++usernameValidationRequestId
    clearTimeout(debounceTimer)
    debounceTimer = setTimeout(async () => {
      if (
        !elements ||
        requestId !== usernameValidationRequestId ||
        elements.usernameInput.value.toLowerCase().trim() !== username
      )
        return

      const result = await validateUsername(username, getHiveChain)

      if (
        !elements ||
        requestId !== usernameValidationRequestId ||
        elements.usernameInput.value.toLowerCase().trim() !== username
      )
        return

      switch (result.status) {
        case 'empty':
          setUsernameFieldState(elements, 'neutral')
          state.isUsernameValid = false
          break
        case 'format_error':
          setUsernameFieldState(
            elements,
            'error',
            publicCopy().username.format[result.code]
          )
          state.isUsernameValid = false
          break
        case 'suspicious':
          setUsernameFieldState(
            elements,
            'error',
            publicCopy().username.notAllowed
          )
          state.isUsernameValid = false
          break
        case 'similar':
          setUsernameFieldState(
            elements,
            'error',
            publicCopy().username.tooSimilar
          )
          state.isUsernameValid = false
          break
        case 'chain_error':
          setUsernameFieldState(
            elements,
            'error',
            publicCopy().username.chainError
          )
          state.isUsernameValid = false
          break
        case 'check_unavailable':
          setUsernameFieldState(
            elements,
            'error',
            result.retryAfterSeconds
              ? interpolate(publicCopy().username.checkRateLimited, {
                  seconds: String(result.retryAfterSeconds),
                })
              : publicCopy().username.checkUnavailable
          )
          state.isUsernameValid = false
          break
        case 'taken':
          setUsernameFieldState(
            elements,
            'error',
            interpolate(publicCopy().username.taken, { username })
          )
          state.isUsernameValid = false
          break
        case 'available':
          setUsernameFieldState(elements, 'success')
          state.isUsernameValid = true
          break
      }
      sync()
    }, 300)

    setUsernameFieldState(elements, 'loading')
    state.isUsernameValid = false
    sync()
  }

  function handleTicketInput(): void {
    if (!elements) return
    const shouldEnable = handleTicketInputChange(elements)
    state.isTicketValid = false
    elements.ticketApplyBtn.disabled = !shouldEnable
    sync()
  }

  async function handleApplyTicket(): Promise<void> {
    if (!elements) return

    await applyTicket({
      elements,
      verifyTicketInDatabase: async ticket => {
        try {
          const [pow, timingTokenId] = await Promise.all([
            obtainPowSolution(),
            ensureTicketTimingToken(),
          ])
          // The API consumes timing tokens even when the ticket is invalid.
          ticketTimingToken = undefined
          ticketTimingTokenFetchedAt = 0
          return await checkTicketInDatabase(ticket, pow, timingTokenId)
        } catch {
          ticketTimingToken = undefined
          ticketTimingTokenFetchedAt = 0
          return TICKET_VALIDATION_ERROR_CODES.INTERNAL_ERROR
        }
      },
      onTicketValid: () => {
        state.isTicketValid = true
        sync()
      },
      onTicketInvalid: () => {
        state.isTicketValid = false
        sync()
      },
    })
  }

  function setSubmitLoadingState(text: string): void {
    if (!elements) return
    elements.submitButton.disabled = true
    elements.submitButton.textContent = text
  }

  function showSubmitError(message: string, originalText: string | null): void {
    if (!elements) return
    notify('error', message)
    elements.submitButton.textContent = publicCopy().home.continueErrorButton
    elements.submitButton.classList.add('bg-red-600', 'hover:bg-red-700')
    setTimeout(() => restoreSubmitButton(originalText), 3000)
  }

  function restoreSubmitButton(originalText: string | null): void {
    if (!elements) return
    elements.submitButton.disabled = false
    elements.submitButton.textContent = originalText
    elements.submitButton.classList.remove('bg-red-600', 'hover:bg-red-700')
  }

  async function handleFormSubmit(event: Event): Promise<void> {
    event.preventDefault()
    if (
      state.isSubmitting ||
      !state.isUsernameValid ||
      !state.isTicketValid ||
      !elements
    )
      return
    state.isSubmitting = true

    const username = elements.usernameInput.value.toLowerCase().trim()
    const ticket = elements.ticketInput.value.trim()
    if (!username || username.length < 3) {
      state.isSubmitting = false
      return
    }

    const originalText = elements.submitButton.textContent
    setSubmitLoadingState(publicCopy().home.verifying)

    const resolved = await resolveSubmitDependencies({
      state,
      ensureFlowTimingToken,
    })

    if (resolved.status === 'pow_error') {
      state.isSubmitting = false
      notify('error', publicCopy().home.flowErrors.pow)
      restoreSubmitButton(originalText)
      return
    }
    if (resolved.status === 'timing_error') {
      state.isSubmitting = false
      notify('error', publicCopy().home.flowErrors.timing)
      restoreSubmitButton(originalText)
      return
    }

    const result = await createSession(
      username,
      ticket,
      resolved.pow,
      resolved.timingTokenId
    )
    if (result.success) {
      disposeHiveChain()
      navigate(`/details/${username}`)
    } else {
      state.isSubmitting = false
      const currentElements = elements
      if (result.reason === 'ticket_invalid' && currentElements) {
        state.isTicketValid = false
        showTicketError(
          currentElements,
          publicCopy().accessCode.validationErrors[
            result.ticketValidationErrorCode
          ]
        )
        sync()
      } else {
        const message =
          result.reason === 'rate_limited'
            ? interpolate(publicCopy().home.flowErrors.rateLimited, {
                seconds: String(result.retryAfterSeconds ?? 60),
              })
            : result.reason === 'pow_invalid'
              ? publicCopy().home.flowErrors.pow
              : result.reason === 'timing_invalid'
                ? publicCopy().home.flowErrors.timing
                : result.reason === 'username_required'
                  ? publicCopy().home.flowErrors.usernameRequired
                  : publicCopy().home.flowErrors.serviceUnavailable
        showSubmitError(message, originalText)
      }
      refetchFlowTimingToken()
    }
  }

  function initForm(): void {
    elements = queryFormElements()
    if (!elements) return

    if (elements.form.dataset.initialized) return
    elements.form.dataset.initialized = 'true'

    state = createInitialState()
    sync()

    fetchTimingToken()
      .then(id => {
        state.flowTimingToken = id
        state.flowTimingTokenFetchedAt = Date.now()
      })
      .catch(() => {})

    fetchTimingToken()
      .then(id => {
        ticketTimingToken = id
        ticketTimingTokenFetchedAt = Date.now()
      })
      .catch(() => {})

    elements.usernameInput.addEventListener('input', handleUsernameInput)
    elements.ticketInput.addEventListener('input', handleTicketInput)
    elements.form.addEventListener('submit', handleFormSubmit)

    elements.ticketApplyBtn.addEventListener('click', handleApplyTicket)
    elements.ticketInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault()
        if (!elements?.ticketApplyBtn.disabled) handleApplyTicket()
      }
    })

    if (elements.ticketInput.value) {
      const cleanedValue = cleanTicket(elements.ticketInput.value.trim())
      if (cleanedValue) {
        elements.ticketInput.value = cleanedValue
        handleTicketInput()
      }
    }
  }

  document.addEventListener('astro:page-load', initForm)
  document.addEventListener('astro:before-swap', disposeHiveChain)
</script>
