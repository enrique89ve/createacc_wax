---
interface Props {
	readonly ticket?: string
}
const { ticket = '' } = Astro.props as Props
---

<section id="formulario" class="mx-auto px-6 py-2">
	<div class="mx-auto w-full max-w-lg">
		<!-- Card -->
		<div
			class="border-border bg-card/95 supports-[backdrop-filter]:bg-card/90 rounded-xl border p-6 shadow-lg backdrop-blur"
		>
			<div class="mb-6 flex flex-col items-center gap-2 text-center">
				<h1
					class="text-foreground text-2xl font-bold tracking-tight sm:text-3xl"
				>
					Crea tu cuenta de Hive
				</h1>
				<p class="text-sm text-amber-50">Únete a la Web3</p>
			</div>

			<form id="registro-form" class="space-y-6">
				<!-- Usuario -->
				<div class="space-y-2">
					<label
						for="username"
						class="text-foreground block text-sm font-semibold uppercase tracking-wide"
					>
						Usuario
					</label>
					<div class="relative flex">
						<span
							class="border-border bg-muted text-muted-foreground inline-flex select-none items-center rounded-l-lg border border-r-0 px-3 text-sm font-medium"
						>
							@
						</span>
						<input
							id="username"
							name="username"
							type="text"
							maxlength="16"
							required
							autocapitalize="none"
							autocorrect="off"
							spellcheck="false"
							placeholder="ingresa el usuario a crear"
							class="lowercase-only border-border bg-muted placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 text-foreground w-full rounded-r-lg border px-3 py-2 pr-10 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
						/>

						<div
							id="username-status-icon"
							class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2"
						>
							<div
								id="loading-icon"
								class="border-primary/60 hidden h-5 w-5 animate-spin rounded-full border-2 border-t-transparent"
							>
							</div>
							<div
								id="success-icon"
								class="hidden text-lg font-bold text-green-400"
							>
								✓
							</div>
							<div
								id="error-icon"
								class="text-destructive hidden text-lg font-bold"
							>
								✗
							</div>
						</div>
					</div>
					<div
						id="username-error"
						class="text-destructive hidden text-xs font-medium"
					>
					</div>
					<p class="text-muted-foreground text-xs leading-relaxed">
						Elige un nombre de usuario de 3 a 16 caracteres, iniciando con una
						letra. Puedes usar números y guiones (-). Los puntos (.) crean
						segmentos, cada uno debe tener mínimo 3 caracteres y seguir las
						mismas reglas.
					</p>
				</div>

				<!-- Ticket -->
				<div class="space-y-2">
					<label
						for="ticket"
						class="text-foreground block text-sm font-semibold uppercase tracking-wide"
					>
						Ticket
					</label>

					<div id="ticket-input-container" class="flex gap-2">
						<input
							id="ticket"
							name="ticket"
							type="text"
							value={ticket}
							required
							placeholder="Ingresa el código"
							class="border-border bg-muted text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm font-medium uppercase tracking-wide focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
						/>
						<button
							id="ticket-apply-btn"
							type="button"
							disabled
							class="bg-muted text-foreground hover:enabled:bg-accent border-border whitespace-nowrap rounded-lg border px-4 py-2 text-sm font-medium transition-colors disabled:cursor-not-allowed disabled:opacity-40"
						>
							Aplicar
						</button>
					</div>

					<div id="ticket-chip" class="hidden">
						<div
							class="bg-muted flex items-center gap-2 rounded-lg border border-green-500/40 px-3 py-2"
						>
							<span class="text-sm font-bold text-green-400">✓</span>
							<span
								id="ticket-chip-code"
								class="text-foreground text-sm font-medium uppercase tracking-wide"
							></span>
							<button
								id="ticket-remove-btn"
								type="button"
								class="text-muted-foreground hover:text-foreground ml-auto transition-colors"
								aria-label="Quitar ticket"
							>
								✕
							</button>
						</div>
					</div>

					<div
						id="ticket-error"
						class="text-destructive hidden text-xs font-medium"
					>
					</div>
				</div>

				<button
					id="form-siguiente"
					type="submit"
					disabled
					class="bg-primary text-primary-foreground hover:enabled:bg-primary/90 focus:ring-primary/40 w-full rounded-lg px-5 py-3 text-sm font-semibold tracking-wide shadow-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
					>Siguiente</button
				>
			</form>
		</div>
	</div>
</section>

<script>
	import { validateAccountName } from '@/utils/validate-username'
	import { validateHiveAccountExists } from '@/utils/validate-hiveuser'
	import { validateTicket, cleanTicket } from '@/utils/validate-ticket'
	import { createHiveChain, HealthChecker } from '@hiveio/wax'
	import { notify } from '@/utils/toast'
	import { obtainPowSolution, fetchTimingToken } from '@/utils/pow-solver'

	let debounceTimer: ReturnType<typeof setTimeout>

	let isUsernameValid = false
	let isTicketValid = false

	// Timing tokens (fetched on page load, one per protected action)
	let ticketTimingToken: string | undefined
	let sessionTimingToken: string | undefined

	// --- Cached DOM elements ---

	interface FormElements {
		readonly form: HTMLFormElement
		readonly usernameInput: HTMLInputElement
		readonly usernameStatusIcon: HTMLElement
		readonly loadingIcon: HTMLElement
		readonly successIcon: HTMLElement
		readonly errorIcon: HTMLElement
		readonly usernameError: HTMLElement
		readonly ticketInput: HTMLInputElement
		readonly ticketApplyBtn: HTMLButtonElement
		readonly ticketInputContainer: HTMLElement
		readonly ticketChip: HTMLElement
		readonly ticketChipCode: HTMLElement
		readonly ticketRemoveBtn: HTMLButtonElement
		readonly ticketError: HTMLElement
		readonly submitButton: HTMLButtonElement
	}

	let elements: FormElements | null = null

	function queryFormElements(): FormElements | null {
		const form = document.querySelector<HTMLFormElement>('#registro-form')
		const usernameInput = document.querySelector<HTMLInputElement>('#username')
		const usernameStatusIcon = document.querySelector<HTMLElement>('#username-status-icon')
		const loadingIcon = document.querySelector<HTMLElement>('#loading-icon')
		const successIcon = document.querySelector<HTMLElement>('#success-icon')
		const errorIcon = document.querySelector<HTMLElement>('#error-icon')
		const usernameError = document.querySelector<HTMLElement>('#username-error')
		const ticketInput = document.querySelector<HTMLInputElement>('#ticket')
		const ticketApplyBtn = document.querySelector<HTMLButtonElement>('#ticket-apply-btn')
		const ticketInputContainer = document.querySelector<HTMLElement>('#ticket-input-container')
		const ticketChip = document.querySelector<HTMLElement>('#ticket-chip')
		const ticketChipCode = document.querySelector<HTMLElement>('#ticket-chip-code')
		const ticketRemoveBtn = document.querySelector<HTMLButtonElement>('#ticket-remove-btn')
		const ticketError = document.querySelector<HTMLElement>('#ticket-error')
		const submitButton = document.querySelector<HTMLButtonElement>('#form-siguiente')

		if (
			!form || !usernameInput || !usernameStatusIcon || !loadingIcon ||
			!successIcon || !errorIcon || !usernameError || !ticketInput ||
			!ticketApplyBtn || !ticketInputContainer || !ticketChip ||
			!ticketChipCode || !ticketRemoveBtn || !ticketError || !submitButton
		) {
			return null
		}

		return {
			form, usernameInput, usernameStatusIcon, loadingIcon,
			successIcon, errorIcon, usernameError, ticketInput,
			ticketApplyBtn, ticketInputContainer, ticketChip,
			ticketChipCode, ticketRemoveBtn, ticketError, submitButton,
		}
	}

	// --- Username field state ---

	function setUsernameState(
		state: 'neutral' | 'loading' | 'error' | 'success',
		message?: string
	) {
		if (!elements) return

		elements.loadingIcon.classList.add('hidden')
		elements.successIcon.classList.add('hidden')
		elements.errorIcon.classList.add('hidden')

		elements.usernameInput.classList.remove(
			'border-red-500', 'border-green-500', 'border-blue-500'
		)

		switch (state) {
			case 'neutral':
				elements.usernameStatusIcon.classList.add('hidden')
				elements.usernameError.classList.add('hidden')
				elements.usernameInput.classList.add('border-border')
				break
			case 'loading':
				elements.loadingIcon.classList.remove('hidden')
				elements.usernameStatusIcon.classList.remove('hidden')
				elements.usernameInput.classList.add('border-blue-500')
				break
			case 'error':
				elements.errorIcon.classList.remove('hidden')
				elements.usernameStatusIcon.classList.remove('hidden')
				elements.usernameInput.classList.add('border-red-500')
				if (message) {
					elements.usernameError.textContent = message
					elements.usernameError.classList.remove('hidden')
				}
				break
			case 'success':
				elements.successIcon.classList.remove('hidden')
				elements.usernameStatusIcon.classList.remove('hidden')
				elements.usernameError.classList.add('hidden')
				elements.usernameInput.classList.add('border-green-500')
				break
		}
	}

	function resetUsernameState() {
		setUsernameState('neutral')
		isUsernameValid = false
		updateSubmitButton()
	}

	function showLoadingState() {
		setUsernameState('loading')
		isUsernameValid = false
		updateSubmitButton()
	}

	function showErrorState(errorMessage: string) {
		setUsernameState('error', errorMessage)
		isUsernameValid = false
		updateSubmitButton()
	}

	function showSuccessState() {
		setUsernameState('success')
		isUsernameValid = true
		updateSubmitButton()
	}

	// --- Hive chain helper (cache + fallback inteligente) ---
	type HiveChain = Awaited<ReturnType<typeof createHiveChain>>
	const HIVE_HEALTH_ENDPOINTS: readonly string[] = [
		'https://techcoderx.com',
		'https://api.openhive.network',
		'https://rpc.mahdiyari.info',
	] as const

	const sleep = (ms: number): Promise<void> =>
		new Promise(r => setTimeout(r, ms))

	let cachedChain: HiveChain | null = null
	let creatingChainPromise: Promise<HiveChain | null> | null = null

	async function tryCreateChain(endpoint?: string): Promise<HiveChain | null> {
		try {
			return endpoint
				? await createHiveChain({ apiEndpoint: endpoint })
				: await createHiveChain()
		} catch {
			return null
		}
	}

	async function tryHealthCheckerEndpoint(): Promise<HiveChain | null> {
		const healthChecker = new HealthChecker([...HIVE_HEALTH_ENDPOINTS], 4000)
		try {
			const temp = await tryCreateChain(HIVE_HEALTH_ENDPOINTS[0])
			if (temp) {
				healthChecker.register(
					temp.api.database_api.get_dynamic_global_properties,
					{},
					(data): true | string => (data?.id === 0 ? true : 'invalid dgp')
				)
			}

			await sleep(1200)
			const best = healthChecker
				.list()
				.filter(e => e.up)
				.sort((a, b) => b.score - a.score)[0]

			if (best) return await tryCreateChain(best.endpointUrl)
			return null
		} finally {
			healthChecker.unregisterAll(true)
		}
	}

	async function tryEndpointsSequentially(): Promise<HiveChain | null> {
		for (const ep of HIVE_HEALTH_ENDPOINTS) {
			const chain = await tryCreateChain(ep)
			if (chain) return chain
		}
		return null
	}

	async function createHiveChainWithFallback(): Promise<HiveChain | null> {
		return (await tryCreateChain())
			?? (await tryHealthCheckerEndpoint())
			?? (await tryEndpointsSequentially())
	}

	async function getHiveChain(): Promise<HiveChain | null> {
		if (cachedChain) return cachedChain
		if (creatingChainPromise) return creatingChainPromise
		creatingChainPromise = (async () => {
			const chain = await createHiveChainWithFallback()
			if (chain) cachedChain = chain
			creatingChainPromise = null
			return chain
		})()
		return creatingChainPromise
	}

	function disposeHiveChain(): void {
		if (cachedChain) {
			try {
				cachedChain.delete()
			} catch {
				// Non-critical: chain may already be deleted or in invalid state
			}
			cachedChain = null
		}
	}

	// --- Ticket ---

	function showTicketError(message: string) {
		if (!elements) return
		elements.ticketInput.classList.add('border-red-500')
		elements.ticketError.textContent = message
		elements.ticketError.classList.remove('hidden')
		isTicketValid = false
		updateSubmitButton()
	}

	function setTicketLoadingState(ticket: string) {
		if (!elements) return
		const message = ticket
			? 'Validando ticket...'
			: 'Obteniendo ticket...'
		elements.ticketInput.disabled = true
		elements.ticketApplyBtn.disabled = true
		elements.ticketApplyBtn.textContent = message
	}

	async function solvePowOrShowError(ticket: string): Promise<Awaited<ReturnType<typeof obtainPowSolution>> | null> {
		const errorMsg = ticket
			? 'Error de verificación. Inténtalo de nuevo.'
			: 'Error obteniendo ticket. Inténtalo de nuevo.'
		try {
			return await obtainPowSolution()
		} catch {
			showTicketError(errorMsg)
			resetTicketInput()
			return null
		}
	}

	async function submitTicketValidation(
		ticket: string,
		pow: Awaited<ReturnType<typeof obtainPowSolution>>
	): Promise<{ valid: boolean; error?: string }> {
		const response = await fetch('/api/validate/ticket', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ ticket, pow, timingTokenId: ticketTimingToken }),
		})
		const result = await response.json()
		return { valid: response.ok && result.valid, error: result.error }
	}

	function showTicketApplied(ticket: string) {
		if (!elements) return
		elements.ticketChipCode.textContent = ticket
		elements.ticketInputContainer.classList.add('hidden')
		elements.ticketChip.classList.remove('hidden')
		elements.ticketError.classList.add('hidden')
		isTicketValid = true
		updateSubmitButton()
	}

	function resetTicketInput() {
		if (!elements) return
		elements.ticketInput.disabled = false
		elements.ticketApplyBtn.textContent = 'Aplicar'
		elements.ticketApplyBtn.disabled = false
	}

	async function applyTicket() {
		if (!elements) return

		const ticket = cleanTicket(elements.ticketInput.value)
		const localError = validateTicket(ticket)
		if (localError) {
			showTicketError(localError)
			return
		}

		setTicketLoadingState(ticket)

		const pow = await solvePowOrShowError(ticket)
		if (!pow) return

		elements.ticketApplyBtn.textContent = '...'

		try {
			const result = await submitTicketValidation(ticket, pow)
			if (result.valid) {
				showTicketApplied(ticket)
				return
			}
			showTicketError(result.error || 'Ticket inválido')
			elements.ticketInput.disabled = false
		} catch {
			showTicketError('Error validando ticket. Inténtalo de nuevo.')
			elements.ticketInput.disabled = false
		}

		resetTicketInput()
	}

	function removeTicket() {
		if (!elements) return

		elements.ticketChip.classList.add('hidden')
		elements.ticketInputContainer.classList.remove('hidden')
		elements.ticketInput.value = ''
		elements.ticketInput.disabled = false
		elements.ticketApplyBtn.disabled = true
		elements.ticketError.classList.add('hidden')
		elements.ticketInput.classList.remove('border-red-500')
		isTicketValid = false
		updateSubmitButton()
		elements.ticketInput.focus()
	}

	function updateSubmitButton() {
		if (!elements) return

		if (isUsernameValid && isTicketValid) {
			elements.submitButton.disabled = false
			elements.submitButton.classList.remove('opacity-50', 'cursor-not-allowed')
			elements.submitButton.classList.add('cursor-pointer')
		} else {
			elements.submitButton.disabled = true
			elements.submitButton.classList.add('opacity-50', 'cursor-not-allowed')
			elements.submitButton.classList.remove('cursor-pointer')
		}
	}

	// --- Username validation ---

	async function checkSuspiciousUsername(username: string): Promise<boolean> {
		try {
			const response = await fetch('/api/validate/suspicious', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ username }),
			})
			const result = await response.json()
			return result.isSuspicious === true
		} catch {
			return false
		}
	}

	async function checkSimilarUsername(username: string): Promise<boolean> {
		try {
			const response = await fetch('/api/validate/similarity', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ username }),
			})
			const result = await response.json()
			return result.isSimilar === true
		} catch {
			return false
		}
	}

	async function validateUsername(username: string) {
		if (!username.trim()) {
			resetUsernameState()
			return
		}

		showLoadingState()

		try {
			const formatError = validateAccountName(username)
			if (formatError) {
				showErrorState(formatError)
				return
			}

			if (await checkSuspiciousUsername(username)) {
				showErrorState('Este username no está permitido')
				return
			}

			if (await checkSimilarUsername(username)) {
				showErrorState('Username muy similar a una cuenta reciente')
				return
			}

			const chain = await getHiveChain()
			if (!chain) {
				showErrorState('Error conectando a la red Hive')
				return
			}

			const accountExists = await validateHiveAccountExists({
				chain,
				accountName: username,
			})

			if (accountExists) {
				showErrorState('Este username ya está en uso')
				return
			}

			showSuccessState()
		} catch {
			showErrorState('Error al validar username')
		}
	}

	function handleUsernameInput() {
		if (!elements) return
		const username = elements.usernameInput.value.toLowerCase().trim()
		clearTimeout(debounceTimer)
		debounceTimer = setTimeout(() => {
			validateUsername(username)
		}, 300)
	}

	function handleTicketInput() {
		if (!elements) return

		const cleaned = cleanTicket(elements.ticketInput.value)

		if (cleaned !== elements.ticketInput.value) {
			const pos = elements.ticketInput.selectionStart || 0
			elements.ticketInput.value = cleaned
			const newPos = Math.min(pos, cleaned.length)
			elements.ticketInput.setSelectionRange(newPos, newPos)
		}

		elements.ticketError.classList.add('hidden')
		elements.ticketInput.classList.remove('border-red-500')

		if (!cleaned) {
			elements.ticketApplyBtn.disabled = true
			return
		}

		const localError = validateTicket(cleaned)
		elements.ticketApplyBtn.disabled = localError !== null
	}

	// --- Form submit ---

	function setSubmitLoadingState(text: string) {
		if (!elements) return
		elements.submitButton.disabled = true
		elements.submitButton.textContent = text
	}

	async function solvePowForSubmit(): Promise<Awaited<ReturnType<typeof obtainPowSolution>> | null> {
		try {
			return await obtainPowSolution()
		} catch {
			notify('error', 'Error de verificación. Inténtalo de nuevo.')
			return null
		}
	}

	async function createSession(
		username: string,
		ticket: string,
		pow: Awaited<ReturnType<typeof obtainPowSolution>>
	): Promise<boolean> {
		const response = await fetch('/api/create/session', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ username, ticket, pow, timingTokenId: sessionTimingToken }),
		})
		const result = await response.json()
		if (!response.ok || !result.success) {
			throw new Error(result.error || 'Error al crear la sesión')
		}
		return true
	}

	function showSubmitError(originalText: string | null) {
		if (!elements) return
		notify('error', 'Error al crear la sesión. Inténtalo de nuevo.')
		elements.submitButton.textContent = 'Error - Inténtalo de nuevo'
		elements.submitButton.classList.add('bg-red-600', 'hover:bg-red-700')
		setTimeout(() => {
			restoreSubmitButton(originalText)
		}, 3000)
	}

	function restoreSubmitButton(originalText: string | null) {
		if (!elements) return
		elements.submitButton.disabled = false
		elements.submitButton.textContent = originalText
		elements.submitButton.classList.remove('bg-red-600', 'hover:bg-red-700')
	}

	async function handleFormSubmit(event: Event) {
		event.preventDefault()
		if (!isUsernameValid || !isTicketValid || !elements) return

		const username = elements.usernameInput.value.toLowerCase().trim()
		const ticket = elements.ticketChipCode.textContent?.trim() || elements.ticketInput.value.trim()
		if (!username || username.length < 3) return

		const originalText = elements.submitButton.textContent
		setSubmitLoadingState('Verificando...')

		const pow = await solvePowForSubmit()
		if (!pow) {
			restoreSubmitButton(originalText)
			return
		}

		setSubmitLoadingState('Creando sesión...')

		try {
			await createSession(username, ticket, pow)
			disposeHiveChain()
			window.location.href = `/details/${username}`
		} catch {
			showSubmitError(originalText)
		}
	}

	// --- Init ---

	function initForm() {
		elements = queryFormElements()
		if (!elements) return

		if (elements.form.dataset.initialized) return
		elements.form.dataset.initialized = 'true'

		isUsernameValid = false
		isTicketValid = false
		updateSubmitButton()

		Promise.all([fetchTimingToken(), fetchTimingToken()])
			.then(([t1, t2]) => {
				ticketTimingToken = t1
				sessionTimingToken = t2
			})
			.catch(() => {})

		elements.usernameInput.addEventListener('input', handleUsernameInput)
		elements.ticketInput.addEventListener('input', handleTicketInput)
		elements.form.addEventListener('submit', handleFormSubmit)

		elements.ticketApplyBtn.addEventListener('click', applyTicket)
		elements.ticketInput.addEventListener('keydown', e => {
			if (e.key === 'Enter') {
				e.preventDefault()
				if (!elements?.ticketApplyBtn.disabled) applyTicket()
			}
		})

		elements.ticketRemoveBtn.addEventListener('click', removeTicket)

		if (elements.ticketInput.value) {
			const cleanedValue = cleanTicket(elements.ticketInput.value.trim())
			if (cleanedValue) {
				elements.ticketInput.value = cleanedValue
				applyTicket()
			}
		}
	}

	document.addEventListener('astro:page-load', initForm)
</script>
