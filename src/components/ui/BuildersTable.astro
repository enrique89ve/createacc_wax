---
import { formatDateTime, formatShortDateTime } from '@/utils/date-formatters'

/**
 * Reusable component to display data tables in the builders area
 * Supports different column configurations and data types
 */
export interface Props {
  title: string
  data: object[]
  columns: TableColumn[]
  emptyMessage?: string
  showSearch?: boolean
  searchPlaceholder?: string
}

export interface TableColumn {
  key: string
  label: string
  type?: 'text' | 'date' | 'badge' | 'actions' | 'key'
  width?: string
  badgeVariant?: (value: unknown) => 'success' | 'warning' | 'danger' | 'info'
  actions?: TableAction[]
  truncate?: boolean
}

export interface TableAction {
  label: string
  icon?: string
  onClick: string // JavaScript function name
  variant?: 'primary' | 'secondary' | 'danger'
}

const {
  title,
  data,
  columns,
  emptyMessage = 'No hay datos para mostrar',
  showSearch = false,
  searchPlaceholder = 'Buscar...',
} = Astro.props

type TableRow = Record<string, unknown>

function getRowValue(row: TableRow, key: string): unknown {
  return row[key]
}

function toDisplayText(value: unknown): string {
  if (typeof value === 'string') return value
  if (typeof value === 'number' || typeof value === 'boolean') {
    return String(value)
  }
  if (value === null || value === undefined) return ''
  return JSON.stringify(value) ?? ''
}

function toDateInput(value: unknown): string | null {
  if (typeof value === 'string' && value.trim().length > 0) return value
  if (typeof value === 'number' && Number.isFinite(value)) {
    return new Date(value).toISOString()
  }
  if (value instanceof Date) return value.toISOString()
  return null
}

function formatDateCell(value: unknown): string {
  const dateValue = toDateInput(value)
  if (!dateValue) return '-'
  return formatDateTime(dateValue)
}

function formatShortDateCell(value: unknown): string {
  const dateValue = toDateInput(value)
  if (!dateValue) return '-'
  return formatShortDateTime(dateValue)
}

function getRowId(row: TableRow, fallbackIndex: number): string | number {
  const id = row.id
  if (typeof id === 'string' || typeof id === 'number') return id
  return fallbackIndex
}
---

<div class="overflow-hidden rounded-lg border border-border bg-card">
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border px-4 sm:px-6 py-3 sm:py-4"
  >
    <h2 class="flex items-center gap-2 text-base sm:text-lg font-semibold text-foreground">
      {title}
    </h2>

    {
      showSearch && (
        <div class="relative w-full sm:w-auto">
          <input
            type="text"
            placeholder={searchPlaceholder}
            class="bg-background border-border focus:ring-primary w-full sm:w-64 rounded-lg border px-3 py-2 pl-10 text-sm text-foreground focus:border-transparent focus:outline-none focus:ring-2"
            id="table-search"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg
              class="h-5 w-5 text-muted-foreground"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
        </div>
      )
    }
  </div>

  {
    data.length === 0 ? (
      <div class="p-10 text-center">
        <div class="mb-4 text-5xl">📋</div>
        <p class="mb-2 font-semibold text-foreground">No data</p>
        <p class="text-sm text-muted-foreground">{emptyMessage}</p>
      </div>
    ) : (
      <>
        {/* Desktop Table (md and up) */}
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full divide-y divide-border text-sm">
            <thead class="bg-muted/60">
              <tr>
                {columns.map((column, idx) => (
                  <th
                    class={`px-6 py-3 font-medium uppercase tracking-wide text-muted-foreground ${
                      idx === 0 ? 'text-left' : 'text-center'
                    } ${column.width || ''}`}
                  >
                    {column.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {data.map((rowData, index) => {
                const row = rowData as TableRow
                return (
                  <tr
                    class="hover:bg-muted/40"
                    data-search-content={JSON.stringify(row)}
                  >
                    {columns.map((column, idx) => {
                      const cellValue = getRowValue(row, column.key)
                      const cellText = toDisplayText(cellValue)
                      return (
                        <td class={`px-6 py-3 ${idx === 0 ? 'text-left' : 'text-center'}`}>
                          {column.type === 'date' && (
                            <span class="text-muted-foreground text-sm">
                              {formatDateCell(cellValue)}
                            </span>
                          )}

                          {column.type === 'badge' && (
                            <span
                              class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                                column.badgeVariant?.(cellValue) === 'success'
                                  ? 'bg-green-500/20 text-green-300'
                                  : column.badgeVariant?.(cellValue) ===
                                      'warning'
                                    ? 'bg-yellow-500/20 text-yellow-300'
                                    : column.badgeVariant?.(cellValue) ===
                                        'danger'
                                      ? 'bg-red-500/20 text-red-300'
                                      : 'bg-blue-500/20 text-blue-300'
                              }`}
                            >
                              {cellText}
                            </span>
                          )}

                          {column.type === 'key' && (
                            <div class="font-mono text-sm text-foreground">
                              <span
                                class={
                                  column.truncate ? 'block max-w-xs truncate' : ''
                                }
                              >
                                {cellText}
                              </span>
                            </div>
                          )}

                          {column.type === 'actions' && (
                            <div class="flex justify-center space-x-3">
                              {column.actions?.map(action => (
                                <button
                                  onclick={`${action.onClick}('${getRowId(row, index)}')`}
                                  class={`text-xs font-medium transition-colors ${
                                    action.variant === 'danger'
                                      ? 'text-red-400 hover:text-red-300'
                                      : action.variant === 'secondary'
                                        ? 'text-gray-400 hover:text-gray-300'
                                        : 'text-blue-400 hover:text-blue-300'
                                  }`}
                                >
                                  {action.icon && (
                                    <span class="mr-1">{action.icon}</span>
                                  )}
                                  {action.label}
                                </button>
                              ))}
                            </div>
                          )}

                          {(!column.type || column.type === 'text') && (
                            <>
                              {column.key === 'username' && cellText ? (
                                <a
                                  href={`https://peakd.com/@${cellText}`}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="inline-flex items-center gap-1.5 text-primary hover:text-primary/80 transition-colors text-sm font-medium"
                                >
                                  @{cellText}
                                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                  </svg>
                                </a>
                              ) : (
                                <span
                                  class={`text-foreground text-sm ${column.truncate ? 'block max-w-xs truncate' : ''}`}
                                >
                                  {cellText}
                                </span>
                              )}
                            </>
                          )}
                        </td>
                      )
                    })}
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>

        {/* Mobile Cards (below md) */}
        <div class="md:hidden space-y-3 p-3">
          {data.map((rowData, index) => {
            const row = rowData as TableRow
            // First column as main title (username)
            const primaryColumn = columns[0]
            const secondaryColumns = columns.slice(1)
            const dateColumn = secondaryColumns.find(c => c.type === 'date')
            const actionsColumn = secondaryColumns.find(c => c.type === 'actions')
            const primaryValue = getRowValue(row, primaryColumn.key)
            const primaryText = toDisplayText(primaryValue)
            // Detect if it is a user account (has username)
            const isUserAccount = primaryColumn.key === 'username' && primaryText.length > 0
            const profileUrl = isUserAccount ? `https://peakd.com/@${primaryText}` : null

            return (
              <a
                href={profileUrl || '#'}
                target={profileUrl ? '_blank' : undefined}
                rel={profileUrl ? 'noopener noreferrer' : undefined}
                class={`block relative bg-muted/30 rounded-lg border border-border/50 overflow-hidden transition-all ${profileUrl ? 'hover:border-primary/50 hover:bg-muted/40 cursor-pointer' : ''}`}
                data-search-content={JSON.stringify(row)}
              >
                {/* Tab with main data */}
                <div class="bg-muted/60 px-3 py-2 border-b border-border/30">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class={`font-semibold text-sm ${isUserAccount ? 'text-primary' : 'text-foreground'}`}>
                        {isUserAccount && '@'}{primaryText}
                      </span>
                      {profileUrl && (
                        <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      )}
                    </div>
                    {/* Show date if it exists in the columns */}
                    {dateColumn && (
                      <span class="text-muted-foreground text-xs">
                        {formatShortDateCell(getRowValue(row, dateColumn.key))}
                      </span>
                    )}
                  </div>
                </div>

                {/* Content */}
                <div class="p-3">
                  <div class="grid grid-cols-2 gap-2">
                    {secondaryColumns.filter(c => c.type !== 'date' && c.type !== 'actions').map((column) => (
                      <div>
                        <dt class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-0.5">
                          {column.label}
                        </dt>
                        <dd class="text-sm text-foreground">
                          {column.type === 'badge' ? (
                            <span
                              class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                                column.badgeVariant?.(getRowValue(row, column.key)) === 'success'
                                  ? 'bg-green-500/20 text-green-300'
                                  : column.badgeVariant?.(getRowValue(row, column.key)) === 'warning'
                                    ? 'bg-yellow-500/20 text-yellow-300'
                                    : column.badgeVariant?.(getRowValue(row, column.key)) === 'danger'
                                      ? 'bg-red-500/20 text-red-300'
                                      : 'bg-blue-500/20 text-blue-300'
                              }`}
                            >
                              {toDisplayText(getRowValue(row, column.key))}
                            </span>
                          ) : column.type === 'key' ? (
                            <span class="font-mono text-xs break-all">
                              {toDisplayText(getRowValue(row, column.key))}
                            </span>
                          ) : (
                            toDisplayText(getRowValue(row, column.key))
                          )}
                        </dd>
                      </div>
                    ))}
                  </div>

                  {/* Full date at the end if it exists */}
                  {dateColumn && (
                    <div class="mt-2 pt-2 border-t border-border/30 text-xs text-muted-foreground">
                      {formatDateCell(getRowValue(row, dateColumn.key))}
                    </div>
                  )}

                  {/* Actions if they exist */}
                  {actionsColumn && (
                    <div class="flex gap-2 mt-3 pt-2 border-t border-border/30">
                      {actionsColumn.actions?.map(action => (
                        <button
                          onclick={`event.preventDefault(); event.stopPropagation(); ${action.onClick}('${getRowId(row, index)}')`}
                          class={`flex-1 inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-2 text-xs font-medium transition-all ${
                            action.variant === 'danger'
                              ? 'bg-red-500/10 text-red-400 ring-1 ring-red-500/20 hover:bg-red-500/20'
                              : action.variant === 'secondary'
                                ? 'bg-muted text-muted-foreground ring-1 ring-border hover:bg-muted/80'
                                : 'bg-primary/10 text-primary ring-1 ring-primary/20 hover:bg-primary/20'
                          }`}
                        >
                          {action.icon && <span>{action.icon}</span>}
                          {action.label}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            )
          })}
        </div>
      </>
    )
  }
</div>

{
  showSearch && (
    <script>
      ;(function initBuildersTableSearch() {
        const searchInput = document.getElementById('table-search') as HTMLInputElement | null
        if (!searchInput) return
        const tableRows = Array.from(
          document.querySelectorAll('[data-search-content]')
        ) as HTMLElement[]

        const handleFilter = () => {
          const searchTerm = searchInput.value.trim().toLowerCase()
          for (const row of tableRows) {
            const content = (row.dataset.searchContent || '').toLowerCase()
            row.style.display = content.includes(searchTerm) ? '' : 'none'
          }
        }

        searchInput.addEventListener('input', handleFilter)
      })()
    </script>
  )
}
