---
/**
 * Componente reutilizable para mostrar tablas de datos en el área de builders
 * Soporta diferentes configuraciones de columnas y tipos de datos
 */
export interface Props {
  title: string
  data: any[]
  columns: TableColumn[]
  emptyMessage?: string
  showSearch?: boolean
  searchPlaceholder?: string
}

export interface TableColumn {
  key: string
  label: string
  type?: 'text' | 'date' | 'badge' | 'actions' | 'key'
  width?: string
  badgeVariant?: (value: any) => 'success' | 'warning' | 'danger' | 'info'
  actions?: TableAction[]
  truncate?: boolean
}

export interface TableAction {
  label: string
  icon?: string
  onClick: string // JavaScript function name
  variant?: 'primary' | 'secondary' | 'danger'
}

const {
  title,
  data,
  columns,
  emptyMessage = 'No hay datos para mostrar',
  showSearch = false,
  searchPlaceholder = 'Buscar...',
} = Astro.props
---

<div class="overflow-hidden rounded-lg border border-gray-700/60 bg-gray-900/40">
  <div
    class="flex items-center justify-between border-b border-gray-700/60 px-6 py-4"
  >
    <h2 class="flex items-center gap-2 text-lg font-semibold text-white">
      {title}
    </h2>

    {
      showSearch && (
        <div class="relative">
          <input
            type="text"
            placeholder={searchPlaceholder}
            class="bg-background border-border focus:ring-primary w-64 rounded-lg border px-3 py-2 pl-10 text-sm text-white focus:border-transparent focus:outline-none focus:ring-2"
            id="table-search"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg
              class="h-5 w-5 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
        </div>
      )
    }
  </div>

  {
    data.length === 0 ? (
      <div class="p-10 text-center">
        <div class="mb-4 text-5xl">📋</div>
        <p class="mb-2 font-semibold text-white">Sin datos</p>
        <p class="text-sm text-gray-400">{emptyMessage}</p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full table-fixed divide-y divide-gray-700 text-sm">
          <thead class="bg-gray-800/60">
            <tr>
              {columns.map((column, idx) => (
                <th
                  class={`px-6 py-3 font-medium uppercase tracking-wide text-gray-300 ${
                    idx === 0 ? 'text-left' : 'text-center'
                  } ${column.width || ''}`}
                >
                  {column.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
            {data.map((row, index) => (
              <tr
                class="hover:bg-gray-800/40"
                data-search-content={JSON.stringify(row)}
              >
                {columns.map((column, idx) => (
                  <td class={`px-6 py-3 ${idx === 0 ? 'text-left' : 'text-center'}`}>
                    {column.type === 'date' && (
                      <span class="text-gray-400 text-sm">
                        {new Date(row[column.key]).toLocaleDateString(
                          'es-ES',
                          {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                          }
                        )}
                      </span>
                    )}

                    {column.type === 'badge' && (
                      <span
                        class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                          column.badgeVariant?.(row[column.key]) === 'success'
                            ? 'bg-green-500/20 text-green-300'
                            : column.badgeVariant?.(row[column.key]) ===
                                'warning'
                              ? 'bg-yellow-500/20 text-yellow-300'
                              : column.badgeVariant?.(row[column.key]) ===
                                  'danger'
                                ? 'bg-red-500/20 text-red-300'
                                : 'bg-blue-500/20 text-blue-300'
                        }`}
                      >
                        {row[column.key]}
                      </span>
                    )}

                    {column.type === 'key' && (
                      <div class="font-mono text-sm text-white">
                        <span
                          class={
                            column.truncate ? 'block max-w-xs truncate' : ''
                          }
                        >
                          {row[column.key]}
                        </span>
                      </div>
                    )}

                    {column.type === 'actions' && (
                      <div class="flex space-x-3">
                        {column.actions?.map(action => (
                          <button
                            onclick={`${action.onClick}('${row.id || index}')`}
                            class={`text-xs font-medium transition-colors ${
                              action.variant === 'danger'
                                ? 'text-red-400 hover:text-red-300'
                                : action.variant === 'secondary'
                                  ? 'text-gray-400 hover:text-gray-300'
                                  : 'text-blue-400 hover:text-blue-300'
                            }`}
                          >
                            {action.icon && (
                              <span class="mr-1">{action.icon}</span>
                            )}
                            {action.label}
                          </button>
                        ))}
                      </div>
                    )}

                    {(!column.type || column.type === 'text') && (
                      <span
                        class={`text-white text-sm ${column.truncate ? 'block max-w-xs truncate' : ''}`}
                      >
                        {row[column.key]}
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</div>

{
  showSearch && (
    <script>
      ;(function initBuildersTableSearch() {
        const searchInput = document.getElementById('table-search') as HTMLInputElement | null
        if (!searchInput) return
        const tableRows = Array.from(
          document.querySelectorAll('[data-search-content]')
        ) as HTMLElement[]

        const handleFilter = () => {
          const searchTerm = searchInput.value.trim().toLowerCase()
          for (const row of tableRows) {
            const content = (row.dataset.searchContent || '').toLowerCase()
            row.style.display = content.includes(searchTerm) ? '' : 'none'
          }
        }

        searchInput.addEventListener('input', handleFilter)
      })()
    </script>
  )
}
