---
import { formatDateTime, formatShortDateTime } from '@/utils/date-formatters'

/**
 * Reusable component to display data tables in the builders area
 * Supports different column configurations and data types
 */
export interface Props {
  title: string
  data: object[]
  columns: TableColumn[]
  emptyMessage?: string
  showSearch?: boolean
  searchPlaceholder?: string
}

export interface TableColumn {
  key: string
  label: string
  type?: 'text' | 'date' | 'badge' | 'actions' | 'key'
  width?: string
  badgeVariant?: (value: unknown) => 'success' | 'warning' | 'danger' | 'info'
  actions?: TableAction[]
  truncate?: boolean
}

export interface TableAction {
  label: string
  icon?: string
  onClick: string // JavaScript function name
  variant?: 'primary' | 'secondary' | 'danger'
}

const {
  title,
  data,
  columns,
  emptyMessage = 'No hay datos para mostrar',
  showSearch = false,
  searchPlaceholder = 'Buscar...',
} = Astro.props

type TableRow = Record<string, unknown>

function getRowValue(row: TableRow, key: string): unknown {
  return row[key]
}

function toDisplayText(value: unknown): string {
  if (typeof value === 'string') return value
  if (typeof value === 'number' || typeof value === 'boolean') {
    return String(value)
  }
  if (value === null || value === undefined) return ''
  return JSON.stringify(value) ?? ''
}

function toDateInput(value: unknown): string | null {
  if (typeof value === 'string' && value.trim().length > 0) return value
  if (typeof value === 'number' && Number.isFinite(value)) {
    return new Date(value).toISOString()
  }
  if (value instanceof Date) return value.toISOString()
  return null
}

function formatDateCell(value: unknown): string {
  const dateValue = toDateInput(value)
  if (!dateValue) return '-'
  return formatDateTime(dateValue)
}

function formatShortDateCell(value: unknown): string {
  const dateValue = toDateInput(value)
  if (!dateValue) return '-'
  return formatShortDateTime(dateValue)
}

function getRowId(row: TableRow, fallbackIndex: number): string | number {
  const id = row.id
  if (typeof id === 'string' || typeof id === 'number') return id
  return fallbackIndex
}
---

<div class="border-border bg-card overflow-hidden rounded-lg border">
  <div
    class="border-border flex flex-col justify-between gap-3 border-b px-4 py-3 sm:flex-row sm:items-center sm:px-6 sm:py-4"
  >
    <h2
      class="text-foreground flex items-center gap-2 text-base font-semibold sm:text-lg"
    >
      {title}
    </h2>

    {
      showSearch && (
        <div class="relative w-full sm:w-auto">
          <input
            type="text"
            placeholder={searchPlaceholder}
            class="bg-background border-border focus:ring-primary text-foreground w-full rounded-lg border px-3 py-2 pl-10 text-sm focus:border-transparent focus:outline-none focus:ring-2 sm:w-64"
            id="table-search"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg
              class="text-muted-foreground h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
        </div>
      )
    }
  </div>

  {
    data.length === 0 ? (
      <div class="p-10 text-center">
        <div class="mb-4 text-5xl">📋</div>
        <p class="text-foreground mb-2 font-semibold">No data</p>
        <p class="text-muted-foreground text-sm">{emptyMessage}</p>
      </div>
    ) : (
      <>
        {/* Desktop Table (md and up) */}
        <div class="hidden overflow-x-auto md:block">
          <table class="divide-border w-full divide-y text-sm">
            <thead class="bg-muted/60">
              <tr>
                {columns.map((column, idx) => (
                  <th
                    class={`text-muted-foreground px-6 py-3 font-medium uppercase tracking-wide ${
                      idx === 0 ? 'text-left' : 'text-center'
                    } ${column.width || ''}`}
                  >
                    {column.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {data.map((rowData, index) => {
                const row = rowData as TableRow
                return (
                  <tr
                    class="hover:bg-muted/40"
                    data-search-content={JSON.stringify(row)}
                  >
                    {columns.map((column, idx) => {
                      const cellValue = getRowValue(row, column.key)
                      const cellText = toDisplayText(cellValue)
                      return (
                        <td
                          class={`px-6 py-3 ${idx === 0 ? 'text-left' : 'text-center'}`}
                        >
                          {column.type === 'date' && (
                            <span class="text-muted-foreground text-sm">
                              {formatDateCell(cellValue)}
                            </span>
                          )}

                          {column.type === 'badge' && (
                            <span
                              class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                                column.badgeVariant?.(cellValue) === 'success'
                                  ? 'bg-green-500/20 text-green-300'
                                  : column.badgeVariant?.(cellValue) ===
                                      'warning'
                                    ? 'bg-yellow-500/20 text-yellow-300'
                                    : column.badgeVariant?.(cellValue) ===
                                        'danger'
                                      ? 'bg-red-500/20 text-red-300'
                                      : 'bg-blue-500/20 text-blue-300'
                              }`}
                            >
                              {cellText}
                            </span>
                          )}

                          {column.type === 'key' && (
                            <div class="text-foreground font-mono text-sm">
                              <span
                                class={
                                  column.truncate
                                    ? 'block max-w-xs truncate'
                                    : ''
                                }
                              >
                                {cellText}
                              </span>
                            </div>
                          )}

                          {column.type === 'actions' && (
                            <div class="flex justify-center space-x-3">
                              {column.actions?.map(action => (
                                <button
                                  onclick={`${action.onClick}('${getRowId(row, index)}')`}
                                  class={`text-xs font-medium transition-colors ${
                                    action.variant === 'danger'
                                      ? 'text-red-400 hover:text-red-300'
                                      : action.variant === 'secondary'
                                        ? 'text-gray-400 hover:text-gray-300'
                                        : 'text-blue-400 hover:text-blue-300'
                                  }`}
                                >
                                  {action.icon && (
                                    <span class="mr-1">{action.icon}</span>
                                  )}
                                  {action.label}
                                </button>
                              ))}
                            </div>
                          )}

                          {(!column.type || column.type === 'text') && (
                            <>
                              {column.key === 'username' && cellText ? (
                                <a
                                  href={`https://peakd.com/@${cellText}`}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="text-primary hover:text-primary/80 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                                >
                                  @{cellText}
                                  <svg
                                    class="h-3.5 w-3.5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                    />
                                  </svg>
                                </a>
                              ) : (
                                <span
                                  class={`text-foreground text-sm ${column.truncate ? 'block max-w-xs truncate' : ''}`}
                                >
                                  {cellText}
                                </span>
                              )}
                            </>
                          )}
                        </td>
                      )
                    })}
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>

        {/* Mobile Cards (below md) */}
        <div class="space-y-3 p-3 md:hidden">
          {data.map((rowData, index) => {
            const row = rowData as TableRow
            // First column as main title (username)
            const primaryColumn = columns[0]
            const secondaryColumns = columns.slice(1)
            const dateColumn = secondaryColumns.find(c => c.type === 'date')
            const actionsColumn = secondaryColumns.find(
              c => c.type === 'actions'
            )
            const primaryValue = getRowValue(row, primaryColumn.key)
            const primaryText = toDisplayText(primaryValue)
            // Detect if it is a user account (has username)
            const isUserAccount =
              primaryColumn.key === 'username' && primaryText.length > 0
            const profileUrl = isUserAccount
              ? `https://peakd.com/@${primaryText}`
              : null

            return (
              <a
                href={profileUrl || '#'}
                target={profileUrl ? '_blank' : undefined}
                rel={profileUrl ? 'noopener noreferrer' : undefined}
                class={`bg-muted/30 border-border/50 relative block overflow-hidden rounded-lg border transition-all ${profileUrl ? 'hover:border-primary/50 hover:bg-muted/40 cursor-pointer' : ''}`}
                data-search-content={JSON.stringify(row)}
              >
                {/* Tab with main data */}
                <div class="bg-muted/60 border-border/30 border-b px-3 py-2">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span
                        class={`text-sm font-semibold ${isUserAccount ? 'text-primary' : 'text-foreground'}`}
                      >
                        {isUserAccount && '@'}
                        {primaryText}
                      </span>
                      {profileUrl && (
                        <svg
                          class="text-muted-foreground h-3.5 w-3.5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                      )}
                    </div>
                    {/* Show date if it exists in the columns */}
                    {dateColumn && (
                      <span class="text-muted-foreground text-xs">
                        {formatShortDateCell(getRowValue(row, dateColumn.key))}
                      </span>
                    )}
                  </div>
                </div>

                {/* Content */}
                <div class="p-3">
                  <div class="grid grid-cols-2 gap-2">
                    {secondaryColumns
                      .filter(c => c.type !== 'date' && c.type !== 'actions')
                      .map(column => (
                        <div>
                          <dt class="text-muted-foreground mb-0.5 text-xs font-medium uppercase tracking-wide">
                            {column.label}
                          </dt>
                          <dd class="text-foreground text-sm">
                            {column.type === 'badge' ? (
                              <span
                                class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                                  column.badgeVariant?.(
                                    getRowValue(row, column.key)
                                  ) === 'success'
                                    ? 'bg-green-500/20 text-green-300'
                                    : column.badgeVariant?.(
                                          getRowValue(row, column.key)
                                        ) === 'warning'
                                      ? 'bg-yellow-500/20 text-yellow-300'
                                      : column.badgeVariant?.(
                                            getRowValue(row, column.key)
                                          ) === 'danger'
                                        ? 'bg-red-500/20 text-red-300'
                                        : 'bg-blue-500/20 text-blue-300'
                                }`}
                              >
                                {toDisplayText(getRowValue(row, column.key))}
                              </span>
                            ) : column.type === 'key' ? (
                              <span class="break-all font-mono text-xs">
                                {toDisplayText(getRowValue(row, column.key))}
                              </span>
                            ) : (
                              toDisplayText(getRowValue(row, column.key))
                            )}
                          </dd>
                        </div>
                      ))}
                  </div>

                  {/* Full date at the end if it exists */}
                  {dateColumn && (
                    <div class="border-border/30 text-muted-foreground mt-2 border-t pt-2 text-xs">
                      {formatDateCell(getRowValue(row, dateColumn.key))}
                    </div>
                  )}

                  {/* Actions if they exist */}
                  {actionsColumn && (
                    <div class="border-border/30 mt-3 flex gap-2 border-t pt-2">
                      {actionsColumn.actions?.map(action => (
                        <button
                          onclick={`event.preventDefault(); event.stopPropagation(); ${action.onClick}('${getRowId(row, index)}')`}
                          class={`inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-3 py-2 text-xs font-medium transition-all ${
                            action.variant === 'danger'
                              ? 'bg-red-500/10 text-red-400 ring-1 ring-red-500/20 hover:bg-red-500/20'
                              : action.variant === 'secondary'
                                ? 'bg-muted text-muted-foreground ring-border hover:bg-muted/80 ring-1'
                                : 'bg-primary/10 text-primary ring-primary/20 hover:bg-primary/20 ring-1'
                          }`}
                        >
                          {action.icon && <span>{action.icon}</span>}
                          {action.label}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            )
          })}
        </div>
      </>
    )
  }
</div>

<script>
  ;(function initBuildersTableSearch() {
    const searchInput = document.getElementById('table-search')
    if (!(searchInput instanceof HTMLInputElement)) return
    const tableRows = Array.from(
      document.querySelectorAll('[data-search-content]')
    )

    const handleFilter = () => {
      const searchTerm = searchInput.value.trim().toLowerCase()
      for (const row of tableRows) {
        if (!(row instanceof HTMLElement)) continue
        const content = (row.dataset.searchContent || '').toLowerCase()
        row.style.display = content.includes(searchTerm) ? '' : 'none'
      }
    }

    searchInput.addEventListener('input', handleFilter)
  })()
</script>
