---
/**
 * Componente reutilizable para mostrar tablas de datos en el área de builders
 * Soporta diferentes configuraciones de columnas y tipos de datos
 */
export interface Props {
  title: string
  data: any[]
  columns: TableColumn[]
  emptyMessage?: string
  showSearch?: boolean
  searchPlaceholder?: string
}

export interface TableColumn {
  key: string
  label: string
  type?: 'text' | 'date' | 'badge' | 'actions' | 'key'
  width?: string
  badgeVariant?: (value: any) => 'success' | 'warning' | 'danger' | 'info'
  actions?: TableAction[]
  truncate?: boolean
}

export interface TableAction {
  label: string
  icon?: string
  onClick: string // JavaScript function name
  variant?: 'primary' | 'secondary' | 'danger'
}

const {
  title,
  data,
  columns,
  emptyMessage = 'No hay datos para mostrar',
  showSearch = false,
  searchPlaceholder = 'Buscar...',
} = Astro.props
---

<div class="bg-card border-border rounded-lg border">
  <div class="p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-foreground text-xl font-semibold">{title}</h2>

      {
        showSearch && (
          <div class="relative">
            <input
              type="text"
              placeholder={searchPlaceholder}
              class="bg-background border-border focus:ring-primary w-64 rounded-lg border px-3 py-2 pl-10 focus:border-transparent focus:outline-none focus:ring-2"
              id="table-search"
            />
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
              <svg
                class="h-5 w-5 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                />
              </svg>
            </div>
          </div>
        )
      }
    </div>

    {
      data.length === 0 ? (
        <div class="py-8 text-center">
          <div class="text-muted text-lg">{emptyMessage}</div>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-border border-b">
                {columns.map(column => (
                  <th
                    class={`text-muted px-4 py-3 text-left text-xs font-medium uppercase tracking-wider ${column.width || ''}`}
                  >
                    {column.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {data.map((row, index) => (
                <tr
                  class="hover:bg-muted/30 transition-colors"
                  data-search-content={JSON.stringify(row)}
                >
                  {columns.map(column => (
                    <td class="px-4 py-3">
                      {column.type === 'date' && (
                        <span class="text-foreground text-sm">
                          {new Date(row[column.key]).toLocaleDateString(
                            'es-ES',
                            {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                              hour: '2-digit',
                              minute: '2-digit',
                            }
                          )}
                        </span>
                      )}

                      {column.type === 'badge' && (
                        <span
                          class={`rounded-full px-2 py-1 text-xs font-medium ${
                            column.badgeVariant?.(row[column.key]) === 'success'
                              ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                              : column.badgeVariant?.(row[column.key]) ===
                                  'warning'
                                ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
                                : column.badgeVariant?.(row[column.key]) ===
                                    'danger'
                                  ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                                  : 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
                          }`}
                        >
                          {row[column.key]}
                        </span>
                      )}

                      {column.type === 'key' && (
                        <div class="font-mono text-sm">
                          <span
                            class={
                              column.truncate ? 'block max-w-xs truncate' : ''
                            }
                          >
                            {row[column.key]}
                          </span>
                        </div>
                      )}

                      {column.type === 'actions' && (
                        <div class="flex space-x-2">
                          {column.actions?.map(action => (
                            <button
                              onclick={`${action.onClick}('${row.id || index}')`}
                              class={`rounded px-3 py-1 text-xs font-medium transition-colors ${
                                action.variant === 'danger'
                                  ? 'bg-red-600 text-white hover:bg-red-700'
                                  : action.variant === 'secondary'
                                    ? 'bg-gray-500 text-white hover:bg-gray-600'
                                    : 'bg-blue-600 text-white hover:bg-blue-700'
                              }`}
                            >
                              {action.icon && (
                                <span class="mr-1">{action.icon}</span>
                              )}
                              {action.label}
                            </button>
                          ))}
                        </div>
                      )}

                      {(!column.type || column.type === 'text') && (
                        <span
                          class={`text-foreground text-sm ${column.truncate ? 'block max-w-xs truncate' : ''}`}
                        >
                          {row[column.key]}
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</div>

{
  showSearch && (
    <script>
      ;(function initBuildersTableSearch() {
        const searchInput = document.getElementById('table-search') as HTMLInputElement | null
        if (!searchInput) return
        const tableRows = Array.from(
          document.querySelectorAll('[data-search-content]')
        ) as HTMLElement[]

        const handleFilter = () => {
          const searchTerm = searchInput.value.trim().toLowerCase()
          for (const row of tableRows) {
            const content = (row.dataset.searchContent || '').toLowerCase()
            row.style.display = content.includes(searchTerm) ? '' : 'none'
          }
        }

        searchInput.addEventListener('input', handleFilter)
      })()
    </script>
  )
}
