---
// Minimal navbar: logo on the left, "+ Post" button only on /success/* pages
// Determine if the current route includes "/success/".
import { Image } from 'astro:assets'
import hiveLogo from '@/assets/hive.svg'
import LocaleSwitch from '@/components/ui/LocaleSwitch.astro'
const currentPath: string = Astro.url.pathname
const isHome: boolean = currentPath === '/' || currentPath === ''
const isSuccess: boolean = currentPath.startsWith('/success/')
---

<header
  class="border-border/60 from-background/90 to-background/70 supports-[backdrop-filter]:bg-background/60 bg-gradient-to-b backdrop-blur"
>
  <div
    class="mx-auto flex h-12 w-full max-w-7xl items-center justify-between px-3 md:px-5"
  >
    <a
      href="/"
      class="text-foreground flex items-center gap-2 font-medium tracking-tight transition-opacity hover:opacity-90"
    >
      <Image src={hiveLogo} alt="Hive" class="h-8 w-auto" />
    </a>
    <div class="flex items-center gap-2">
      {isHome && <LocaleSwitch />}
      {
        isSuccess && (
          <a
            href="https://peakd.com"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-primary/40 inline-flex min-h-11 items-center justify-center rounded-md px-3 text-xs font-semibold shadow-sm transition-colors focus:outline-none focus-visible:ring-2"
          >
            + Post
          </a>
        )
      }
    </div>
  </div>
</header>
