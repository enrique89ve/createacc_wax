---
import { getRuntimeStatus } from '@/lib/runtime-status'

const status = getRuntimeStatus()
const executionClass = status.broadcastAllowed
  ? 'bg-red-500/15 text-red-200'
  : 'bg-amber-500/15 text-amber-200'
---

<div class="flex flex-wrap items-center gap-2 text-xs">
  <span
    class="border-border bg-card text-muted-foreground rounded-full border px-2 py-0.5 font-medium uppercase tracking-wide"
  >
    {status.network}
  </span>
  <span
    class:list={[
      'rounded-full px-2 py-0.5 font-medium uppercase tracking-wide',
      executionClass,
    ]}
  >
    {status.broadcastAllowed ? 'Live Broadcast' : 'Simulation Mode'}
  </span>
</div>
