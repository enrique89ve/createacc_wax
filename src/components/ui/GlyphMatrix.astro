---
interface Props {
  /** Distancia entre puntos en píxeles (menor = más densidad). */
  readonly pitch?: number
  /** Más puntos visibles y brillo algo más alto (isotipo grande). */
  readonly prominent?: boolean
}

const { pitch = 8, prominent = false } = Astro.props
const pitchPx = `${Math.max(4, Math.min(12, pitch))}px`
---

<span
  class:list={[
    'glyph-matrix pointer-events-none relative isolate block h-6 w-full min-w-0 overflow-hidden',
    prominent && 'glyph-matrix--prominent',
  ]}
  style={`--glyph-pitch: ${pitchPx}`}
  aria-hidden="true"
></span>

<style>
  /* Keep a static texture in browsers without CSS masking. */
  .glyph-matrix {
    --glyph-pitch: 8px;
    --glyph-base: color-mix(in srgb, currentColor 32%, transparent);

    background-image: radial-gradient(
      circle,
      var(--glyph-base) 1px,
      transparent 1.35px
    );
    background-size: var(--glyph-pitch) var(--glyph-pitch);
    background-repeat: space;
  }

  .glyph-matrix--prominent {
    --glyph-base: color-mix(in srgb, currentColor 52%, transparent);
  }

  /* The grid stays fixed while light moves behind its dots. */
  @supports (mask-image: radial-gradient(black, transparent)) {
    .glyph-matrix {
      background-color: var(--glyph-base);
      background-image: none;
      mask-image: radial-gradient(circle, black 1px, transparent 1.35px);
      mask-size: var(--glyph-pitch) var(--glyph-pitch);
      mask-repeat: space;
    }

    .glyph-matrix::before,
    .glyph-matrix::after {
      position: absolute;
      inset: 0;
      content: '';
    }

    .glyph-matrix::before {
      background:
        radial-gradient(ellipse at 18% 15%, currentColor, transparent 45%),
        radial-gradient(ellipse at 82% 85%, currentColor, transparent 45%);
      animation: glyph-twinkle 3.8s ease-in-out -1s infinite alternate;
    }

    .glyph-matrix::after {
      background: linear-gradient(
        110deg,
        transparent 26%,
        color-mix(in srgb, var(--color-primary) 65%, transparent) 41%,
        var(--color-foreground) 50%,
        color-mix(in srgb, var(--color-primary) 65%, transparent) 59%,
        transparent 74%
      );
      animation: glyph-drift 5.8s ease-in-out -2.2s infinite alternate;
    }

    .glyph-matrix--prominent::before {
      animation: glyph-twinkle-prominent 3.2s ease-in-out -1s infinite alternate;
    }
  }

  @keyframes glyph-twinkle {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 0.65;
    }
  }

  @keyframes glyph-twinkle-prominent {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 0.85;
    }
  }

  @keyframes glyph-drift {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-matrix::before,
    .glyph-matrix::after {
      animation: none;
    }

    .glyph-matrix::before {
      opacity: 0.45;
    }

    .glyph-matrix--prominent::before {
      opacity: 0.65;
    }

    .glyph-matrix::after {
      opacity: 0.55;
      transform: none;
    }
  }
</style>