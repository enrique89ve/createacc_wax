<span
  class="glyph-matrix pointer-events-none relative isolate block h-6 w-full min-w-0 overflow-hidden"
  aria-hidden="true"></span>

<style>
  /* Keep a static texture in browsers without CSS masking. */
  .glyph-matrix {
    --glyph-base: color-mix(in srgb, currentColor 32%, transparent);

    background-image: radial-gradient(
      circle,
      var(--glyph-base) 1px,
      transparent 1.4px
    );
    background-size: 8px 8px;
    background-repeat: space;
  }

  /* The grid stays fixed while light moves behind its dots. */
  @supports (mask-image: radial-gradient(black, transparent)) {
    .glyph-matrix {
      background-color: var(--glyph-base);
      background-image: none;
      mask-image: radial-gradient(circle, black 1px, transparent 1.4px);
      mask-size: 8px 8px;
      mask-repeat: space;
    }

    .glyph-matrix::before,
    .glyph-matrix::after {
      position: absolute;
      inset: 0;
      content: '';
    }

    .glyph-matrix::before {
      background:
        radial-gradient(ellipse at 18% 15%, currentColor, transparent 45%),
        radial-gradient(ellipse at 82% 85%, currentColor, transparent 45%);
      animation: glyph-twinkle 3.8s ease-in-out -1s infinite alternate;
    }

    .glyph-matrix::after {
      background: linear-gradient(
        110deg,
        transparent 26%,
        color-mix(in srgb, var(--color-primary) 65%, transparent) 41%,
        var(--color-foreground) 50%,
        color-mix(in srgb, var(--color-primary) 65%, transparent) 59%,
        transparent 74%
      );
      animation: glyph-drift 5.8s ease-in-out -2.2s infinite alternate;
    }
  }

  @keyframes glyph-twinkle {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 0.65;
    }
  }

  @keyframes glyph-drift {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-matrix::before,
    .glyph-matrix::after {
      animation: none;
    }

    .glyph-matrix::before {
      opacity: 0.45;
    }

    .glyph-matrix::after {
      opacity: 0.55;
      transform: none;
    }
  }
</style>
