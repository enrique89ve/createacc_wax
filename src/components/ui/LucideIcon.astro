---
import type { IconNode } from 'lucide'

interface Props {
  readonly icon: IconNode
  readonly class?: string
  readonly size?: number
  readonly strokeWidth?: number
}

const {
  icon,
  class: className = 'size-[1.125rem] shrink-0',
  size = 18,
  strokeWidth = 2,
} = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    icon.map(([tag, attrs]) =>
      tag === 'path' ? (
        <path {...attrs} />
      ) : tag === 'circle' ? (
        <circle {...attrs} />
      ) : tag === 'line' ? (
        <line {...attrs} />
      ) : tag === 'polyline' ? (
        <polyline {...attrs} />
      ) : tag === 'polygon' ? (
        <polygon {...attrs} />
      ) : tag === 'rect' ? (
        <rect {...attrs} />
      ) : null,
    )
  }
</svg>