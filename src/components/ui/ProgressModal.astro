---
import ProgressStepper from '@/components/ui/ProgressStepper.astro'
import { DEFAULT_LOCALE, getMessages } from '@/i18n'

const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)

const steps = [
  copy.progress.stepVerifying,
  copy.progress.stepCreating,
  copy.progress.stepRedirecting,
]
---

<div
  id="progress-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="progress-modal-title"
  data-status-active={copy.progress.statusActive}
  data-status-completed={copy.progress.statusCompleted}
  data-status-error={copy.progress.statusError}
>
  <div
    class="bg-card border-border mx-4 w-full max-w-md rounded-xl border p-6 shadow-2xl"
  >
    <div class="mb-6 text-center">
      <h2
        id="progress-modal-title"
        class="text-foreground text-xl font-semibold"
      >
        {copy.progress.modalTitle}
      </h2>
      <p class="text-muted-foreground mt-2 text-sm">
        {copy.progress.modalSubtitle}
      </p>
    </div>

    <ProgressStepper
      steps={steps}
      currentStep={-1}
      completedSteps={[]}
      errorStep={-1}
      className="mb-6"
    />

    <div class="hidden text-center" data-progress-error-actions>
      <button
        type="button"
        id="btn-close-progress"
        class="border-border bg-background text-foreground hover:bg-muted rounded-md border px-4 py-2 text-sm font-medium transition-colors"
      >
        {copy.common.close}
      </button>
    </div>
  </div>
</div>
