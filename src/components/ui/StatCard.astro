---
/**
 * Reusable StatCard component
 * Uses .card-stat class defined in global.css
 */
interface Props {
  title: string
  value: number | string
  unit: string
  description: string
  variant?: 'default' | 'success' | 'warning' | 'info'
  timestamp?: string
  action?: {
    href: string
    label: string
  }
}

const {
  title,
  value,
  unit,
  description = 'default',
  timestamp,
  action,
} = Astro.props

// Format timestamp if it exists (normalized to UTC)
let formattedTimestamp = ''
if (timestamp) {
  try {
    const utcTimestamp = timestamp.endsWith('Z') ? timestamp : `${timestamp}Z`
    const date = new Date(utcTimestamp)
    const now = new Date()
    const diffMs = now.getTime() - date.getTime()
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24))

    if (diffDays <= 0) {
      formattedTimestamp = 'Hoy'
    } else if (diffDays === 1) {
      formattedTimestamp = 'Ayer'
    } else if (diffDays < 7) {
      formattedTimestamp = `Hace ${diffDays} días`
    } else {
      formattedTimestamp = date.toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    }
  } catch (error) {
    formattedTimestamp = ''
  }
}
---

<div class="card-stat group">
  <div class="mb-4">
    <p
      class="text-muted-foreground mb-1 text-xs font-medium uppercase tracking-wide"
    >
      {title}
    </p>
    <div class="flex items-baseline gap-2">
      <span
        class="text-foreground text-4xl font-semibold tabular-nums tracking-tight"
      >
        {value}
      </span>
      {
        unit && (
          <span class="text-muted-foreground text-sm font-medium">{unit}</span>
        )
      }
    </div>
    {
      formattedTimestamp && (
        <p class="text-muted-foreground mt-1 text-xs">{formattedTimestamp}</p>
      )
    }
  </div>

  <p class="text-muted-foreground mb-4 text-xs leading-relaxed">
    {description}
  </p>

  {
    action && (
      <a
        href={action.href}
        class="bg-primary/10 text-primary ring-primary/20 hover:bg-primary/20 hover:ring-primary/30 flex w-full items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-medium ring-1 transition-all"
      >
        <slot name="action-icon" />
        {action.label}
      </a>
    )
  }
</div>
