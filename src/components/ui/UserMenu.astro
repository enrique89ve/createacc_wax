---
interface Props {
	username: string
	role: string
	credits?: number
}

const { username, role, credits } = Astro.props

// Determine display role
const getDisplayRole = (userRole: string) => {
	switch(userRole) {
		case 'builder':
			return 'Builder'
		case 'admin':
			return 'Admin'
		default:
			return 'Hiver'
	}
}

const displayRole = getDisplayRole(role)
const roleColor = role === 'builder' ? 'bg-success' : role === 'admin' ? 'bg-primary' : 'bg-muted'
---

<div class="flex items-center space-x-3">
	<!-- Hive Avatar -->
	<div class="relative">
		<img
			src={`https://images.hive.blog/u/${username}/avatar`}
			alt={`Avatar de ${username}`}
			class="h-9 w-9 rounded-full border border-border/50 object-cover shadow-sm"
			onerror="this.src='/assets/default-avatar.svg'"
		/>
		<!-- Role indicator -->
		<div
			class={`absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border border-background ${roleColor}`}
		></div>
	</div>

	<!-- User Info -->
	<div class="flex flex-col items-end min-w-0">
		<div class="text-sm font-medium text-foreground truncate max-w-[120px]">
			{username}
		</div>
		<div class="flex items-center space-x-2 text-xs">
			<span class="text-muted-foreground">{displayRole}</span>
			{
				typeof credits === 'number' && (
					<>
						<span class="text-muted-foreground">•</span>
						<span class="text-muted-foreground">
							{credits} {credits === 1 ? 'crédito' : 'créditos'}
						</span>
					</>
				)
			}
		</div>
	</div>
</div>