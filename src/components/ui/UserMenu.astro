---
interface Props {
  username: string
}

const { username } = Astro.props
---

<div class="flex items-center space-x-2">
  <!-- Hive Avatar -->
  <img
    src={`https://images.hive.blog/u/${username}/avatar`}
    alt={`Avatar de ${username}`}
    class="border-border/50 h-8 w-8 rounded-full border object-cover shadow-sm"
    data-fallback="/assets/default-avatar.svg"
  />

  <!-- Username -->
  <div class="text-foreground max-w-[120px] truncate text-sm font-medium">
    {username}
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLImageElement>('img[data-fallback]')
    .forEach(img => {
      const applyFallback = () => {
        const fallback = img.dataset.fallback
        if (fallback && img.src !== fallback) {
          img.src = fallback
        }
      }

      if (img.complete && img.naturalWidth === 0) {
        applyFallback()
        return
      }

      img.addEventListener('error', applyFallback, { once: true })
    })
</script>
