---
export interface Props {
  active: 'tickets' | 'accounts' | 'creditos'
  variant?: 'page' | 'header' | 'mobile'
}

const { active, variant = 'page' } = Astro.props as Props

const tabs = [
  { key: 'tickets', label: 'Tickets', emoji: '🎟️', href: '/builders/tickets' },
  { key: 'accounts', label: 'Cuentas', emoji: '👥', href: '/builders/accounts' },
  { key: 'creditos', label: 'Créditos', emoji: '💰', href: '/builders/creditos' },
]

// Classes based on variant
let navClasses = ''
let tabClasses = ''
let ulClasses = ''

if (variant === 'mobile') {
  // Mobile: full width tabs with compact horizontal layout
  navClasses = 'w-full py-2'
  ulClasses = 'flex w-full justify-around'
  tabClasses = 'flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg transition-colors'
} else if (variant === 'header') {
  // Header desktop: compact tabs with border
  navClasses = ''
  ulClasses = 'flex gap-2'
  tabClasses = 'inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm font-medium transition-colors'
} else {
  // Page variant: original style
  navClasses = 'border-border/60 mb-6 w-full border-b'
  ulClasses = 'flex flex-wrap gap-2 -mb-px'
  tabClasses = 'inline-flex items-center gap-2 rounded-t-md border px-4 py-2 text-sm font-medium transition-colors'
}
---

<nav
  aria-label="Secciones de Builders"
  class={navClasses}
>
  <ul role="tablist" class={ulClasses}>
    {
      tabs.map(tab => {
        const isActive = tab.key === active

        // Specific classes by variant
        let activeClasses = ''
        let inactiveClasses = ''

        if (variant === 'mobile') {
          activeClasses = 'bg-primary/15 text-primary'
          inactiveClasses = 'text-muted-foreground hover:text-foreground hover:bg-muted/50'
        } else if (variant === 'header') {
          activeClasses = 'border-primary/50 bg-primary/10 text-foreground'
          inactiveClasses = 'text-muted-foreground hover:text-foreground hover:border-border/40 border-transparent'
        } else {
          activeClasses = 'border-border border-b-background bg-background text-foreground'
          inactiveClasses = 'text-muted-foreground hover:text-foreground hover:border-border/40 border-transparent'
        }

        return (
          <li role="presentation">
            <a
              role="tab"
              aria-selected={isActive}
              tabindex={isActive ? 0 : -1}
              href={tab.href}
              class={`${tabClasses} ${isActive ? activeClasses : inactiveClasses}`}
            >
              <span class={variant === 'mobile' ? 'text-base' : ''}>{tab.emoji}</span>
              <span class="whitespace-nowrap">{tab.label}</span>
            </a>
          </li>
        )
      })
    }
  </ul>
</nav>

