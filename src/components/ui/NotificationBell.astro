---
import { getUnreadCount, getUnreadNotifications } from '@/lib/notification-service'

interface Props {
	userId: number
}

const { userId } = Astro.props

// Get unread notifications count and list
const unreadCount = await getUnreadCount(userId)
const unreadNotifications = await getUnreadNotifications(userId)
---

<div class="relative" id="notification-container">
	<!-- Bell Button -->
	<button
		type="button"
		id="notification-bell"
		class="relative inline-flex items-center justify-center rounded-md p-2 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
		aria-label="Notificaciones"
		aria-expanded="false"
	>
		<!-- Bell Icon -->
		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="h-5 w-5"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
			></path>
		</svg>

		<!-- Badge with unread count -->
		{unreadCount > 0 && (
			<span
				id="notification-badge"
				data-count={unreadCount.toString()}
				class="absolute -top-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-white ring-2 ring-background"
			>
				{unreadCount > 9 ? '9+' : unreadCount}
			</span>
		)}
	</button>

	<!-- Dropdown Panel (Hidden by default) -->
	<div
		id="notification-dropdown"
		class="absolute right-0 top-full mt-2 w-80 max-h-96 overflow-y-auto rounded-lg border border-border/40 bg-card shadow-lg z-50 hidden"
	>
		<!-- Header -->
		<div class="sticky top-0 bg-card border-b border-border/40 px-4 py-3 flex items-center justify-between">
			<h3 class="text-sm font-semibold text-foreground">Notificaciones</h3>
			{unreadCount > 0 && (
				<button
					type="button"
					id="mark-all-read-btn"
					class="text-xs text-primary hover:underline"
				>
					Marcar todas como leídas
				</button>
			)}
		</div>

		<!-- Notification List -->
		<div id="notification-list" class="divide-y divide-border/40">
			{unreadNotifications.length === 0 ? (
				<div class="px-4 py-8 text-center text-sm text-muted-foreground">
					No tienes notificaciones nuevas
				</div>
			) : (
				unreadNotifications.map((notification) => (
					<div
						class="notification-item px-4 py-3 hover:bg-accent/50 cursor-pointer transition-colors"
						data-notification-id={notification.id}
					>
						<div class="flex items-start space-x-3">
							<!-- Icon based on type -->
							<div class="flex-shrink-0 mt-0.5">
								{notification.type === 'pending_credits' && (
									<span class="text-lg">💳</span>
								)}
								{notification.type === 'account_created' && (
									<span class="text-lg">✅</span>
								)}
								{notification.type === 'credit_assigned' && (
									<span class="text-lg">🎁</span>
								)}
								{notification.type === 'system' && (
									<span class="text-lg">📢</span>
								)}
							</div>

							<!-- Content -->
							<div class="flex-1 min-w-0">
								<p class="text-sm font-medium text-foreground">
									{notification.title}
								</p>
								<p class="text-xs text-muted-foreground mt-0.5">
									{notification.message}
								</p>
								<p class="text-xs text-muted-foreground mt-1">
									{new Date(notification.created_at).toLocaleDateString('es-ES', {
										day: 'numeric',
										month: 'short',
										hour: '2-digit',
										minute: '2-digit',
									})}
								</p>
							</div>

							<!-- Mark as read button -->
							<button
								type="button"
								class="mark-read-btn flex-shrink-0 text-muted-foreground hover:text-foreground"
								data-notification-id={notification.id}
								aria-label="Marcar como leída"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-4 w-4"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
				))
			)}
		</div>
	</div>
</div>

<script>

	const EMPTY_STATE_HTML = `
		<div class="px-4 py-8 text-center text-sm text-muted-foreground">
			No tienes notificaciones nuevas
		</div>
	`

	// DOM Elements
	const bell = document.querySelector<HTMLButtonElement>('#notification-bell')!
	const dropdown = document.querySelector<HTMLDivElement>('#notification-dropdown')!
	const container = document.querySelector<HTMLDivElement>('#notification-container')!
	const notificationList = document.querySelector<HTMLDivElement>('#notification-list')!

	// State
	let isOpen = false
	let hasMarkedAsViewed = false

	// Helper Functions
	function updateBadgeCount(decrementBy: number): void {
		const badge = document.querySelector<HTMLSpanElement>('#notification-badge')
		if (!badge) return

		const currentCount = parseInt(badge.dataset.count || '0')
		const newCount = currentCount - decrementBy

		if (newCount <= 0) {
			badge.remove()
		} else {
			badge.dataset.count = newCount.toString()
			badge.textContent = newCount > 9 ? '9+' : newCount.toString()
		}
	}

	function showEmptyState(): void {
		if (notificationList.children.length === 0) {
			notificationList.innerHTML = EMPTY_STATE_HTML

			// Remove "mark all read" button
			const markAllReadBtn = document.querySelector<HTMLButtonElement>('#mark-all-read-btn')
			markAllReadBtn?.remove()
		}
	}

	function closeDropdown(): void {
		isOpen = false
		dropdown.classList.add('hidden')
		bell.setAttribute('aria-expanded', 'false')
	}

	function openDropdown(): void {
		isOpen = true
		dropdown.classList.remove('hidden')
		bell.setAttribute('aria-expanded', 'true')
	}

	async function markNotificationsAsViewed(): Promise<void> {
		if (hasMarkedAsViewed) return

		hasMarkedAsViewed = true
		try {
			const response = await fetch('/api/notifications/mark-viewed', { method: 'POST' })
			if (!response.ok) {
				console.error('[NotificationBell] Failed to mark notifications as viewed:', response.status, response.statusText)
			}
		} catch (error) {
			console.error('[NotificationBell] Error marking notifications as viewed:', error)
		}
	}

	async function markNotificationAsRead(notificationId: string): Promise<boolean> {
		const parsedId = parseInt(notificationId)
		if (isNaN(parsedId)) {
			console.error('[NotificationBell] Invalid notification ID:', notificationId)
			return false
		}

		try {
			const response = await fetch('/api/notifications/mark-read', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ notificationId: parsedId }),
			})

			if (!response.ok) {
				console.error('[NotificationBell] Failed to mark notification as read:', response.status, response.statusText)
				return false
			}

			return true
		} catch (error) {
			console.error('[NotificationBell] Error marking notification as read:', error)
			return false
		}
	}

	async function markAllNotificationsAsRead(): Promise<boolean> {
		try {
			const response = await fetch('/api/notifications/mark-all-read', {
				method: 'POST',
			})

			if (!response.ok) {
				console.error('[NotificationBell] Failed to mark all notifications as read:', response.status, response.statusText)
				return false
			}

			return true
		} catch (error) {
			console.error('[NotificationBell] Error marking all notifications as read:', error)
			return false
		}
	}

	// Event Handlers
	bell.addEventListener('click', async (e) => {
		e.stopPropagation()

		if (isOpen) {
			closeDropdown()
		} else {
			openDropdown()
			await markNotificationsAsViewed()
		}
	})

	// Close dropdown when clicking outside
	const handleOutsideClick = (e: MouseEvent) => {
		if (!container.contains(e.target as Node)) {
			closeDropdown()
		}
	}
	document.addEventListener('click', handleOutsideClick)

	// Close dropdown with Escape key
	const handleEscapeKey = (e: KeyboardEvent) => {
		if (e.key === 'Escape' && isOpen) {
			closeDropdown()
			bell.focus()
		}
	}
	document.addEventListener('keydown', handleEscapeKey)

	// Mark single notification as read
	const markReadButtons = document.querySelectorAll<HTMLButtonElement>('.mark-read-btn')
	markReadButtons.forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			e.stopPropagation()
			const notificationId = btn.dataset.notificationId

			if (!notificationId) return

			const success = await markNotificationAsRead(notificationId)
			if (success) {
				// Remove notification from UI
				const item = btn.closest('.notification-item')
				item?.remove()

				// Update badge count
				updateBadgeCount(1)

				// Show empty state if no more notifications
				showEmptyState()
			}
		})
	})

	// Mark all notifications as read
	const markAllReadBtn = document.querySelector<HTMLButtonElement>('#mark-all-read-btn')
	markAllReadBtn?.addEventListener('click', async () => {
		const success = await markAllNotificationsAsRead()
		if (success) {
			// Remove all notification items from UI
			const notificationItems = document.querySelectorAll<HTMLDivElement>('.notification-item')
			notificationItems.forEach(item => item.remove())

			// Remove badge
			const badge = document.querySelector<HTMLSpanElement>('#notification-badge')
			badge?.remove()

			// Show empty state
			notificationList.innerHTML = EMPTY_STATE_HTML

			// Remove "mark all read" button
			markAllReadBtn.remove()
		}
	})

	// Cleanup on page navigation (for Astro view transitions)
	document.addEventListener('astro:before-preparation', () => {
		document.removeEventListener('click', handleOutsideClick)
		document.removeEventListener('keydown', handleEscapeKey)
	})
</script>
