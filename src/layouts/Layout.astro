---
import Base from './Base.astro'
import Toasts from '@/components/ui/Toasts.astro'
import Navbar from '@/components/ui/Navbar.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noindex?: boolean
  localizedSeo?: boolean
}

const { title, description, ogImage, noindex = false, localizedSeo = false } = Astro.props
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  noindex={noindex}
  localizedSeo={localizedSeo}
>
  <Navbar />
  <slot />
  <Toasts />
</Base>
