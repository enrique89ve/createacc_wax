---
import '@/styles/global.css'
import '@fontsource-variable/sora'
import { SEO_DEFAULTS, ROBOTS_META } from '@/consts/seo'
import { ClientRouter } from 'astro:transitions'
import {
  DEFAULT_LOCALE,
  OG_LOCALE,
  buildCanonicalHref,
  buildLocaleAlternates,
  defaultLocaleAlternateHref,
} from '@/i18n'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noindex?: boolean
  enhancedSecurity?: boolean
  htmlClass?: string
  bodyClass?: string
  bodyAttributes?: Record<string, any>
  /** Emit hreflang + og:locale for indexable localized pages (e.g. home). */
  localizedSeo?: boolean
}

const {
  title = SEO_DEFAULTS.SITE_TITLE,
  description = SEO_DEFAULTS.SITE_DESCRIPTION,
  ogImage = SEO_DEFAULTS.OG_IMAGE,
  noindex = false,
  enhancedSecurity = false,
  htmlClass = '',
  bodyClass = 'min-h-screen bg-background text-foreground',
  bodyAttributes = {},
  localizedSeo = false,
} = Astro.props

const locale = Astro.locals.locale ?? DEFAULT_LOCALE
const canonicalHref = localizedSeo ? buildCanonicalHref(Astro.url.pathname) : null
const localeAlternates = localizedSeo
  ? buildLocaleAlternates(Astro.url.pathname)
  : []
const xDefaultHref = localizedSeo
  ? defaultLocaleAlternateHref(Astro.url.pathname)
  : null

// Determine robots meta tag value
const robotsValue = noindex
  ? enhancedSecurity
    ? ROBOTS_META.NOINDEX_SECURE
    : ROBOTS_META.NOINDEX
  : undefined
---

<!doctype html>
<html lang={locale} class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {localizedSeo && canonicalHref && (
      <link rel="canonical" href={canonicalHref} />
    )}
    {localizedSeo && canonicalHref && (
      <meta property="og:url" content={canonicalHref} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      localizedSeo &&
        localeAlternates
          .filter(alt => alt.locale !== locale)
          .map(alt => (
            <meta property="og:locale:alternate" content={OG_LOCALE[alt.locale]} />
          ))
    }
    {
      localizedSeo &&
        localeAlternates.map(alt => (
          <link rel="alternate" hreflang={alt.locale} href={alt.href} />
        ))
    }
    {localizedSeo && xDefaultHref && (
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    )}

    {robotsValue && <meta name="robots" content={robotsValue} />}
    {enhancedSecurity && <meta name="googlebot" content="noindex, nofollow" />}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={bodyClass} {...bodyAttributes}>
    <slot />
  </body>
</html>
