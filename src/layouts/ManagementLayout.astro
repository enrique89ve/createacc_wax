---
/**
 * Layout reutilizable para todas las páginas de management
 * Incluye header, navegación y funcionalidad de logout
 * Elimina duplicación de código entre páginas de administración
 */
import Layout from './Layout.astro'

interface Props {
  title: string
  activeTab: 'dashboard' | 'tickets' | 'usuarios' | 'actividad' | 'builders'
}

const { title, activeTab } = Astro.props

// Utilizar helper de Auth.js para obtener sesión
import { getAdminSession } from '@/lib/session-helpers'

const session = await getAdminSession(Astro.request)

if (!session) {
  return Astro.redirect('/management/access')
}

// Configuración de navegación
const navItems = [
  {
    key: 'dashboard',
    label: 'Dashboard',
    href: '/management/console',
    adminOnly: false,
  },
  {
    key: 'tickets',
    label: 'Tickets',
    href: '/management/vouchers',
    adminOnly: false,
  },
  {
    key: 'usuarios',
    label: 'Usuarios',
    href: '/management/agents',
    adminOnly: true,
  },
  {
    key: 'builders',
    label: 'Builders',
    href: '/management/builders',
    adminOnly: true,
  },
  {
    key: 'actividad',
    label: 'Actividad',
    href: '/management/activity',
    adminOnly: false,
  },
] as const
---

<Layout title={title}>
  <div class="bg-background min-h-screen">
    <!-- Header -->
    <header class="bg-card border-border border-b">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-4">
            <h1 class="text-foreground text-xl font-bold">Console HolaHive</h1>
            <span
              class="bg-primary/20 text-primary rounded-full px-2 py-1 text-xs font-medium"
            >
              {session.role === 'admin' ? 'Admin' : 'Builder'}
            </span>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-muted-foreground text-sm">
              Hola, {session.username}
            </span>
            <button
              id="logout-btn"
              class="bg-muted hover:bg-muted/80 text-foreground rounded-md px-3 py-1 text-sm transition-colors"
            >
              Salir
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-card border-border border-b">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex space-x-8">
          {
            navItems.map(item => {
              // Ocultar items admin-only para no-admins
              if (item.adminOnly && session.role !== 'admin') {
                return null
              }

              const isActive = activeTab === item.key
              const baseClasses =
                'px-1 py-4 text-sm font-medium transition-colors border-b-2'
              const activeClasses = 'border-primary text-primary'
              const inactiveClasses =
                'text-muted-foreground hover:text-foreground hover:border-border border-transparent'

              return (
                <a
                  href={item.href}
                  class={`${baseClasses} ${isActive ? activeClasses : inactiveClasses}`}
                >
                  {item.label}
                </a>
              )
            })
          }
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </div>

  <!-- Logout Script -->
  <script>
    const logoutBtn = document.getElementById('logout-btn')

    logoutBtn?.addEventListener('click', async () => {
      try {
        // Call custom logout endpoint to clear cookies
        await fetch('/api/auth/management-logout', {
          method: 'POST',
        })
      } catch (error) {
        console.error('Logout error:', error)
      } finally {
        // Always redirect to login page
        window.location.href = '/management/access'
      }
    })
  </script>
</Layout>
