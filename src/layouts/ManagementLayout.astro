---
/**
 * Layout reutilizable para todas las páginas de management
 * Incluye header, navegación y funcionalidad de logout
 * Elimina duplicación de código entre páginas de administración
 */
import Base from './Base.astro'
import Toasts from '@/components/ui/Toasts.astro'
import LocaleSwitch from '@/components/ui/LocaleSwitch.astro'
import { TITLE_SUFFIXES } from '@/consts/seo'
import { BRAND } from '@/consts/branding'
import { UserRole } from '@/lib/roles'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'

interface Props {
  title: string
  activeTab:
    | 'dashboard'
    | 'tickets'
    | 'accounts'
    | 'logs'
    | 'builders'
    | 'invites'
}

const { title, activeTab } = Astro.props

// Add suffix to title for consistency
const pageTitle = `${title} - ${TITLE_SUFFIXES.MANAGEMENT}`

// Utilizar helper de Auth.js para obtener sesión
import { getAdminSession } from '@/lib/session-helpers'

const session = await getAdminSession(Astro.request)
const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const shell = copy.shell.management

if (!session) {
  return Astro.redirect('/management/access')
}

// Configuración de navegación
const navItems = [
  {
    key: 'dashboard',
    label: shell.nav.dashboard,
    href: '/management/console',
    adminOnly: false,
  },
  {
    key: 'tickets',
    label: shell.nav.tickets,
    href: '/management/vouchers',
    adminOnly: false,
  },
  {
    key: 'accounts',
    label: shell.nav.accounts,
    href: '/management/accounts',
    adminOnly: true,
  },
  {
    key: 'builders',
    label: shell.nav.builders,
    href: '/management/builders',
    adminOnly: true,
  },
  {
    key: 'invites',
    label: shell.nav.invites,
    href: '/management/invites',
    adminOnly: true,
  },
  {
    key: 'logs',
    label: shell.nav.logs,
    href: '/management/logs',
    adminOnly: true,
  },
] as const
---

<Base title={pageTitle} noindex enhancedSecurity>
  <div class="bg-background min-h-screen">
    <!-- Header -->
    <header class="bg-card border-border border-b">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-2 py-2">
          <div class="flex items-center gap-4">
            <h1 class="text-foreground text-xl font-bold">
              {interpolate(shell.console, { brand: BRAND.NAME })}
            </h1>
            <span
              class="bg-primary/20 text-primary rounded-full px-2 py-1 text-xs font-medium"
            >
              {session.role === UserRole.Admin
                ? shell.roleAdmin
                : shell.roleBuilder}
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <LocaleSwitch />
            <span class="text-muted-foreground text-sm">
              {interpolate(shell.greeting, { username: session.username })}
            </span>
            <button
              id="logout-btn"
              class="bg-muted hover:bg-muted/80 text-foreground rounded-md px-3 py-1 text-sm transition-colors"
            >
              {shell.logout}
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-card border-border border-b">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap gap-x-5">
          {
            navItems.map(item => {
              // Ocultar items admin-only para no-admins
              if (item.adminOnly && session.role !== UserRole.Admin) {
                return null
              }

              const isActive = activeTab === item.key
              const baseClasses =
                'px-1 py-4 text-sm font-medium transition-colors border-b-2'
              const activeClasses = 'border-primary text-primary'
              const inactiveClasses =
                'text-muted-foreground hover:text-foreground hover:border-border border-transparent'

              return (
                <a
                  href={item.href}
                  class={`${baseClasses} ${isActive ? activeClasses : inactiveClasses}`}
                >
                  {item.label}
                </a>
              )
            })
          }
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </div>

  <Toasts />

  <!-- Logout Script -->
  <script>
    const logoutBtn = document.getElementById('logout-btn')

    logoutBtn?.addEventListener('click', async () => {
      try {
        // Call custom logout endpoint to clear cookies
        await fetch('/api/auth/management-logout', {
          method: 'POST',
        })
      } catch (error) {
        console.error('Logout error:', error)
      } finally {
        // Always redirect to login page
        window.location.href = '/management/access'
      }
    })
  </script>
</Base>
