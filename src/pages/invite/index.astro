---
import Layout from '@/layouts/Layout.astro'
import InviteBrandMark from '@/components/invite/InviteBrandMark.astro'
import LucideIcon from '@/components/ui/LucideIcon.astro'
import LucideXBrandIcon from '@/components/ui/icons/LucideXBrandIcon.astro'
import { LUCIDE_GITHUB_ICON } from '@/consts/lucide-social-icons'
import { getMessages, DEFAULT_LOCALE } from '@/i18n'
import { getInvitePageState } from '@/lib/invite/page-state'
import { isSimulationMode } from '@/lib/hive-execution-mode'

const copy = (Astro.locals.messages ?? getMessages(DEFAULT_LOCALE)).invite
const simulated = isSimulationMode()
const completedTitle = simulated ? copy.simulatedCompleted : copy.completed
const completedDescription = simulated
  ? copy.simulatedCompletedDescription
  : copy.completedDescription
const state = await getInvitePageState(Astro.request)
const authenticated = !['login', 'unavailable'].includes(state.kind)
const showLoading = state.kind === 'login' || state.kind === 'prepare'
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
const titleClass =
  'text-card-foreground max-w-[18ch] text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-4xl sm:leading-[1.1]'
const loginHeroTitleClass =
  'text-card-foreground text-balance text-center text-2xl font-semibold leading-tight tracking-tight sm:text-3xl'
const loginHeroIntroClass =
  'text-muted-foreground mx-auto max-w-sm text-center text-sm leading-relaxed sm:text-base'
const buttonClass =
  'border-input text-foreground hover:bg-muted focus-visible:ring-ring inline-flex min-h-12 w-full items-center justify-center gap-2.5 rounded-lg border px-4 py-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 disabled:cursor-not-allowed disabled:opacity-50'
const actionClass =
  'bg-invite-action text-primary-foreground hover:bg-invite-action-hover focus-visible:ring-ring active:bg-invite-action-hover focus-visible:ring-offset-card inline-flex min-h-12 w-full items-center justify-center gap-2.5 rounded-lg px-5 py-3 text-center text-sm font-semibold leading-6 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 motion-reduce:transition-none'
const continueClass =
  'bg-invite-action text-primary-foreground hover:bg-invite-action-hover focus-visible:ring-ring active:bg-invite-action-hover focus-visible:ring-offset-card inline-flex min-h-12 w-full items-center justify-center rounded-lg px-5 py-3 text-center text-base font-semibold leading-[1.18] tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 motion-reduce:transition-none'
const successActionClass =
  'text-card-foreground hover:bg-invite-diamond-muted focus-visible:ring-ring inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg px-3 py-3 text-sm font-medium underline decoration-input underline-offset-4 transition-colors active:bg-invite-diamond focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-card disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none'
const codeActionClass =
  'text-card-foreground hover:bg-invite-diamond-muted focus-visible:ring-ring inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg px-2 text-sm font-medium underline decoration-input underline-offset-4 transition-colors active:bg-invite-diamond focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-card motion-reduce:transition-none'
---

<Layout title={copy.title} description={copy.introduction} noindex>
  <section
    id="invite-page"
    data-auto-issue={state.kind === 'prepare' ? 'true' : undefined}
    class="mx-auto flex min-h-[calc(100dvh-4rem)] w-full max-w-xl items-center px-4 py-10 sm:px-6"
  >
    <div
      id="invite-card"
      transition:name="invite-card"
      class="border-border bg-card min-w-0 rounded-xl border p-6 sm:p-9"
    >
      <div class="space-y-6">
        {
          state.kind === 'login' && (
            <div data-invite-panel="login" class="space-y-7">
              <header class="flex flex-col items-center gap-4 text-center sm:gap-5">
                <InviteBrandMark />
                <div class="space-y-2">
                  <h1 class={loginHeroTitleClass}>{copy.title}</h1>
                  <p class={loginHeroIntroClass}>{copy.introduction}</p>
                </div>
              </header>
              <div class="space-y-3">
                <button type="button" data-invite-provider="github" disabled={!state.providers.includes('github')} class={actionClass}>
                  <LucideIcon icon={LUCIDE_GITHUB_ICON} size={20} />
                  <span>{copy.signInGithub}</span>
                </button>
                <button type="button" data-invite-provider="twitter" disabled={!state.providers.includes('twitter')} class={buttonClass}>
                  <LucideXBrandIcon class="size-5" />
                  <span>{copy.signInTwitter}</span>
                </button>
              </div>
              <p class="text-muted-foreground mx-auto max-w-sm text-center text-xs leading-relaxed">{copy.personal}</p>
            </div>
          )
        }
        {
          showLoading && (
            <div
              data-invite-panel="loading"
              role="status"
              class:list={['space-y-6', state.kind === 'login' && 'hidden']}
              aria-hidden={state.kind === 'login' ? 'true' : undefined}
            >
              <header class="flex flex-col items-center gap-4 text-center sm:gap-5">
                <InviteBrandMark />
                <h1 id="invite-loading-title" tabindex="-1" class={loginHeroTitleClass}>
                  {state.kind === 'prepare' ? copy.preparing : copy.connecting}
                </h1>
              </header>
              <div class="space-y-3" aria-hidden="true">
                <div class="bg-muted h-12 rounded-lg motion-safe:animate-pulse"></div>
                <div class="bg-muted h-12 rounded-lg motion-safe:animate-pulse"></div>
              </div>
            </div>
          )
        }
        {
          state.kind === 'available' && (
            <div class="space-y-6">
              <header class="space-y-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0 space-y-1 text-sm leading-6">
                    <p class="text-muted-foreground">{`${copy.welcomeCreator}${copy.welcomeEnd}`}</p>
                    {state.username && (
                      <p class="text-invite-accent font-medium [overflow-wrap:anywhere]">@{state.username}</p>
                    )}
                  </div>
                  <InviteBrandMark centered={false} class="sm:max-w-[4.5rem]" />
                </div>
                <h1 class={titleClass}>{copy.ready}</h1>
              </header>
              <div class="space-y-6">
                <div class="bg-invite-code flex min-w-0 items-center gap-3 rounded-lg px-4 py-2 sm:px-5">
                  <p class="sr-only">{copy.codeLabel}</p>
                  <code class="text-card-foreground min-w-0 flex-1 font-mono text-base font-medium leading-5 break-all sm:text-lg sm:leading-6">
                    {state.ticketCode}
                  </code>
                  <button
                    type="button"
                    data-copy-value={state.ticketCode}
                    data-copy-success={copy.codeCopied}
                    class={codeActionClass}
                  >
                    {copy.copyCode}
                  </button>
                </div>
                <div class="flex flex-col items-stretch gap-3">
                  <a
                    href={state.url}
                    data-astro-reload
                    class={continueClass}
                  >
                    {copy.continue}
                  </a>
                  <button
                    type="button"
                    data-copy-value={state.url}
                    data-copy-success={copy.copied}
                    class={`${successActionClass} self-center`}
                  >
                    {copy.copy}
                  </button>
                </div>
                <p class="text-muted-foreground text-xs leading-relaxed">{copy.oneUse}</p>
              </div>
            </div>
          )
        }
        {
          state.kind === 'processing' && (
            <div class="space-y-3">
              <h1 class="text-foreground text-lg font-semibold">{copy.processing}</h1>
              <p class="text-foreground text-sm break-words">@{state.username}</p>
              <p class="text-muted-foreground text-sm leading-relaxed">{copy.processingDescription}</p>
              <a href="/invite" data-astro-reload class={`${buttonClass} flex items-center justify-center`}>
                {copy.refresh}
              </a>
            </div>
          )
        }
        {
          state.kind === 'completed' && (
            <div class="space-y-3">
              <h1 class="text-foreground text-lg font-semibold">{completedTitle}</h1>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {completedDescription}{' '}
                <strong class="text-foreground break-words">@{state.username}</strong>.
              </p>
            </div>
          )
        }
        {
          state.kind === 'unavailable' && (
            <p role="status" class="text-muted-foreground text-sm leading-relaxed">
              {copy.unavailable}
            </p>
          )
        }
        <p id="invite-feedback" role="status" aria-live="polite" class="text-muted-foreground hidden text-sm leading-relaxed"></p>
        <button id="invite-retry" type="button" class={`${buttonClass} hidden`}>{copy.retry}</button>
        {
          authenticated && (
            <button
              id="invite-signout"
              type="button"
              class={`text-muted-foreground hover:text-foreground focus-visible:ring-ring active:bg-muted min-h-12 w-full rounded-lg px-4 py-3 underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 ${state.kind === 'available' ? 'border-border border-t text-xs' : 'text-sm'}`}
            >
              {copy.signOut}
            </button>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  #invite-card {
    view-transition-name: invite-card;
  }

  ::view-transition-old(root),
  ::view-transition-new(root),
  ::view-transition-old(invite-card),
  ::view-transition-new(invite-card) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<script>
  import { initializeInvitePage } from '@/lib/invite/client'
  initializeInvitePage()
  document.addEventListener('astro:page-load', initializeInvitePage)
</script>
