---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'
import { UserRole } from '@/lib/roles'
import { getInviteConfiguration } from '@/lib/invite/config'
import { getInviteCampaignSettings } from '@/lib/invite/campaign-settings'
import { hasInviteSchema, requireInviteSchemaKey } from '@/lib/invite/schema'
import { logger } from '@/lib/logger'

const session = Astro.locals.adminUser
const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const page = copy.admin.invites

if (!session) {
  return Astro.redirect('/management/access')
}
if (session.role !== UserRole.Admin) {
  return Astro.redirect('/management/console')
}

const configuration = getInviteConfiguration()
let settings: Awaited<ReturnType<typeof getInviteCampaignSettings>> | null =
  null
let setupReady = false
let setupError = page.missingSecret
const providers = {
  github: Boolean(configuration?.providers.github),
  twitter: Boolean(configuration?.providers.twitter),
}
const providerReady = providers.github || providers.twitter

try {
  if (configuration && (await hasInviteSchema())) {
    await requireInviteSchemaKey(configuration.identitySecret)
    settings = await getInviteCampaignSettings()
    setupReady = true
  } else if (configuration) {
    setupError = page.needsInit
  }
} catch (error) {
  logger.warn('[invite] Admin campaign settings are unavailable')
  setupError =
    error instanceof Error && error.message.includes('identity key')
      ? page.keyMismatch
      : page.readError
}

const inputClass =
  'bg-background border-border text-foreground focus-visible:border-primary focus-visible:ring-primary min-h-12 w-full rounded-md border px-3 py-2 focus:outline-none focus-visible:ring-1'
---

<ManagementLayout title={page.title} activeTab="invites">
  <section
    class="bg-card border-border mx-auto max-w-3xl rounded-xl border p-5 sm:p-7"
  >
    <div class="mb-6">
      <p class="text-primary text-sm font-semibold">{page.eyebrow}</p>
      <h2 class="text-foreground mt-1 text-2xl font-bold">{page.title}</h2>
      <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-relaxed">
        {page.description}
      </p>
      <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
        {page.adminOnly}
      </p>
    </div>

    {
      setupReady && settings ? (
        <>
          <div class="border-border mb-6 rounded-lg border p-4">
            <h3 class="text-foreground text-sm font-semibold">
              {page.providers}
            </h3>
            <ul class="text-muted-foreground mt-3 grid gap-2 text-sm sm:grid-cols-2">
              <li class="flex items-center gap-2">
                <span
                  aria-hidden="true"
                  class={
                    providers.github
                      ? 'text-emerald-500'
                      : 'text-muted-foreground'
                  }
                >
                  {providers.github ? '●' : '○'}
                </span>
                GitHub{' '}
                {providers.github ? page.available : page.missingCredentials}
              </li>
              <li class="flex items-center gap-2">
                <span
                  aria-hidden="true"
                  class={
                    providers.twitter
                      ? 'text-emerald-500'
                      : 'text-muted-foreground'
                  }
                >
                  {providers.twitter ? '●' : '○'}
                </span>
                X {providers.twitter ? page.available : page.missingCredentials}
              </li>
            </ul>
          </div>

          <form
            id="invite-campaign-form"
            data-revision={settings.revision}
            data-saved-enabled={settings.enabled ? 'true' : 'false'}
            data-saved-limit={settings.totalLimit}
            data-provider-ready={providerReady ? 'true' : 'false'}
            data-status-active={page.statusActive}
            data-status-paused={page.statusPaused}
            data-no-changes={page.noChanges}
            data-limit-required={page.limitRequired}
            data-providers-required={page.missingProviders}
            data-saving={page.saving}
            data-saved={page.saved}
            data-save-error={page.saveError}
            data-save-retry={page.saveRetry}
            data-invalid-response={page.invalidResponse}
            class="space-y-5"
          >
            <div class="border-border flex items-center justify-between gap-4 rounded-lg border p-4">
              <div>
                <p class="text-muted-foreground text-xs font-medium">
                  {page.statusLabel}
                </p>
                <p class="text-foreground mt-1 flex items-center gap-2 text-sm font-semibold">
                  <span
                    id="invite-campaign-status-dot"
                    aria-hidden="true"
                    class:list={[
                      'h-2 w-2 rounded-full',
                      settings.enabled
                        ? 'bg-emerald-500'
                        : 'bg-muted-foreground',
                    ]}
                  />
                  <span id="invite-campaign-status-label">
                    {settings.enabled ? page.statusActive : page.statusPaused}
                  </span>
                </p>
              </div>
              <button
                id="invite-campaign-enabled"
                type="button"
                role="switch"
                aria-checked={settings.enabled ? 'true' : 'false'}
                aria-labelledby="invite-campaign-enabled-label"
                class="bg-muted focus-visible:ring-primary/40 group relative inline-flex h-6 w-11 shrink-0 rounded-full transition-colors focus-visible:outline-none focus-visible:ring-2 aria-checked:bg-emerald-500"
              >
                <span class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow-sm transition-transform group-aria-checked:translate-x-5" />
              </button>
            </div>
            <div>
              <p
                id="invite-campaign-enabled-label"
                class="text-foreground text-sm font-medium"
              >
                {page.enabled}
              </p>
              <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
                {page.enabledHelp}
              </p>
              <p
                id="invite-campaign-draft"
                class="text-muted-foreground mt-2 hidden text-xs"
              >
                {page.draftHint}
              </p>
            </div>

            <div>
              <label
                for="invite-campaign-limit"
                class="text-foreground mb-2 block text-sm font-medium"
              >
                {page.limit}
              </label>
              <input
                id="invite-campaign-limit"
                name="total_limit"
                type="number"
                min="0"
                max="1000000"
                step="1"
                required
                value={settings.totalLimit}
                class={`${inputClass} sm:max-w-xs`}
                aria-describedby="invite-campaign-count invite-campaign-limit-help"
              />
              <p
                id="invite-campaign-count"
                data-template={page.issued}
                class="text-muted-foreground mt-2 text-sm"
              >
                {interpolate(page.issued, {
                  issued: String(settings.issuedCount),
                  total: String(settings.totalLimit),
                })}
              </p>
              <p
                id="invite-campaign-limit-help"
                class="text-muted-foreground mt-1 text-xs"
              >
                {page.limitHelp}
              </p>
            </div>

            {!providerReady && (
              <p class="text-sm text-amber-500" role="status">
                {page.missingProviders}
              </p>
            )}

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <button
                id="invite-campaign-review"
                type="button"
                class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-primary/40 min-h-12 rounded-md px-5 py-3 text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2"
              >
                {page.review}
              </button>
              <p
                id="invite-campaign-feedback"
                class="text-muted-foreground text-sm"
                role="status"
                aria-live="polite"
              />
            </div>
          </form>

          <div
            id="invite-confirm-dialog"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
            aria-hidden="true"
            data-title-activate={page.confirmTitleActivate}
            data-title-pause={page.confirmTitlePause}
            data-title-update={page.confirmTitleUpdate}
            data-body-activate={page.confirmBodyActivate}
            data-body-pause={page.confirmBodyPause}
            data-body-update={page.confirmBodyUpdate}
            data-phrase-activate={page.phraseActivate}
            data-phrase-pause={page.phrasePause}
            data-phrase-update={page.phraseUpdate}
            data-confirm-activate={page.confirmActivate}
            data-confirm-pause={page.confirmPause}
            data-confirm-update={page.confirmUpdate}
            data-type-to-confirm={page.typeToConfirm}
            data-summary-status={page.summaryStatus}
            data-summary-limit={page.summaryLimit}
          >
            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="invite-confirm-title"
              class="bg-card border-border w-full max-w-md rounded-xl border p-6 shadow-md"
            >
              <p class="text-primary text-xs font-semibold uppercase tracking-wide">
                {page.confirmationEyebrow}
              </p>
              <h3
                id="invite-confirm-title"
                class="text-foreground mt-2 text-lg font-semibold"
              />
              <p
                id="invite-confirm-body"
                class="text-muted-foreground mt-2 text-sm leading-relaxed"
              />
              <dl
                id="invite-confirm-summary"
                class="border-border bg-muted/40 mt-4 space-y-2 rounded-lg border px-4 py-3 text-sm"
              />

              <div class="mt-4">
                <label
                  for="invite-confirm-reason"
                  class="text-foreground mb-2 block text-sm font-medium"
                >
                  {page.reason}
                </label>
                <input
                  id="invite-confirm-reason"
                  type="text"
                  maxlength="500"
                  autocomplete="off"
                  placeholder={page.reasonPlaceholder}
                  class={inputClass}
                />
              </div>

              <div class="mt-4">
                <label
                  for="invite-confirm-phrase"
                  id="invite-confirm-phrase-label"
                  class="text-foreground mb-2 block text-sm font-medium"
                />
                <input
                  id="invite-confirm-phrase"
                  type="text"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  class={`${inputClass} font-mono tracking-wide`}
                />
              </div>

              <p
                id="invite-confirm-feedback"
                class="mt-3 text-sm text-amber-500"
                role="status"
                aria-live="polite"
              />

              <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button
                  id="invite-confirm-cancel"
                  type="button"
                  class="border-border text-foreground hover:bg-muted focus-visible:ring-primary/40 min-h-12 rounded-md border px-4 py-3 text-sm font-medium focus:outline-none focus-visible:ring-2"
                >
                  {page.cancel}
                </button>
                <button
                  id="invite-confirm-submit"
                  type="button"
                  disabled
                  class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-primary/40 min-h-12 rounded-md px-5 py-3 text-sm font-semibold focus:outline-none focus-visible:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
                />
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="border-border bg-muted/30 rounded-lg border p-4">
          <p class="text-foreground text-sm font-medium">{page.pending}</p>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            {setupError}
          </p>
        </div>
      )
    }
  </section>
</ManagementLayout>

<script>
  import { initializeInviteCampaignSettings } from '@/lib/admin_ui/invite-campaign'
  initializeInviteCampaignSettings()
</script>
