---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { formatDate } from '@/utils/date-formatters'
import { ticketsRepository } from '@/lib/repositories/tickets-repository'
import type { TicketWithCreator } from '@/types/database'
import { UserRole } from '@/lib/roles'
import { MAX_TICKET_USES, TICKET_LENGTH } from '@/consts/constants'

// La autenticación ya se maneja en ManagementLayout
const session = Astro.locals.adminUser as import('@/types/auth').AdminSession

let tickets: TicketWithCreator[] = []

try {
  tickets = await ticketsRepository.getAllWithCreators()
} catch (_error) {
  // Non-critical: page renders with empty ticket list as fallback
}
---

<ManagementLayout title="Gestión de Tickets" activeTab="tickets">
  <!-- Header Section -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h2 class="text-foreground text-2xl font-bold">Gestión de Tickets</h2>
      <p class="text-muted-foreground mt-1">
        Crea tickets del sistema y consulta todos los tickets
      </p>
    </div>
  </div>

  <!-- Admin-only ticket creation -->
  <section class="bg-card border-border mb-8 rounded-lg border p-6">
    <div class="mb-5">
      <h3 class="text-foreground text-lg font-semibold">Crear ticket</h3>
      <p class="text-muted-foreground mt-1 text-sm">
        Los tickets creados por admin no descuentan créditos de ningún Builder.
      </p>
    </div>

    <form id="admin-create-ticket-form" class="grid gap-4 md:grid-cols-4">
      <div class="md:col-span-2">
        <label
          for="admin-ticket-code"
          class="text-foreground mb-2 block text-sm font-medium">Código</label
        >
        <input
          id="admin-ticket-code"
          name="code"
          type="text"
          minlength={TICKET_LENGTH.MIN}
          maxlength={TICKET_LENGTH.MAX}
          pattern="[A-Za-z0-9]+"
          autocomplete="off"
          required
          class="bg-background border-border text-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 uppercase focus:outline-none focus:ring-1"
          placeholder="PROMO2025AB"
          aria-describedby="admin-ticket-code-help"
        />
        <p
          id="admin-ticket-code-help"
          class="text-muted-foreground mt-1 text-xs"
        >
          {TICKET_LENGTH.MIN}-{TICKET_LENGTH.MAX} caracteres alfanuméricos.
        </p>
      </div>

      <div>
        <label
          for="admin-ticket-uses"
          class="text-foreground mb-2 block text-sm font-medium">Usos</label
        >
        <input
          id="admin-ticket-uses"
          name="uses"
          type="number"
          min="1"
          max={MAX_TICKET_USES}
          value="1"
          required
          class="bg-background border-border text-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 focus:outline-none focus:ring-1"
        />
      </div>

      <div>
        <label
          for="admin-ticket-description"
          class="text-foreground mb-2 block text-sm font-medium"
          >Descripción</label
        >
        <input
          id="admin-ticket-description"
          name="description"
          type="text"
          maxlength="200"
          class="bg-background border-border text-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 focus:outline-none focus:ring-1"
          placeholder="Opcional"
        />
      </div>

      <div
        class="flex flex-col gap-2 md:col-span-4 md:flex-row md:items-center"
      >
        <button
          type="submit"
          class="bg-primary hover:bg-primary/90 rounded-md px-4 py-2 text-sm font-medium text-white transition-colors"
          >Crear ticket</button
        >
        <p
          id="admin-ticket-feedback"
          class="hidden text-sm"
          role="status"
          aria-live="polite"
        >
        </p>
      </div>
    </form>
  </section>

  {/* Quota Warning for Builders */}
  {
    false && (
      <div class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 p-4">
        <div class="flex">
          <div class="text-yellow-400">⚠️</div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">
              Límite de tickets alcanzado
            </h3>
            <p class="mt-1 text-sm text-yellow-700">
              Has alcanzado tu límite de tickets. Contacta a un administrador
              para aumentar tu quota.
            </p>
          </div>
        </div>
      </div>
    )
  }

  <!-- Tickets Table -->
  <div class="bg-card border-border overflow-hidden rounded-lg border">
    <div class="border-border border-b px-6 py-4">
      <h3 class="text-foreground text-lg font-semibold">
        {session.role === UserRole.Admin ? 'Todos los Tickets' : 'Mis Tickets'}
      </h3>
    </div>

    {
      tickets.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="divide-border w-full divide-y">
            <thead class="bg-muted/50">
              <tr>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Código
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Tipo
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Estado
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Creado por
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Fecha
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Usos
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Link
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody class="bg-background divide-border divide-y">
              {tickets.map(ticket => (
                <tr class="hover:bg-muted/20">
                  <td class="whitespace-nowrap px-6 py-4">
                    <div class="text-foreground text-sm font-medium">
                      {ticket.code}
                    </div>
                    {ticket.description && (
                      <div class="text-muted-foreground text-sm">
                        {ticket.description}
                      </div>
                    )}
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span
                      class={`inline-flex rounded-full px-2 py-1 text-xs font-medium ${
                        ticket.creator_role === UserRole.Admin
                          ? 'bg-purple-100 text-purple-800'
                          : 'bg-gray-100 text-gray-800'
                      }`}
                    >
                      {ticket.creator_role ?? 'manual'}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span
                      class={`inline-flex rounded-full px-2 py-1 text-xs font-medium ${
                        !ticket.is_active
                          ? 'bg-red-100 text-red-800'
                          : ticket.has_been_used
                            ? 'bg-green-100 text-green-800'
                            : 'bg-yellow-100 text-yellow-800'
                      }`}
                    >
                      {!ticket.is_active
                        ? 'Sin créditos'
                        : ticket.has_been_used
                          ? 'En uso'
                          : 'Disponible'}
                    </span>
                  </td>
                  <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {ticket.creator_username}
                  </td>
                  <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {formatDate(ticket.created_at)}
                  </td>
                  <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {ticket.remaining_uses ?? 1}/{ticket.total_uses ?? 1}
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <button
                      class="text-primary hover:text-primary/80 flex items-center gap-1 text-sm font-medium transition-colors"
                      data-action="copy-link"
                      data-ticket-code={ticket.code}
                      title="Copiar link con ticket"
                    >
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                        />
                      </svg>
                      Copiar
                    </button>
                  </td>
                  <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                    <span class="text-muted-foreground text-xs">
                      Solo lectura
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="p-8 text-center">
          <div class="text-muted-foreground mb-4 text-6xl">🎫</div>
          <p class="text-foreground mb-2 text-lg font-medium">No hay tickets</p>
          <p class="text-muted-foreground">
            Aún no se han creado tickets en el sistema
          </p>
        </div>
      )
    }
  </div>
</ManagementLayout>

<!-- Copy Success Toast -->
<div
  id="copy-toast"
  class="fixed bottom-4 right-4 z-50 hidden rounded-lg border border-green-200 bg-green-50 p-4 shadow-lg"
>
  <div class="flex items-center gap-2">
    <svg
      class="h-5 w-5 text-green-600"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 13l4 4L19 7"></path>
    </svg>
    <p class="text-sm font-medium text-green-800">
      Link copiado al portapapeles
    </p>
  </div>
</div>

<script src="@/scripts/management/vouchers.ts"></script>
