---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { DEFAULT_LOCALE, getMessages } from '@/i18n'
import { formatDateTime } from '@/utils/date-formatters'
import { accountsRepository } from '@/lib/repositories/accounts-repository'
import type { DatabaseAccountRow } from '@/types/database'
import { toAccountStatusLabel } from '@/lib/account-status'
import { logger } from '@/lib/logger'

// Get session data from middleware
const session = Astro.locals.adminUser
const locale = Astro.locals.locale ?? DEFAULT_LOCALE
const copy = Astro.locals.messages ?? getMessages(locale)
const page = copy.admin.accounts
const filters = copy.states.accountFilter
const sortLabels = copy.states.sort

if (!session) {
  return Astro.redirect('/management/access')
}

// Obtener parámetros de filtros desde URL
const url = new URL(Astro.request.url)
const ticketFilter = url.searchParams.get('ticket') || ''
const userFilter = url.searchParams.get('user') || ''
const sortOrder = url.searchParams.get('sort') || 'desc' // desc = más reciente primero
const statusFilter = url.searchParams.get('status') || 'all'

// Obtener todas las cuentas (sin JOINs - builder_username ya está poblado)
let accounts: DatabaseAccountRow[] = []
let error: string | null = null

try {
  // Obtener todas las cuentas (builder_username ya incluye el username del creador)
  accounts = await accountsRepository.getAll()

  // Aplicar filtros manualmente si es necesario
  if (ticketFilter) {
    accounts = accounts.filter(acc => acc.ticket === ticketFilter)
  }

  if (userFilter) {
    accounts = accounts.filter(acc =>
      acc.username.toLowerCase().includes(userFilter.toLowerCase())
    )
  }

  if (statusFilter === 'simulated') {
    accounts = accounts.filter(acc => acc.blockchain_status === 'simulated')
  } else if (statusFilter === 'live') {
    accounts = accounts.filter(acc => acc.blockchain_status !== 'simulated')
  }

  // Aplicar ordenamiento
  if (sortOrder === 'asc') {
    accounts = accounts.sort(
      (a, b) =>
        new Date(a.creation_date).getTime() -
        new Date(b.creation_date).getTime()
    )
  } else {
    accounts = accounts.sort(
      (a, b) =>
        new Date(b.creation_date).getTime() -
        new Date(a.creation_date).getTime()
    )
  }
} catch (loadError) {
  error = page.loadError
  logger.error('Error loading accounts:', loadError)
}
---

<ManagementLayout title={page.title} activeTab="accounts">
  <div class="bg-background min-h-screen">
    <!-- Main Content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-foreground text-3xl font-bold">{page.title}</h1>
        <p class="text-muted-foreground mt-2">
          {page.description}
        </p>
      </div>

      <!-- Filtros -->
      <div class="bg-card border-border mb-6 rounded-lg border p-6">
        <form method="GET" action="/management/accounts" class="space-y-4">
          <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <!-- Filtro por Ticket -->
            <div>
              <label
                for="ticket"
                class="text-foreground mb-2 block text-sm font-medium"
              >
                {page.ticket}
              </label>
              <input
                type="text"
                id="ticket"
                name="ticket"
                value={ticketFilter}
                placeholder={page.ticketPlaceholder}
                class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1"
              />
            </div>

            <!-- Filtro por Usuario -->
            <div>
              <label
                for="user"
                class="text-foreground mb-2 block text-sm font-medium"
              >
                {page.user}
              </label>
              <input
                type="text"
                id="user"
                name="user"
                value={userFilter}
                placeholder={page.userPlaceholder}
                class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1"
              />
            </div>

            <div>
              <label
                for="status"
                class="text-foreground mb-2 block text-sm font-medium"
              >
                {page.status}
              </label>
              <select
                id="status"
                name="status"
                class="bg-background border-border text-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus-visible:ring-1"
              >
                <option value="all" selected={statusFilter === 'all'}
                  >{filters.all}</option
                >
                <option
                  value="simulated"
                  selected={statusFilter === 'simulated'}>{filters.simulated}</option
                >
                <option value="live" selected={statusFilter === 'live'}
                  >{filters.live}</option
                >
              </select>
            </div>

            <!-- Ordenar por Fecha -->
            <div>
              <label
                for="sort"
                class="text-foreground mb-2 block text-sm font-medium"
              >
                {page.sort}
              </label>
              <select
                id="sort"
                name="sort"
                class="bg-background border-border text-foreground focus:border-primary focus:ring-primary w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1"
              >
                <option value="desc" selected={sortOrder === 'desc'}>
                  {sortLabels.newest}
                </option>
                <option value="asc" selected={sortOrder === 'asc'}>
                  {sortLabels.oldest}
                </option>
              </select>
            </div>
          </div>

          <!-- Botones de acción -->
          <div class="flex gap-3">
            <button
              type="submit"
              class="bg-primary hover:bg-primary/90 rounded-md px-4 py-2 text-sm font-medium text-white transition-colors"
            >
              {copy.ui.applyFilters}
            </button>
            <a
              href="/management/accounts"
              class="bg-muted hover:bg-muted/80 text-foreground rounded-md px-4 py-2 text-sm font-medium transition-colors"
            >
              {copy.ui.clearFilters}
            </a>
          </div>
        </form>
      </div>

      <!-- Estadísticas -->
      <div class="bg-card border-border mb-6 rounded-lg border p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-muted-foreground text-sm">{page.total}</span>
            <span class="text-foreground text-lg font-bold"
              >{accounts.length}</span
            >
          </div>
          {
            (ticketFilter || userFilter) && (
              <span class="text-muted-foreground text-sm italic">
                {page.filtered}
              </span>
            )
          }
        </div>
      </div>

      <!-- Error Message -->
      {
        error && (
          <div class="mb-6 rounded-lg border border-red-500/20 bg-red-500/10 p-4 text-red-500">
            <p class="text-sm">{error}</p>
          </div>
        )
      }

      <!-- Tabla de Cuentas -->
      <div class="bg-card border-border overflow-hidden rounded-lg border">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-muted">
              <tr>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  ID
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {page.hiveUser}
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {page.status}
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {page.ticket}
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {page.createdAt}
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {page.reference}
                </th>
                <th
                  class="border-border text-foreground border-b px-6 py-3 text-left text-xs font-medium uppercase tracking-wider"
                >
                  {copy.ui.actions}
                </th>
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {
                accounts.length === 0 ? (
                  <tr>
                    <td colspan="7" class="px-6 py-8 text-center">
                      <p class="text-muted-foreground text-sm">
                        {page.empty}
                      </p>
                    </td>
                  </tr>
                ) : (
                  accounts.map(account => (
                    <tr class="hover:bg-muted/50 transition-colors">
                      <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                        {account.id}
                      </td>
                      <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm font-medium">
                        <a
                          href={`https://peakd.com/@${account.username}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary flex items-center gap-1 hover:underline"
                        >
                          @{account.username}
                          <svg
                            class="h-3 w-3"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                          </svg>
                        </a>
                      </td>
                      <td class="whitespace-nowrap px-6 py-4 text-sm">
                        {(() => {
                          const label = toAccountStatusLabel(
                            account.blockchain_status
                          )
                          const badgeClass =
                            label === 'SIMULATED'
                              ? 'bg-amber-500/15 text-amber-200'
                              : label === 'BROADCASTED'
                                ? 'bg-sky-500/15 text-sky-200'
                                : label === 'FAILED'
                                  ? 'bg-red-500/15 text-red-200'
                                  : 'bg-emerald-500/15 text-emerald-200'
                          const statusText =
                            label === 'SIMULATED'
                              ? copy.states.account.simulated
                              : label === 'BROADCASTED'
                                ? copy.states.account.broadcasted
                                : label === 'FAILED'
                                  ? copy.states.account.failed
                                  : label === 'CONFIRMED'
                                    ? copy.states.account.confirmed
                                    : label
                          return (
                            <span
                              class:list={[
                                'rounded-full px-2 py-0.5 text-xs font-medium',
                                badgeClass,
                              ]}
                            >
                              {statusText}
                            </span>
                          )
                        })()}
                      </td>
                      <td class="text-foreground whitespace-nowrap px-6 py-4 font-mono text-sm">
                        <a
                          href={`/management/accounts?ticket=${encodeURIComponent(account.ticket)}`}
                          class="text-primary hover:underline"
                        >
                          {account.ticket}
                        </a>
                      </td>
                      <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                        {formatDateTime(account.creation_date, locale)}
                      </td>
                      <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                        {account.builder_username || page.unassigned}
                      </td>
                      <td class="whitespace-nowrap px-6 py-4 text-sm">
                        <a
                          href={`https://hivescan.io/@${account.username}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary hover:text-primary/80 text-sm transition-colors"
                        >
                          {page.viewScan}
                        </a>
                      </td>
                    </tr>
                  ))
                )
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Información adicional -->
      <div class="bg-card border-border mt-6 rounded-lg border p-4">
        <div class="flex items-start gap-2">
          <svg
            class="text-primary h-5 w-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <div class="text-muted-foreground text-sm">
            <p class="font-medium">{page.infoTitle}</p>
            <ul class="mt-2 list-inside list-disc space-y-1">
              <li>{page.infoPeakd}</li>
              <li>{page.infoTicket}</li>
              <li>{page.infoFilters}</li>
              <li>{page.infoScan}</li>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </div>
</ManagementLayout>
