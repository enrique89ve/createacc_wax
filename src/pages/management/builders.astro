---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { formatDate } from '@/utils/date-formatters'
import {
  usersRepository,
  type BuilderWithStats,
} from '@/lib/repositories/users-repository'
import { UserRole } from '@/lib/roles'
import { signUserId } from '@/lib/user-id-token'

// Get session data from middleware
const session = Astro.locals.adminUser

if (!session) {
  return Astro.redirect('/management/access')
}

// Verificar que sea admin (solo admins pueden gestionar builders)
if (session.role !== UserRole.Admin) {
  return Astro.redirect('/management/console')
}

// Obtener builders con estadísticas
let builders: BuilderWithStats[] = []

try {
  builders = await usersRepository.getBuildersWithStats()
} catch (_error) {
	// Non-critical: page renders with empty builders list as fallback
}
---

<ManagementLayout title="Gestión de Builders" activeTab="builders">
  <!-- Header Section -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h2 class="text-foreground text-2xl font-bold">Gestión de Builders</h2>
      <p class="text-muted-foreground mt-1">
        Asigna créditos a usuarios de Hive para crear cuentas
      </p>
    </div>
    <button
      id="assign-credits-btn"
      class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-4 py-2 text-sm font-semibold transition-colors"
    >
      💳 Asignar Créditos
    </button>
  </div>

  <!-- Builders Table -->
  <div class="bg-card border-border overflow-hidden rounded-lg border">
    <div class="border-border border-b px-6 py-4">
      <h3 class="text-foreground text-lg font-semibold">Usuarios Builders</h3>
    </div>

    {
      builders.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="divide-border w-full divide-y">
            <thead class="bg-muted/50">
              <tr>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Usuario Hive
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Estado
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Créditos Disponibles
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Créditos Pendientes
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Tickets Creados
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Último Claim
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Fecha Creación
                </th>
                <th class="text-muted-foreground px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody class="bg-background divide-border divide-y">
              {builders.map(builder => (
                <tr
                  class={`hover:bg-muted/20 ${!builder.is_active ? 'opacity-60' : ''}`}
                >
                  <td class="whitespace-nowrap px-6 py-4">
                    <div class="text-foreground text-sm font-medium">
                      @{builder.hive_username}
                      {!builder.is_active && (
                        <span class="ml-2 text-xs text-red-500">(Baneado)</span>
                      )}
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span
                      class={`inline-flex rounded-full px-2 py-1 text-xs font-medium ${
                        builder.is_active
                          ? 'bg-green-100 text-green-800'
                          : 'bg-red-100 text-red-800'
                      }`}
                    >
                      {builder.is_active ? 'Activo' : 'Baneado'}
                    </span>
                  </td>
                  <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                    <span class="font-semibold text-green-600">
                      {builder.available_credits}
                    </span>
                  </td>
                  <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                    <span class="font-medium text-yellow-600">
                      {builder.pending_credits}
                    </span>
                  </td>
                  <td class="text-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {builder.tickets_created}
                  </td>
                  <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {builder.last_claim_at
                      ? formatDate(builder.last_claim_at)
                      : 'Nunca'}
                  </td>
                  <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                    {formatDate(builder.created_at)}
                  </td>
                  <td class="text-muted-foreground whitespace-nowrap px-6 py-4 text-sm">
                    <div class="flex gap-2">
                      {builder.is_active ? (
                        <>
                          <button
                            class="text-primary hover:text-primary/80 text-sm font-medium"
                            data-action="assign-credits"
                            data-username={builder.hive_username}
                            title="Asignar más créditos"
                          >
                            💳 Asignar
                          </button>
                          <button
                            class="text-sm font-medium text-blue-600 hover:text-blue-500"
                            data-action="edit-credits"
                            data-username={builder.hive_username}
                            data-available={builder.available_credits}
                            data-pending={builder.pending_credits}
                            title="Editar créditos"
                          >
                            ✏️ Editar
                          </button>
                          <button
                            class="text-destructive hover:text-destructive/80 text-sm font-medium"
                            data-action="ban-builder"
                            data-builder-id={signUserId(builder.id)}
                            data-username={builder.hive_username}
                            title="Banear builder"
                          >
                            🚫 Banear
                          </button>
                        </>
                      ) : (
                        <button
                          class="text-sm font-medium text-green-600 hover:text-green-500"
                          data-action="reactivate-builder"
                          data-builder-id={signUserId(builder.id)}
                          data-username={builder.hive_username}
                          title="Reactivar builder"
                        >
                          ✅ Reactivar
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="p-8 text-center">
          <div class="text-muted-foreground mb-4 text-6xl">👷</div>
          <p class="text-foreground mb-2 text-lg font-medium">
            No hay builders aún
          </p>
          <p class="text-muted-foreground">
            Asigna créditos a un usuario de Hive para comenzar
          </p>
        </div>
      )
    }
  </div>

  <!-- Assign Credits Modal -->
  <div
    id="assign-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="text-foreground mb-4 text-lg font-semibold">
        Asignar Créditos a Builder
      </h3>

      <form id="assign-form" class="space-y-4">
        <div>
          <label
            for="builder-username"
            class="text-foreground mb-1 block text-sm font-medium"
          >
            Usuario de Hive
          </label>
          <input
            id="builder-username"
            type="text"
            minlength="3"
            maxlength="20"
            placeholder="username"
            required
            class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <p class="text-muted-foreground mt-1 text-xs">
            Si el usuario no existe, se creará automáticamente como builder
          </p>
        </div>

        <div>
          <label
            for="credits-amount"
            class="text-foreground mb-1 block text-sm font-medium"
          >
            Cantidad de Créditos
          </label>
          <input
            id="credits-amount"
            type="number"
            min="1"
            max="100"
            value="10"
            placeholder="10"
            required
            class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <p class="text-muted-foreground mt-1 text-xs">
            Máximo 100 créditos por asignación
          </p>
        </div>

        <div class="bg-muted/50 rounded-lg p-3">
          <h4 class="text-foreground mb-2 text-sm font-medium">
            ℹ️ ¿Cómo funciona?
          </h4>
          <ul class="text-muted-foreground space-y-1 text-xs">
            <li>• Los créditos se asignan como "Pendientes"</li>
            <li>
              • Si el usuario no existe, se crea automáticamente como builder
            </li>
            <li>
              • El builder debe autenticarse con Keychain para reclamarlos
            </li>
            <li>• Después del claim, puede crear tickets y cuentas</li>
            <li>• 1 crédito = 1 cuenta de Hive que puede crear</li>
          </ul>
        </div>

        <div id="assign-error" class="text-destructive hidden text-sm"></div>

        <div class="flex gap-3 pt-4">
          <button
            type="button"
            id="cancel-btn"
            class="bg-muted hover:bg-muted/80 text-foreground flex-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="submit-btn"
            class="bg-primary text-primary-foreground hover:bg-primary/90 flex-1 rounded-lg px-4 py-2 text-sm font-semibold transition-colors"
          >
            Asignar Créditos
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Success Modal -->
  <div
    id="success-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="text-foreground mb-4 text-lg font-semibold">
        ✅ Créditos Asignados Exitosamente
      </h3>

      <div class="space-y-4">
        <div>
          <label class="text-foreground mb-1 block text-sm font-medium">
            Usuario:
          </label>
          <div
            class="bg-background border-border text-foreground rounded-lg border px-3 py-2 text-sm"
          >
            @<span id="success-username"></span>
          </div>
        </div>

        <div>
          <label class="text-foreground mb-1 block text-sm font-medium">
            Créditos Asignados:
          </label>
          <div
            class="bg-background border-border rounded-lg border px-3 py-2 text-sm font-semibold text-green-600"
          >
            <span id="success-amount"></span> créditos
          </div>
        </div>

        <div class="rounded-lg border border-green-200 bg-green-50 p-3">
          <p class="text-sm text-green-800">
            ✅ <strong>Créditos asignados correctamente.</strong> El usuario @<span
              id="success-username-repeat"></span> debe autenticarse con Keychain
            para reclamarlos.
          </p>
        </div>

        <button
          id="success-close-btn"
          class="bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-lg px-4 py-2 text-sm font-semibold transition-colors"
        >
          Entendido
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Credits Modal -->
  <div
    id="edit-modal"
    class="group fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
    data-has-pending="true"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="text-foreground mb-4 text-lg font-semibold">
        ✏️ Editar Créditos - @<span id="edit-username-display"></span>
      </h3>

      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-username" />

        <div>
          <label
            for="edit-available-credits"
            class="text-foreground mb-1 block text-sm font-medium"
          >
            Créditos Disponibles
          </label>
          <input
            id="edit-available-credits"
            type="number"
            min="0"
            max="100000"
            required
            class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <p class="text-muted-foreground mt-1 text-xs">
            Créditos que el builder puede usar para crear tickets
          </p>
        </div>

        <div
          id="pending-credits-container"
          class="group-data-[has-pending=false]:hidden"
        >
          <label
            for="edit-pending-credits"
            class="text-foreground mb-1 block text-sm font-medium"
          >
            Créditos Pendientes
          </label>
          <input
            id="edit-pending-credits"
            type="number"
            min="0"
            max="100000"
            required
            class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
          <p class="text-muted-foreground mt-1 text-xs">
            Créditos que el builder debe reclamar con Keychain
          </p>
        </div>

        <div>
          <label
            for="edit-reason"
            class="text-foreground mb-1 block text-sm font-medium"
          >
            Razón del ajuste (opcional)
          </label>
          <input
            id="edit-reason"
            type="text"
            placeholder="Ej: Corrección de error"
            class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2"
          />
        </div>

        <div class="bg-muted/50 rounded-lg p-3">
          <p class="text-muted-foreground text-xs">
            ⚠️ Los cambios se registrarán en el historial de auditoría
          </p>
        </div>

        <div id="edit-error" class="text-destructive hidden text-sm"></div>

        <div class="flex gap-3 pt-4">
          <button
            type="button"
            id="edit-cancel-btn"
            class="bg-muted hover:bg-muted/80 text-foreground flex-1 rounded-lg px-4 py-2 text-sm font-medium transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="edit-submit-btn"
            class="flex-1 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
          >
            💾 Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</ManagementLayout>

<script src="@/scripts/management/builders.ts"></script>
