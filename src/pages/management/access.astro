---
import Base from '@/layouts/Base.astro'
import Toasts from '@/components/ui/Toasts.astro'
import { PAGE_TITLES, TITLE_SUFFIXES } from '@/consts/seo'
import { BRAND } from '@/consts/branding'

// Check if user is already authenticated (handled by middleware)
// If authenticated, middleware will redirect to console
// If not, this page will be shown

const pageTitle = `${PAGE_TITLES.MANAGEMENT_LOGIN} - ${TITLE_SUFFIXES.MANAGEMENT}`
---

<Base title={pageTitle} noindex={true} enhancedSecurity={true}>
  <main class="flex min-h-screen items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Card de Login -->
      <div
        class="bg-card/95 supports-[backdrop-filter]:bg-card/90 border-border rounded-lg border p-8 shadow-lg backdrop-blur"
      >
        <div class="mb-8 text-center">
          <h1 class="text-foreground mb-2 text-3xl font-bold tracking-tight">
            Gestión {BRAND.NAME}
          </h1>
          <p class="text-muted-foreground text-sm">
            Acceso para administradores y referrers
          </p>
        </div>

        <form id="login-form" class="space-y-6" autocomplete="off">
          <div class="space-y-2">
            <label
              for="username"
              class="text-foreground block text-sm font-medium"
            >
              Usuario
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              maxlength="50"
              minlength="3"
              pattern="[^<>\{\};\(\)]+"
              title="Por favor, no incluyas caracteres especiales de código como < > { } ; ( )"
              placeholder="Ingresa tu usuario"
              aria-describedby="username-hint"
              class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <div class="space-y-2">
            <label
              for="password"
              class="text-foreground block text-sm font-medium"
            >
              Contraseña
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              minlength="8"
              placeholder="Ingresa tu contraseña"
              aria-describedby="error-message"
              class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <!-- Error Message -->
          <div
            id="error-message"
            role="alert"
            aria-live="polite"
            class="text-primary hidden text-sm font-medium"
          >
          </div>

          <button
            id="login-button"
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/90 focus:ring-primary/40 w-full rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Iniciar Sesión
          </button>
        </form>

        <div class="mt-8 text-center">
          <p class="text-muted-foreground text-xs">
            Sistema de gestión {BRAND.NAME}
          </p>
        </div>
      </div>
    </div>
  </main>

  <Toasts />
</Base>

<script>
  import '@/lib/admin_ui/access-login'
</script>
