---
import Base from '@/layouts/Base.astro'
import Toasts from '@/components/ui/Toasts.astro'
import { TITLE_SUFFIXES } from '@/consts/seo'
import { BRAND } from '@/consts/branding'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'

const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const login = copy.auth.management

// Check if user is already authenticated (handled by middleware)
// If authenticated, middleware will redirect to console
// If not, this page will be shown

const pageTitle = `${interpolate(login.title, { brand: BRAND.NAME })} - ${TITLE_SUFFIXES.MANAGEMENT}`
---

<Base title={pageTitle} noindex enhancedSecurity>
  <main class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-12">
    <div class="w-full min-w-0">
      <!-- Card de Login -->
      <div
        class="bg-card/95 supports-[backdrop-filter]:bg-card/90 border-border rounded-lg border p-8 shadow-lg backdrop-blur"
      >
        <div class="mb-8 text-center">
          <h1 class="text-foreground mb-2 text-balance text-3xl font-bold tracking-tight">
            {interpolate(login.title, { brand: BRAND.NAME })}
          </h1>
          <p class="text-muted-foreground text-sm">
            {login.subtitle}
          </p>
        </div>

        <form id="login-form" class="space-y-6" autocomplete="off">
          <div class="space-y-2">
            <label
              for="username"
              class="text-foreground block text-sm font-medium"
            >
              {login.username}
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              maxlength="50"
              minlength="3"
              pattern="[^<>\{\};\(\)]+"
              title={login.usernameTitle}
              placeholder={login.usernamePlaceholder}
              aria-describedby="username-hint"
              class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full min-w-0 rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <div class="space-y-2">
            <label
              for="password"
              class="text-foreground block text-sm font-medium"
            >
              {login.password}
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              minlength="8"
              placeholder={login.passwordPlaceholder}
              aria-describedby="error-message"
              class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full min-w-0 rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <!-- Error Message -->
          <div
            id="error-message"
            role="alert"
            aria-live="polite"
            class="text-primary hidden text-sm font-medium"
          >
          </div>

          <button
            id="login-button"
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/90 focus:ring-primary/40 w-full rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {login.submit}
          </button>
        </form>

        <div class="mt-8 text-center">
          <p class="text-muted-foreground text-xs">
            {interpolate(login.footer, { brand: BRAND.NAME })}
          </p>
        </div>
      </div>
    </div>
  </main>

  <Toasts />
</Base>

<script>
  import '@/lib/admin_ui/access-login'
</script>
