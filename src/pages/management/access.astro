---
import Layout from '@/layouts/Layout.astro'

// Check if user is already authenticated (handled by middleware)
// If authenticated, middleware will redirect to console
// If not, this page will be shown
---

<Layout title="Acceso de Gestión - HolaHive">
  <main class="flex min-h-screen items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Card de Login -->
      <div
        class="bg-card/95 supports-[backdrop-filter]:bg-card/90 border-border rounded-lg border p-8 shadow-lg backdrop-blur"
      >
        <div class="mb-8 text-center">
          <h1 class="mb-2 text-3xl font-bold tracking-tight text-white">
            Gestión HolaHive
          </h1>
          <p class="text-muted-foreground text-sm">
            Acceso para administradores y referrers
          </p>
        </div>

        <form id="login-form" class="space-y-6" autocomplete="off">
          <!-- Usuario -->
          <div class="space-y-2">
            <label
              for="username"
              class="text-foreground block text-sm font-medium"
            >
              Usuario
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              maxlength="20"
              minlength="3"
              pattern="[a-zA-Z0-9_-]{3,20}"
              placeholder="Ingresa tu usuario"
              aria-describedby="username-hint"
              class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <!-- Contraseña -->
          <div class="space-y-2">
            <label
              for="password"
              class="text-foreground block text-sm font-medium"
            >
              Contraseña
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              minlength="8"
              placeholder="Ingresa tu contraseña"
              aria-describedby="error-message"
              class="bg-background border-border text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>

          <!-- Error Message -->
          <div
            id="error-message"
            role="alert"
            aria-live="polite"
            class="text-primary hidden text-sm font-medium"
          >
          </div>

          <!-- Botón de Login -->
          <button
            id="login-button"
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/90 focus:ring-primary/40 w-full rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Iniciar Sesión
          </button>
        </form>

        <!-- Footer -->
        <div class="mt-8 text-center">
          <p class="text-muted-foreground text-xs">
            Sistema de gestión HolaHive
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#login-form')!
  const usernameInput = document.querySelector<HTMLInputElement>('#username')!
  const passwordInput = document.querySelector<HTMLInputElement>('#password')!
  const loginButton =
    document.querySelector<HTMLButtonElement>('#login-button')!
  const errorMessage = document.querySelector<HTMLElement>('#error-message')!

  // Security: Rate limiting configuration
  const MAX_LOGIN_ATTEMPTS = 5
  const LOCKOUT_DURATION = 15 * 60 * 1000 // 15 minutes
  const ATTEMPT_WINDOW = 5 * 60 * 1000 // 5 minutes

  interface LoginAttempt {
    count: number
    firstAttempt: number
    lockedUntil?: number
  }

  function getAttempts(): LoginAttempt {
    const stored = localStorage.getItem('login_attempts')
    if (!stored) return { count: 0, firstAttempt: Date.now() }
    return JSON.parse(stored)
  }

  function saveAttempts(attempts: LoginAttempt): void {
    localStorage.setItem('login_attempts', JSON.stringify(attempts))
  }

  function resetAttempts(): void {
    localStorage.removeItem('login_attempts')
  }

  function checkRateLimit(): boolean {
    const attempts = getAttempts()
    const now = Date.now()

    // Check if account is locked
    if (attempts.lockedUntil && now < attempts.lockedUntil) {
      const remainingMinutes = Math.ceil((attempts.lockedUntil - now) / 60000)

      return false
    }

    // Reset attempts if window expired
    if (now - attempts.firstAttempt > ATTEMPT_WINDOW) {
      resetAttempts()
      return true
    }

    // Check if max attempts reached
    if (attempts.count >= MAX_LOGIN_ATTEMPTS) {
      const lockUntil = now + LOCKOUT_DURATION
      saveAttempts({ ...attempts, lockedUntil: lockUntil })
      showError(
        'Demasiados intentos fallidos. Cuenta bloqueada temporalmente por 15 minutos.'
      )
      return false
    }

    return true
  }

  function recordFailedAttempt(): void {
    const attempts = getAttempts()
    const now = Date.now()

    // Reset if outside attempt window
    if (now - attempts.firstAttempt > ATTEMPT_WINDOW) {
      saveAttempts({ count: 1, firstAttempt: now })
    } else {
      saveAttempts({
        ...attempts,
        count: attempts.count + 1,
      })
    }
  }

  function showError(message: string): void {
    errorMessage.textContent = message
    errorMessage.classList.remove('hidden')
  }

  function hideError(): void {
    errorMessage.classList.add('hidden')
  }

  function setLoading(loading: boolean): void {
    if (loading) {
      loginButton.disabled = true
      loginButton.textContent = 'Iniciando sesión...'
      usernameInput.disabled = true
      passwordInput.disabled = true
    } else {
      loginButton.disabled = false
      loginButton.textContent = 'Iniciar Sesión'
      usernameInput.disabled = false
      passwordInput.disabled = false
    }
  }

  // Security: Input validation
  function validateUsername(username: string): boolean {
    // Allow alphanumeric, underscores, hyphens (3-20 chars)
    const usernameRegex = /^[a-zA-Z0-9_-]{3,20}$/
    return usernameRegex.test(username)
  }

  function validatePassword(password: string): boolean {
    // Minimum 8 characters
    return password.length >= 8
  }

  form.addEventListener('submit', async e => {
    e.preventDefault()

    const username = usernameInput.value.trim()
    const password = passwordInput.value

    // Basic validation
    if (!username || !password) {
      showError('Por favor ingresa usuario y contraseña')
      return
    }

    // Validate username format
    if (!validateUsername(username)) {
      showError('Usuario inválido. Usa 3-20 caracteres alfanuméricos.')
      return
    }

    // Validate password length
    if (!validatePassword(password)) {
      showError('La contraseña debe tener al menos 8 caracteres')
      return
    }

    // Check rate limiting
    if (!checkRateLimit()) {
      return
    }

    hideError()
    setLoading(true)

    try {
      // Get CSRF token first
      const csrfResponse = await fetch('/api/auth/csrf')
      const csrfData = await csrfResponse.json()
      const csrfToken = csrfData.csrfToken

      // Use Auth.js callback route with provider ID (same pattern as builders login)
      const response = await fetch(
        '/api/auth/callback/management-credentials',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({
            username,
            password,
            csrfToken,
            callbackUrl: '/management/console',
          }),
        }
      )

      // Check if authentication was successful
      // Auth.js redirects to error page or callback URL based on success/failure
      const responseUrl = response.url
      const isRedirectToBuilders =
        responseUrl && responseUrl.includes('/builders')

      if (response.ok && !isRedirectToBuilders) {
        // Login successful - reset attempts and redirect
        resetAttempts()

        // Security: Small delay before redirect to prevent timing attacks
        await new Promise(resolve => setTimeout(resolve, 100))

        window.location.href = '/management/console'
      } else {
        // Login failed - record attempt
        recordFailedAttempt()

        const attempts = getAttempts()
        const remainingAttempts = MAX_LOGIN_ATTEMPTS - attempts.count

        if (remainingAttempts > 0 && remainingAttempts <= 2) {
          showError(
            `Credenciales inválidas. Te quedan ${remainingAttempts} intento(s).`
          )
      
        } else {
          showError('Credenciales inválidas')
        }
      }
    } catch (error) {
      showError('Error de conexión. Inténtalo de nuevo.')
    } finally {
      setLoading(false)
    }
  })

  // Security: Clear password on page unload
  window.addEventListener('beforeunload', () => {
    passwordInput.value = ''
  })

  // Security: Prevent password autocomplete timing attacks
  passwordInput.addEventListener('focus', () => {
    // Clear any lingering error messages when focusing password field
    if (errorMessage.textContent.includes('intento')) {
      hideError()
    }
  })

  // Focus en el campo de usuario al cargar
  usernameInput.focus()
</script>
