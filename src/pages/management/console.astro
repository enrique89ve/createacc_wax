---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'
import { formatDate } from '@/utils/date-formatters'
import { dashboardService } from '@/lib/repositories/dashboard-service'
import type {
  RecentTicketInfo,
  RecentAccountInfo,
} from '@/lib/repositories/dashboard-service'

// Get session data from middleware
const session = Astro.locals.adminUser
const locale = Astro.locals.locale ?? DEFAULT_LOCALE
const copy =
  Astro.locals.messages ?? getMessages(locale)
const page = copy.admin.console
const ticketState = copy.states.ticket

if (!session) {
  return Astro.redirect('/management/access')
}

// Obtener todas las estadísticas y datos del dashboard
let stats = {
  totalBuilders: 0,
  totalTickets: 0,
  usedTickets: 0,
  totalAccounts: 0,
  todayAccounts: 0,
}
let recentTickets: RecentTicketInfo[] = []
let recentAccounts: RecentAccountInfo[] = []

try {
  const summary = await dashboardService.getSystemActivitySummary(5)
  stats = summary.stats
  recentTickets = summary.recentTickets
  recentAccounts = summary.recentAccounts
} catch (_error) {
  // Non-critical: dashboard renders with default zero stats as fallback
}
---

<ManagementLayout title={page.title} activeTab="dashboard">
  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Stats Cards -->
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Total Builders -->
      <a
        href="/management/builders"
        class="bg-card border-border hover:border-primary block rounded-lg border p-6 transition-colors"
      >
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">{page.totalBuilders}</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalBuilders}
            </p>
          </div>
          <div class="text-primary">👥</div>
        </div>
      </a>

      <!-- Total Tickets -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">{page.totalTickets}</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalTickets}
            </p>
            <p class="text-muted-foreground text-xs">
              {interpolate(page.used, { count: String(stats.usedTickets) })}
            </p>
          </div>
          <div class="text-primary">🎫</div>
        </div>
      </div>

      <!-- Cuentas Creadas -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">{page.hiveAccounts}</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalAccounts}
            </p>
            <p class="text-muted-foreground text-xs">{page.totalCreated}</p>
          </div>
          <div class="text-primary">🔗</div>
        </div>
      </div>

      <!-- Hoy -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">{page.today}</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.todayAccounts}
            </p>
            <p class="text-muted-foreground text-xs">{page.newAccounts}</p>
          </div>
          <div class="text-primary">📅</div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Recent Tickets -->
      <div class="bg-card border-border rounded-lg border">
        <div class="border-border border-b p-6">
          <h3 class="text-foreground text-lg font-semibold">
            {page.recentTickets}
          </h3>
        </div>
        <div class="p-6">
          {
            recentTickets.length > 0 ? (
              <div class="space-y-4">
                {recentTickets.map(ticket => (
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <p class="text-foreground text-sm font-medium">
                        {ticket.code}
                      </p>
                      <p class="text-muted-foreground text-xs">
                        {interpolate(page.by, {
                          user: ticket.created_by_username,
                          type: ticket.creator_type ?? 'manual',
                          remaining: String(ticket.remaining_uses),
                          total: String(ticket.total_uses),
                        })}
                      </p>
                    </div>
                    <div class="text-right">
                      <span
                        class={`inline-flex rounded-full px-2 py-1 text-xs font-medium ${
                          !ticket.is_active
                            ? 'bg-red-100 text-red-800'
                            : ticket.has_been_used
                              ? 'bg-green-100 text-green-800'
                              : 'bg-yellow-100 text-yellow-800'
                        }`}
                      >
                        {!ticket.is_active
                          ? ticketState.noCredits
                          : ticket.has_been_used
                            ? ticketState.inUse
                            : ticketState.available}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground text-sm">
                {page.noRecentTickets}
              </p>
            )
          }
        </div>
      </div>

      <!-- Recent Accounts -->
      <div class="bg-card border-border rounded-lg border">
        <div class="border-border border-b p-6">
          <h3 class="text-foreground text-lg font-semibold">
            {page.recentAccounts}
          </h3>
        </div>
        <div class="p-6">
          {
            recentAccounts.length > 0 ? (
              <div class="space-y-4">
                {recentAccounts.map(account => (
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <p class="text-foreground text-sm font-medium">
                        @{account.username}
                      </p>
                      <p class="text-muted-foreground text-xs">
                        {interpolate(page.ticket, { ticket: account.ticket })}
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="text-muted-foreground text-xs">
                        {formatDate(account.creation_date, locale)}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground text-sm">
                {page.noRecentAccounts}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</ManagementLayout>
