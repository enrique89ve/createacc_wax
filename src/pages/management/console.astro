---
import ManagementLayout from '@/layouts/ManagementLayout.astro'
import { formatDate } from '@/utils/date-formatters'
import { dashboardService } from '@/lib/repositories/dashboard-service'
import type {
  RecentTicketInfo,
  RecentAccountInfo,
} from '@/lib/repositories/dashboard-service'

// Get session data from middleware
const session = Astro.locals.adminUser

if (!session) {
  return Astro.redirect('/management/access')
}

// Obtener todas las estadísticas y datos del dashboard
let stats = {
  totalBuilders: 0,
  totalTickets: 0,
  usedTickets: 0,
  totalAccounts: 0,
  todayAccounts: 0,
}
let recentTickets: RecentTicketInfo[] = []
let recentAccounts: RecentAccountInfo[] = []

try {
  const summary = await dashboardService.getSystemActivitySummary(5)
  stats = summary.stats
  recentTickets = summary.recentTickets
  recentAccounts = summary.recentAccounts
} catch (_error) {
  // Non-critical: dashboard renders with default zero stats as fallback
}
---

<ManagementLayout title="Console de Gestión - HolaHive" activeTab="dashboard">
  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Stats Cards -->
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Total Builders -->
      <a
        href="/management/builders"
        class="bg-card border-border hover:border-primary block rounded-lg border p-6 transition-colors"
      >
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">Total Builders</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalBuilders}
            </p>
          </div>
          <div class="text-primary">👥</div>
        </div>
      </a>

      <!-- Total Tickets -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">Total Tickets</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalTickets}
            </p>
            <p class="text-muted-foreground text-xs">
              {stats.usedTickets} usados
            </p>
          </div>
          <div class="text-primary">🎫</div>
        </div>
      </div>

      <!-- Cuentas Creadas -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">Cuentas Hive</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.totalAccounts}
            </p>
            <p class="text-muted-foreground text-xs">Total creadas</p>
          </div>
          <div class="text-primary">🔗</div>
        </div>
      </div>

      <!-- Hoy -->
      <div class="bg-card border-border rounded-lg border p-6">
        <div class="flex items-center">
          <div class="flex-1">
            <p class="text-muted-foreground text-sm">Hoy</p>
            <p class="text-foreground text-2xl font-bold">
              {stats.todayAccounts}
            </p>
            <p class="text-muted-foreground text-xs">Nuevas cuentas</p>
          </div>
          <div class="text-primary">📅</div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Recent Tickets -->
      <div class="bg-card border-border rounded-lg border">
        <div class="border-border border-b p-6">
          <h3 class="text-foreground text-lg font-semibold">
            Tickets Recientes
          </h3>
        </div>
        <div class="p-6">
          {
            recentTickets.length > 0 ? (
              <div class="space-y-4">
                {recentTickets.map(ticket => (
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <p class="text-foreground text-sm font-medium">
                        {ticket.code}
                      </p>
                      <p class="text-muted-foreground text-xs">
                        Por {ticket.created_by_username} •{' '}
                        {ticket.creator_type ?? 'manual'} • {ticket.credits}/
                        {ticket.original_credits} créditos
                      </p>
                    </div>
                    <div class="text-right">
                      <span
                        class={`inline-flex rounded-full px-2 py-1 text-xs font-medium ${
                          !ticket.is_active
                            ? 'bg-red-100 text-red-800'
                            : ticket.has_been_used
                              ? 'bg-green-100 text-green-800'
                              : 'bg-yellow-100 text-yellow-800'
                        }`}
                      >
                        {!ticket.is_active
                          ? 'Sin créditos'
                          : ticket.has_been_used
                            ? 'En uso'
                            : 'Disponible'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground text-sm">
                No hay tickets recientes
              </p>
            )
          }
        </div>
      </div>

      <!-- Recent Accounts -->
      <div class="bg-card border-border rounded-lg border">
        <div class="border-border border-b p-6">
          <h3 class="text-foreground text-lg font-semibold">
            Cuentas Recientes
          </h3>
        </div>
        <div class="p-6">
          {
            recentAccounts.length > 0 ? (
              <div class="space-y-4">
                {recentAccounts.map(account => (
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <p class="text-foreground text-sm font-medium">
                        @{account.username}
                      </p>
                      <p class="text-muted-foreground text-xs">
                        Ticket: {account.ticket}
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="text-muted-foreground text-xs">
                        {formatDate(account.creation_date)}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground text-sm">
                No hay cuentas recientes
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</ManagementLayout>
