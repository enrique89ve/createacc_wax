---
import Form from '@/components/Form.astro'
import Layout from '@/layouts/Layout.astro'
import CreationStepper from '@/components/ui/CreationStepper.astro'

const rawTicket = Astro.url.searchParams.get('ticket') ?? ''

function normalizeTicket(raw: string): string {
  if (!raw) return ''
  return raw
    .trim()
    .replace(/[^a-zA-Z0-9]/g, '')
    .slice(0, 24)
    .toUpperCase()
}

const ticketParam = normalizeTicket(rawTicket)
---

<Layout>
  <div class="pt-6">
    <CreationStepper />
  </div>
  <div class="mt-10">
    <Form ticket={ticketParam} />
  </div>
</Layout>
