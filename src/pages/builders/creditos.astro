---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import StatCard from '@/components/ui/StatCard.astro'
import { formatDateTime } from '@/utils/date-formatters'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { creditBalanceTracker } from '@/lib/credit-balance-tracker'
import { creditsService } from '@/lib/credits-service'
import { UserRole } from '@/lib/roles'

// Autenticación centralizada - si no está autenticado, se redirige automáticamente
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Asegurar que tenemos un BuilderUser
if (!currentUser || currentUser.role !== UserRole.Builder) {
  return Astro.redirect('/builders/login')
}

const builderUsername = currentUser.username

// Obtener información de créditos usando service
let builderCredits = {
  pending: 0,
  claimed: 0,
  consumed: 0,
  builder_id: null as number | null,
}

let creditHistory: Array<{
  readonly id: number
  readonly operation: string
  readonly amount: number
  readonly reason: string | null
  readonly timestamp: string
  readonly performed_by: number | null
}> = []

try {
  const credits = await creditBalanceTracker.getBalance(builderUsername)

  if (credits) {
    builderCredits = {
      pending: credits.pending_amount,
      claimed: credits.available_amount,
      consumed: credits.total_consumed,
      builder_id: credits.builder_id,
    }

    creditHistory = await creditsService.getCreditHistory(credits.builder_id)
  }
} catch (_error) {
	// Non-critical: page renders with default zero credits as fallback
}

// Calcular estadísticas
const creditosPendientes = builderCredits.pending
const creditosDisponibles = builderCredits.claimed // available_amount = créditos disponibles para crear tickets
const creditosConsumidos = builderCredits.consumed // total_consumed = cuentas creadas
---

<BuildersLayout title="Créditos" currentPage="creditos">
  <div
    class="mx-auto max-w-7xl space-y-4 px-3 py-4 sm:space-y-6 sm:px-4 sm:py-6 lg:px-8"
  >
    <PageHeader
      title="Gestión de Créditos"
      description="Administra tus créditos, reclama tickets y consulta tu historial."
    />

    <!-- Resumen de Créditos -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Tarjeta 1: Créditos Pendientes con botón -->
      <div class="card-stat group relative">
        <div class="mb-4">
          <p
            class="text-muted-foreground mb-1 text-xs font-medium uppercase tracking-wide"
          >
            Pendientes de reclamar
          </p>
          <div class="flex items-baseline gap-2">
            <span
              class="text-foreground text-4xl font-semibold tabular-nums tracking-tight"
            >
              {creditosPendientes}
            </span>
            <span class="text-muted-foreground text-sm font-medium"
              >créditos</span
            >
          </div>
        </div>

        <p class="text-muted-foreground mb-4 text-xs leading-relaxed">
          Reclamar con Keychain
        </p>

        <!-- Botón integrado - Solo visible si hay créditos pendientes -->
        {
          creditosPendientes > 0 && (
            <>
              <button
                id="claim-credits-btn"
                data-username={builderUsername}
                class="flex w-full items-center justify-center gap-2 rounded-md bg-yellow-500/10 px-4 py-2.5 text-sm font-medium text-yellow-500 ring-1 ring-yellow-500/20 transition-all hover:bg-yellow-500/20 hover:ring-yellow-500/30 disabled:cursor-not-allowed disabled:opacity-50"
              >
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Reclamar ahora
              </button>

              {/* Mensaje de advertencia si Keychain no está disponible */}
              <div
                id="keychain-warning"
                class="mt-2 hidden rounded-md bg-amber-500/10 px-3 py-2 text-xs text-amber-500 ring-1 ring-amber-500/20"
              >
                <span class="font-medium">⚠️ Keychain no detectado.</span> Por
                favor, instala la extensión Hive Keychain y recarga la página.
              </div>
            </>
          )
        }
      </div>

      <!-- Tarjeta 2: Créditos Disponibles -->
      <StatCard
        title="Disponibles para usar"
        value={creditosDisponibles}
        unit="créditos"
        description="Usa estos créditos para crear tickets y cuentas Hive"
      />

      <!-- Tarjeta 3: Créditos Consumidos -->
      <StatCard
        title="Cuentas creadas"
        value={creditosConsumidos}
        unit="total"
        description="Créditos consumidos en la creación de cuentas Hive"
        action={{
          href: '/builders/accounts',
          label: 'Ver cuentas creadas',
        }}
      >
        <svg
          slot="action-icon"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </StatCard>
    </section>

    <!-- Historial de Créditos -->
    <section
      class="border-border bg-card mb-8 overflow-hidden rounded-lg border"
    >
      <div class="border-border flex items-center border-b px-6 py-4">
        <h2
          class="text-foreground flex items-center gap-2 text-lg font-semibold"
        >
          Historial de Créditos
        </h2>
      </div>

      {
        creditHistory.length > 0 ? (
          <>
            {/* Desktop Table (md and up) */}
            <div class="hidden overflow-x-auto md:block">
              <table class="divide-border min-w-full divide-y text-sm">
                <thead class="bg-muted/60">
                  <tr>
                    <th class="text-muted-foreground px-6 py-3 text-left font-medium uppercase tracking-wide">
                      Fecha
                    </th>
                    <th class="text-muted-foreground px-6 py-3 text-left font-medium uppercase tracking-wide">
                      Operación
                    </th>
                    <th class="text-muted-foreground px-6 py-3 text-left font-medium uppercase tracking-wide">
                      Cantidad
                    </th>
                    <th class="text-muted-foreground px-6 py-3 text-left font-medium uppercase tracking-wide">
                      Descripción
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-border divide-y">
                  {creditHistory.map(item => (
                    <tr class="hover:bg-muted/40">
                      <td class="text-muted-foreground px-6 py-3">
                        {formatDateTime(item.timestamp)}
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                            item.operation === 'claim_via_blockchain'
                              ? 'bg-green-500/20 text-green-300'
                              : item.operation === 'assign_credits'
                                ? 'bg-blue-500/20 text-blue-300'
                                : item.operation === 'consume_credits'
                                  ? 'bg-red-500/20 text-red-300'
                                  : item.operation === 'purchase_credits'
                                    ? 'bg-purple-500/20 text-purple-300'
                                    : 'bg-gray-500/20 text-gray-300'
                          }`}
                        >
                          {item.operation === 'claim_via_blockchain'
                            ? 'Reclamado'
                            : item.operation === 'assign_credits'
                              ? 'Asignado'
                              : item.operation === 'consume_credits'
                                ? 'Consumido'
                                : item.operation === 'purchase_credits'
                                  ? 'Comprado'
                                  : item.operation}
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class={`font-semibold ${
                            item.amount > 0 ? 'text-green-400' : 'text-red-400'
                          }`}
                        >
                          {item.amount > 0 ? '+' : ''}
                          {item.amount}
                        </span>
                      </td>
                      <td class="text-muted-foreground px-4 py-3">
                        <div class="text-sm">
                          {item.reason || 'Sin descripción'}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Mobile Cards (below md) */}
            <div class="space-y-3 p-3 md:hidden">
              {creditHistory.map(item => (
                <div class="bg-muted/30 border-border/50 relative overflow-hidden rounded-lg border">
                  {/* Pestaña superior */}
                  <div class="bg-muted/60 border-border/30 border-b px-3 py-2">
                    <div class="flex items-center justify-between">
                      <span
                        class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${
                          item.operation === 'claim_via_blockchain'
                            ? 'bg-green-500/20 text-green-300'
                            : item.operation === 'assign_credits'
                              ? 'bg-blue-500/20 text-blue-300'
                              : item.operation === 'consume_credits'
                                ? 'bg-red-500/20 text-red-300'
                                : item.operation === 'purchase_credits'
                                  ? 'bg-purple-500/20 text-purple-300'
                                  : 'bg-gray-500/20 text-gray-300'
                        }`}
                      >
                        {item.operation === 'claim_via_blockchain'
                          ? 'Reclamado'
                          : item.operation === 'assign_credits'
                            ? 'Asignado'
                            : item.operation === 'consume_credits'
                              ? 'Consumido'
                              : item.operation === 'purchase_credits'
                                ? 'Comprado'
                                : item.operation}
                      </span>
                      <span
                        class={`text-sm font-semibold tabular-nums ${
                          item.amount > 0 ? 'text-green-400' : 'text-red-400'
                        }`}
                      >
                        {item.amount > 0 ? '+' : ''}
                        {item.amount}
                      </span>
                    </div>
                  </div>

                  {/* Contenido */}
                  <div class="space-y-2 p-3">
                    {/* Fecha */}
                    <div class="text-muted-foreground text-xs">
                      {formatDateTime(item.timestamp)}
                    </div>

                    {/* Descripción */}
                    {item.reason && (
                      <div class="text-foreground border-border/30 border-t pt-2 text-sm">
                        {item.reason}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="p-10 text-center">
            <div class="mb-4 text-5xl">📊</div>
            <p class="text-foreground mb-2 font-semibold">
              Sin historial de créditos
            </p>
            <p class="text-muted-foreground text-sm">
              Cuando recibas o uses créditos aparecerán aquí.
            </p>
          </div>
        )
      }
    </section>
  </div>
</BuildersLayout>

<script>
  import { notify } from '@/utils/toast'
  import { BRAND } from '@/consts/branding'

  interface HiveKeychainResponse {
    readonly success: boolean
    readonly message?: string
    readonly result: {
      readonly id: string
    }
  }

  type HiveKeychainWithCustomJson = NonNullable<Window['hive_keychain']> & {
    requestCustomJson: (
      username: string,
      id: string,
      keyType: 'Posting' | 'Active' | 'Memo',
      json: string,
      displayMsg: string,
      callback: (response: HiveKeychainResponse) => void
    ) => void
  }

  const getHiveKeychain = (): HiveKeychainWithCustomJson | null => {
    if (typeof window === 'undefined' || !window.hive_keychain) {
      return null
    }

    return window.hive_keychain as HiveKeychainWithCustomJson
  }

  // Función para esperar a que Keychain esté disponible
  async function waitForKeychain(
    maxAttempts = 10,
    delayMs = 300
  ): Promise<boolean> {
    for (let i = 0; i < maxAttempts; i++) {
      if (getHiveKeychain()) {
        return true
      }
      await new Promise(resolve => setTimeout(resolve, delayMs))
    }
    return false
  }

  function getCurrentUsername() {
    const claimBtn = document.getElementById('claim-credits-btn')
    if (!claimBtn) return null
    return claimBtn.getAttribute('data-username')
  }

  function setupEventListeners() {
    // Reclamar créditos con Keychain
    const claimBtn = document.getElementById(
      'claim-credits-btn'
    ) as HTMLButtonElement | null

    if (claimBtn) {
      // Remover listener anterior si existe para evitar duplicados
      claimBtn.removeEventListener('click', handleClaimCredits)
      claimBtn.addEventListener('click', handleClaimCredits)
    }

    // Verificar disponibilidad de Keychain después de un momento
    setTimeout(checkKeychainAvailability, 1500)
  }

  function checkKeychainAvailability() {
    const warning = document.getElementById('keychain-warning')
    if (!warning) return

    if (!getHiveKeychain()) {
      warning.classList.remove('hidden')
    } else {
      warning.classList.add('hidden')
    }
  }

  // Usar astro:page-load para inicializar en cada navegación (View Transitions)
  document.addEventListener('astro:page-load', () => {
    setupEventListeners()
  })

  async function handleClaimCredits() {
    const claimBtn = document.getElementById(
      'claim-credits-btn'
    ) as HTMLButtonElement | null
    if (!claimBtn) return

    const originalText = claimBtn.textContent

    try {
      // Deshabilitar botón
      claimBtn.disabled = true
      claimBtn.textContent = 'Generando hash...'

      // 1. Solicitar hash de validación al servidor
      const hashResponse = await fetch('/api/builders/credits/claim-hash', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })

      const hashData = await hashResponse.json()

      if (!hashResponse.ok || !hashData.success) {
        // Mostrar solo el toast, sin error en consola
        notify('error', hashData.error || 'Error generando hash de validación')
        return
      }

      claimBtn.textContent = 'Conectando Keychain...'

      // 2. Verificar que Keychain esté disponible (con reintentos)
      const keychainAvailable = await waitForKeychain()
      if (!keychainAvailable) {
        notify(
          'error',
          'Hive Keychain no está instalado o no está disponible. Por favor, instala la extensión y recarga la página.'
        )
        return
      }

      const hiveKeychain = getHiveKeychain()
      if (!hiveKeychain) {
        notify('error', 'Error al acceder a Hive Keychain')
        return
      }

      // 3. Crear custom JSON operation
      const username = getCurrentUsername()
      if (!username) {
        notify('error', 'No se pudo determinar el usuario actual')
        return
      }
      const customJsonData = hashData.customJson

      claimBtn.textContent = 'Firmando operación...'

      // 4. Solicitar firma de custom JSON a Keychain con timeout y manejo de cancelación
      const keyResult: HiveKeychainResponse = await new Promise(resolve => {
        const hiveKeychain = getHiveKeychain()
        if (!hiveKeychain) {
          return resolve({
            success: false,
            message: 'Hive Keychain no disponible',
            result: { id: '' },
          })
        }

        let isResolved = false
        let timeoutId: number | null = null

        // Función para resolver solo una vez
        const resolveOnce = (response: HiveKeychainResponse) => {
          if (isResolved) return
          isResolved = true
          if (timeoutId) clearTimeout(timeoutId)
          resolve(response)
        }

        // Timeout de 60 segundos para la respuesta de Keychain
        timeoutId = window.setTimeout(() => {
          resolveOnce({
            success: false,
            message:
              'Tiempo de espera agotado. Por favor, verifica que respondiste en Keychain.',
            result: { id: '' },
          })
        }, 60000)

        try {
          // Keychain puede llamar al callback con diferentes firmas dependiendo de cómo se cancela
          hiveKeychain.requestCustomJson(
            username,
            customJsonData.id,
            'Posting',
            JSON.stringify(customJsonData.json),
            `Claim Credits - ${BRAND.NAME}`,
            function (response: unknown) {
              // Usar function() en lugar de arrow function para evitar problemas de contexto
              try {
                // Si ya se resolvió, simplemente salir sin hacer nada
                if (isResolved) return

                // Manejar diferentes tipos de respuesta que puede devolver Keychain
                if (!response) {
                  resolveOnce({
                    success: false,
                    message: 'Operación cancelada',
                    result: { id: '' },
                  })
                  return
                }

                // Keychain a veces devuelve una string en lugar de objeto cuando cancela
                if (typeof response === 'string') {
                  resolveOnce({
                    success: false,
                    message: response,
                    result: { id: '' },
                  })
                  return
                }

                // Respuesta normal de Keychain
                if (typeof response === 'object' && 'success' in response) {
                  resolveOnce(response as HiveKeychainResponse)
                } else {
                  resolveOnce({
                    success: false,
                    message: 'Respuesta inválida de Keychain',
                    result: { id: '' },
                  })
                }
              } catch (callbackError) {
                // Capturar cualquier error dentro del callback sin propagarlo
                if (!isResolved) {
                  resolveOnce({
                    success: false,
                    message: 'Error procesando respuesta de Keychain',
                    result: { id: '' },
                  })
                }
              }
            }
          )
        } catch (error) {
          resolveOnce({
            success: false,
            message:
              error instanceof Error
                ? error.message
                : 'Error al comunicar con Keychain',
            result: { id: '' },
          })
        }
      })

      if (!keyResult.success) {
        const message = keyResult.message || 'Error firmando con Keychain'
        // Detectar diferentes tipos de cancelación o timeout
        if (
          message.toLowerCase().includes('cancel') ||
          message.toLowerCase().includes('user cancel') ||
          message.toLowerCase().includes('operación cancelada')
        ) {
          notify('info', 'Operación cancelada por el usuario')
        } else if (
          message.toLowerCase().includes('timeout') ||
          message.toLowerCase().includes('tiempo de espera')
        ) {
          notify('warning', 'Tiempo de espera agotado. Intenta nuevamente.')
        } else {
          notify('error', message)
        }
        return
      }

      const transactionId = keyResult.result.id

      claimBtn.textContent = 'Verificando blockchain...'
      notify('info', 'Verificando transacción en blockchain...')
      // 5. Esperar un momento para que la transacción se propague
      await new Promise(resolve => setTimeout(resolve, 3000))

      // 6. Verificar la transacción en el servidor
      const verifyResponse = await fetch('/api/builders/credits/claim-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          transactionId: transactionId,
          hash: hashData.hash,
        }),
      })

      const verifyData = await verifyResponse.json()

      if (verifyResponse.ok && verifyData.success) {
        notify(
          'success',
          `¡Créditos reclamados! Disponible: ${verifyData.available || 0}, Pendiente: ${verifyData.pending || 0}`
        )

        // Recargar página después de un momento
        setTimeout(() => location.reload(), 3000)
      } else {
        notify('error', verifyData.error || 'Error verificando la transacción')
      }
    } catch (error) {
      notify('error', 'Error de conexión o procesamiento')
    } finally {
      // Restaurar botón
      claimBtn.disabled = false
      claimBtn.textContent = originalText || 'Reclamar con Keychain'
    }
  }
</script>
