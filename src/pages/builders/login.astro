---
/**
 * Página de login para builders usando Keychain
 */
import BuildersLayout from '@/layouts/BuildersLayout.astro'
---

<BuildersLayout title="Login - Builders" currentPage="login">
  <div class="flex min-h-screen items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Login Card -->
      <div class="rounded-lg border border-border bg-card p-8">
        <!-- Header -->
        <div class="mb-8 text-center">
          <h1 class="mb-2 text-3xl font-bold tracking-tight text-foreground">
            Builders Login
          </h1>
          <p class="text-sm text-muted-foreground">
            Acceso exclusivo para moderadores y usuarios autorizados
          </p>
        </div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-6">
          <div class="space-y-2">
            <label
              for="username"
              class="block text-sm font-medium text-foreground"
            >
              Usuario de Hive
            </label>
            <input
              type="text"
              id="username"
              name="username"
              placeholder="tu-usuario-hive"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              class="w-full rounded-lg border border-border bg-muted px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40 disabled:cursor-not-allowed disabled:opacity-50"
              required
            />
          </div>

          <!-- Keychain error (only visible when not available) -->
          <div
            id="keychain-status"
            class="hidden rounded-lg border border-border bg-muted/50 px-4 py-3 text-sm"
          >
          </div>

          <button
            type="submit"
            id="login-btn"
            class="w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary/40 disabled:cursor-not-allowed disabled:opacity-50"
            disabled
          >
            Login con Keychain
          </button>
        </form>

        <!-- Footer: Keychain status as subtle text -->
        <div class="mt-8 text-center">
          <p id="keychain-footer" class="text-xs text-muted-foreground">
            Verificando Keychain...
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { quickLogin, isKeychainReady } from '@/lib/keychain-service'
    import { notify } from '@/utils/toast'

    document.addEventListener('DOMContentLoaded', async () => {
      await initPage()
      setupEventListeners()
    })

    // Inicializar página
    async function initPage() {
      const statusDiv = document.getElementById('keychain-status')!
      const footerText = document.getElementById('keychain-footer')!
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement

      try {
        const isReady = await isKeychainReady()

        if (isReady) {
          // Success: subtle footer text only, no prominent block
          footerText.textContent = 'Keychain detectado'
          footerText.classList.add('text-green-400/60')
          loginBtn.disabled = false
        } else {
          // Error: show visible block + footer
          statusDiv.classList.remove('hidden')
          statusDiv.innerHTML = `
						<div class="text-red-400">
							Hive Keychain no está disponible
							<div class="mt-1 text-muted-foreground">
								<a href="https://hive-keychain.com" target="_blank" class="text-primary underline">
									Instala Hive Keychain
								</a> y recarga la página
							</div>
						</div>
					`
          footerText.textContent = 'Keychain requerido'
          loginBtn.disabled = true
        }
      } catch (error) {
        statusDiv.classList.remove('hidden')
        statusDiv.innerHTML = `
					<span class="text-red-400">Error verificando Keychain</span>
				`
        footerText.textContent = 'Error de conexión'
        loginBtn.disabled = true
      }
    }

    // Setup event listeners
    function setupEventListeners() {
      const form = document.getElementById('login-form') as HTMLFormElement
      form.addEventListener('submit', handleLogin)
    }

    // Manejar login
    async function handleLogin(e: Event) {
      e.preventDefault()

      const form = e.target as HTMLFormElement
      const formData = new FormData(form)
      const username = ((formData.get('username') as string) || '').trim()

      if (!username) {
        notify('error', 'Por favor ingresa tu usuario de Hive')
        return
      }

      // Desactivar botón
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement
      loginBtn.disabled = true
      loginBtn.textContent = 'Conectando con Keychain...'

      try {
        // 1. Login con Keychain
        notify('info', 'Solicitando firma de Keychain...')

        const keychainResult = await quickLogin(username, 'Posting')

        if (!keychainResult.success) {
          notify('error', keychainResult.error || 'Error en Keychain')
          return
        }

        notify('info', 'Verificando credenciales en servidor...')

        // 2. Obtener CSRF token para Auth.js
        const csrfResponse = await fetch('/api/auth/csrf')
        const { csrfToken } = await csrfResponse.json()

        // 🔍 DEBUG - Log locally instead of sending to server

        // 3. Login usando Auth.js callback endpoint para credentials
        const response = await fetch('/api/auth/callback/builders-keychain', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({
            username: keychainResult.username || '',
            message: keychainResult.message || '',
            publicKey: keychainResult.publicKey || '',
            signature: keychainResult.signature || '',
            timestamp: keychainResult.timestamp?.toString() || '',
            csrfToken,
            callbackUrl: '/builders/tickets',
          }),
        })

        // Check if it's a successful response
        if (response.ok || response.status === 302) {
          notify('success', '¡Login exitoso! Redirigiendo...')

          // For successful auth, redirect to tickets page
          setTimeout(() => {
            window.location.href = '/builders/tickets'
          }, 1000)
          return
        }

        // Handle errors
        try {
          const responseText = await response.text()

          // Try to parse as JSON to get error details
          let errorMessage = 'Error en autenticación'
          try {
            const responseData = JSON.parse(responseText)
            if (responseData.error) {
              errorMessage = responseData.error
            }
          } catch {
            // Not JSON, use status text
            errorMessage = `Error ${response.status}: ${response.statusText}`
          }

          notify('error', errorMessage)
        } catch (parseError) {
          notify('error', 'Error de comunicación con el servidor')
        }
      } catch (error) {
        notify('error', 'Error de conexión. Inténtalo de nuevo.')
      } finally {
        loginBtn.disabled = false
        loginBtn.textContent = 'Login con Keychain'
      }
    }
  </script>
</BuildersLayout>
