---
/**
 * Página de login para builders usando Keychain
 */
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import { DEFAULT_LOCALE, getMessages } from '@/i18n'

const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const auth = copy.auth.builders
---

<BuildersLayout title={auth.title} currentPage="login">
  <div class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-12">
    <div class="w-full min-w-0">
      <!-- Login Card -->
      <div class="border-border bg-card rounded-lg border p-8">
        <!-- Header -->
        <div class="mb-8 text-center">
          <h1 class="text-foreground mb-2 text-balance text-3xl font-bold tracking-tight">
            {auth.title}
          </h1>
          <p class="text-muted-foreground text-sm">
            {auth.subtitle}
          </p>
        </div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-6">
          <div class="space-y-2">
            <label
              for="username"
              class="text-foreground block text-sm font-medium"
            >
              {auth.username}
            </label>
            <input
              type="text"
              id="username"
              name="username"
              placeholder={auth.usernamePlaceholder}
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              class="border-border bg-muted text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 w-full min-w-0 rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
              required
            />
          </div>

          <!-- Keychain error (only visible when not available) -->
          <div
            id="keychain-status"
            class="border-border bg-muted/50 hidden rounded-lg border px-4 py-3 text-sm"
          >
          </div>

          <button
            type="submit"
            id="login-btn"
            class="bg-primary text-primary-foreground hover:bg-primary/90 focus:ring-primary/40 w-full rounded-lg px-4 py-2 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:opacity-50"
            disabled
          >
            {auth.submit}
          </button>
        </form>

        <!-- Footer: Keychain status as subtle text -->
        <div class="mt-8 text-center">
          <p id="keychain-footer" class="text-muted-foreground text-xs">
            {auth.checking}
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { z } from 'astro/zod'
    import { quickLogin, isKeychainReady } from '@/lib/keychain-service'
    import { publicCopy } from '@/i18n'
    import { notify } from '@/utils/toast'
    import { readApiResponse } from '@/utils/api-client'

    const BuilderLoginResponseSchema = z.looseObject({
      user: z.looseObject({
        username: z.string().min(1),
        role: z.string().min(1),
      }),
    })

    document.addEventListener('astro:page-load', async () => {
      await initPage()
      setupEventListeners()
    })

    // Inicializar página
    async function initPage() {
      const statusDiv = document.getElementById('keychain-status')!
      const footerText = document.getElementById('keychain-footer')!
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement

      try {
        const isReady = await isKeychainReady()

        if (isReady) {
          // Success: subtle footer text only, no prominent block
          footerText.textContent = publicCopy().auth.builders.detected
          footerText.classList.add('text-green-400/60')
          loginBtn.disabled = false
        } else {
          // Error: show visible block + footer
          statusDiv.classList.remove('hidden')
          const missing = publicCopy().auth.builders
          statusDiv.innerHTML = `
						<div class="text-red-400">
							${missing.unavailable}
							<div class="mt-1 text-muted-foreground">
								<a href="https://hive-keychain.com" target="_blank" class="text-primary underline">
									${missing.install}
								</a> ${missing.reload}
							</div>
						</div>
					`
          footerText.textContent = missing.required
          loginBtn.disabled = true
        }
      } catch (error) {
        statusDiv.classList.remove('hidden')
        const failed = publicCopy().auth.builders
        statusDiv.innerHTML = `
					<span class="text-red-400">${failed.checkError}</span>
				`
        footerText.textContent = failed.connectionError
        loginBtn.disabled = true
      }
    }

    // Setup event listeners
    function setupEventListeners() {
      const form = document.getElementById('login-form') as HTMLFormElement
      form.addEventListener('submit', handleLogin)
    }

    // Manejar login
    async function handleLogin(e: Event) {
      e.preventDefault()

      const form = e.target as HTMLFormElement
      const formData = new FormData(form)
      const username = ((formData.get('username') as string) || '').trim()

      if (!username) {
        notify('error', publicCopy().auth.builders.usernameRequired)
        return
      }

      // Desactivar botón
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement
      loginBtn.disabled = true
      loginBtn.textContent = publicCopy().auth.builders.connecting

      try {
        // 1. Login con Keychain
        notify('info', publicCopy().auth.builders.requestSignature)

        const keychainResult = await quickLogin(username, 'Posting')

        if (!keychainResult.success) {
          notify('error', keychainResult.error || publicCopy().auth.builders.keychainError)
          return
        }

        notify('info', publicCopy().auth.builders.verifying)

        const response = await fetch('/api/auth/keychain/verify', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            username: keychainResult.username || '',
            message: keychainResult.message || '',
            publicKey: keychainResult.publicKey || '',
            signature: keychainResult.signature || '',
            timestamp: keychainResult.timestamp?.toString() || '',
          }),
        })

        const result = await readApiResponse(
          response,
          BuilderLoginResponseSchema
        )

        if (response.ok && result.ok) {
          notify('success', publicCopy().auth.builders.success)
          setTimeout(() => {
            window.location.href = '/builders/tickets'
          }, 1000)
          return
        }

        const errorMessage = !result.ok
          ? result.kind === 'problem'
            ? result.problem.detail
            : result.kind === 'legacy_problem'
              ? result.message
              : publicCopy().auth.builders.invalidResponse
          : publicCopy().auth.builders.authError

        notify('error', errorMessage)
      } catch (error) {
        notify('error', publicCopy().auth.builders.retry)
      } finally {
        loginBtn.disabled = false
        loginBtn.textContent = publicCopy().auth.builders.submit
      }
    }
  </script>
</BuildersLayout>
