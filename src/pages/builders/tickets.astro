---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import TicketActionModal from '@/components/ui/TicketActionModal.astro'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'
import { formatDate, formatShortDateTime } from '@/utils/date-formatters'
import { ticketsRepository } from '@/lib/repositories/tickets-repository'
import { creditBalanceTracker } from '@/lib/credit-balance-tracker'
import { logger } from '@/lib/logger'
import type { TicketWithCreator } from '@/types/database'

const builderUser = Astro.locals.builderUser
const locale = Astro.locals.locale ?? DEFAULT_LOCALE
const copy = Astro.locals.messages ?? getMessages(locale)
const page = copy.buildersArea.tickets
const ui = copy.ui
if (!builderUser) return Astro.redirect('/builders/login')

let tickets: TicketWithCreator[] = []
let availableCredits = 0

if (builderUser) {
  try {
    tickets = await ticketsRepository.getBuilderTicketsWithCreator(
      builderUser.username
    )
    availableCredits = await creditBalanceTracker.getAvailableCredits(
      builderUser.username
    )
  } catch (error) {
    logger.error('Error loading tickets:', error)
  }
}

const maxUsesPerTicket = Math.min(availableCredits, 100)
const creditsHelpText = interpolate(page.creditsHelp, {
  available: String(availableCredits),
  max: String(maxUsesPerTicket),
})
---

<BuildersLayout title={page.title} currentPage="tickets">
  <div
    class="mx-auto max-w-7xl space-y-4 px-3 py-4 sm:space-y-6 sm:px-4 sm:py-6 lg:px-8"
  >
    <PageHeader title={page.title} description={page.description} />

    <!-- Tabla de Tickets del Builder -->
    <section
      class="border-border bg-card overflow-hidden rounded-lg border p-0"
    >
      <div
        class="border-border flex flex-col justify-between gap-3 border-b px-4 py-3 sm:flex-row sm:items-center sm:px-6 sm:py-4"
      >
        <h2
          class="text-foreground flex items-center gap-2 text-base font-semibold sm:text-lg"
        >
          {page.mine}
        </h2>
        <button
          id="create-ticket-btn"
          class:list={[
            'w-full rounded-lg px-4 py-2 text-sm font-medium transition-opacity sm:w-auto sm:px-6',
            availableCredits > 0
              ? 'bg-primary text-white hover:opacity-90'
              : 'cursor-not-allowed bg-gray-600 text-gray-400 opacity-50',
          ]}
          disabled={availableCredits === 0}
          title={availableCredits === 0 ? page.createDisabled : page.createTitle}
        >
          + {page.create}
        </button>
      </div>

      {/* Advertencia cuando no hay créditos disponibles */}
      {
        availableCredits === 0 && (
          <div class="border-b border-yellow-600/30 bg-yellow-900/10 px-6 py-4">
            <div class="flex items-center gap-3">
              <span class="text-xl">⚠️</span>
              <div>
                <span class="text-sm font-medium text-yellow-400">
                  {page.noCredits}
                </span>
                <span class="mx-2 text-yellow-600">•</span>
                <span class="text-sm text-yellow-300/70">
                  {page.noCreditsHelp}
                </span>
              </div>
            </div>
          </div>
        )
      }

      {
        tickets.length > 0 ? (
          <>
            {/* Desktop Table (md and up) */}
            <div class="hidden overflow-x-auto md:block">
              <table class="divide-border min-w-full divide-y text-sm">
                <thead class="table-header">
                  <tr>
                    <th class="table-th text-left">{ui.code}</th>
                    <th class="table-th text-center">{ui.uses}</th>
                    <th class="table-th text-center">{page.created}</th>
                    <th class="table-th text-center">{ui.actions}</th>
                  </tr>
                </thead>
                <tbody class="divide-border divide-y">
                  {tickets.map(t => (
                    <tr class="hover:bg-muted/40">
                      <td class="px-4 py-3 align-middle">
                        <div class="text-foreground font-medium">{t.code}</div>
                        {t.description && (
                          <div class="text-muted-foreground text-xs">
                            {t.description}
                          </div>
                        )}
                      </td>
                      <td class="px-4 py-3 text-center align-middle">
                        <span class="text-foreground font-semibold">
                          {t.remaining_uses}
                        </span>
                        <span class="text-muted-foreground">
                          /{t.total_uses}
                        </span>
                      </td>
                      <td class="text-muted-foreground px-4 py-3 text-center align-middle">
                        {formatDate(t.created_at, locale)}
                      </td>
                      <td class="px-4 py-3 align-middle">
                        <div class="flex items-center justify-center gap-2">
                          <button
                            class="copy-link-btn bg-primary/10 text-primary ring-primary/20 hover:bg-primary/20 inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium ring-1 transition-all"
                            data-ticket-code={t.code}
                            title={page.copyTitle}
                          >
                            <svg
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                              />
                            </svg>
                            {ui.copy}
                          </button>
                          <button
                            class="ticket-update-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-blue-500/10 px-3 py-1.5 text-xs font-medium text-blue-400 ring-1 ring-blue-500/20 transition-all hover:bg-blue-500/20"
                            data-ticket-id={t.id}
                            data-ticket-code={t.code}
                            data-ticket-uses={t.remaining_uses}
                            data-ticket-total-uses={t.total_uses}
                            title={page.editUses}
                          >
                            <svg
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                              />
                            </svg>
                            {ui.edit}
                          </button>
                          <button
                            class="ticket-delete-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-red-500/10 px-3 py-1.5 text-xs font-medium text-red-400 ring-1 ring-red-500/20 transition-all hover:bg-red-500/20"
                            data-ticket-id={t.id}
                            data-ticket-code={t.code}
                            data-ticket-uses={t.remaining_uses}
                            data-ticket-total-uses={t.total_uses}
                            title={page.deleteTitle}
                          >
                            <svg
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                              />
                            </svg>
                            {ui.delete}
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Mobile Cards (below md) */}
            <div class="space-y-3 p-3 md:hidden">
              {tickets.map(t => (
                <div class="bg-muted/30 border-border/50 relative overflow-hidden rounded-lg border">
                  {/* Pestaña con código */}
                  <div class="bg-muted/60 border-border/30 border-b px-3 py-1.5">
                    <div class="flex items-center justify-between">
                      <span class="text-foreground text-sm font-semibold">
                        {t.code}
                      </span>
                      <span class="text-muted-foreground text-xs">
                        {formatShortDateTime(t.created_at, locale)}
                      </span>
                    </div>
                    {t.description && (
                      <div class="text-muted-foreground mt-0.5 truncate text-xs">
                        {t.description}
                      </div>
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="space-y-3 p-3">
                    {/* Créditos destacados */}
                    <div class="flex items-center justify-between">
                      <span class="text-muted-foreground text-xs uppercase tracking-wide">
                        {ui.uses}
                      </span>
                      <div class="text-foreground text-lg font-semibold tabular-nums">
                        {t.remaining_uses}
                        <span class="text-muted-foreground text-sm font-normal">
                          /{t.total_uses}
                        </span>
                      </div>
                    </div>

                    {/* Acciones compactas */}
                    <div class="flex gap-2">
                      {/* Copiar Link - Acción principal */}
                      <button
                        class="copy-link-btn bg-primary/10 text-primary ring-primary/20 hover:bg-primary/20 inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-3 py-2 text-xs font-medium ring-1 transition-all"
                        data-ticket-code={t.code}
                        title={page.copyTitle}
                      >
                        <svg
                          class="h-4 w-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                          />
                        </svg>
                        {ui.copy}
                      </button>

                      {/* Editar */}
                      <button
                        class="ticket-update-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-blue-500/10 px-3 py-2 text-xs font-medium text-blue-400 ring-1 ring-blue-500/20 transition-all hover:bg-blue-500/20"
                        data-ticket-id={t.id}
                        data-ticket-code={t.code}
                        data-ticket-uses={t.remaining_uses}
                        data-ticket-total-uses={t.total_uses}
                        title={page.updateUsesTitle}
                      >
                        <svg
                          class="h-4 w-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                          />
                        </svg>
                        {ui.edit}
                      </button>

                      {/* Borrar */}
                      <button
                        class="ticket-delete-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-red-500/10 px-3 py-2 text-xs font-medium text-red-400 ring-1 ring-red-500/20 transition-all hover:bg-red-500/20"
                        data-ticket-id={t.id}
                        data-ticket-code={t.code}
                        data-ticket-uses={t.remaining_uses}
                        data-ticket-total-uses={t.total_uses}
                        title={page.deleteTitle}
                      >
                        <svg
                          class="h-4 w-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                          />
                        </svg>
                        {ui.delete}
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="p-10 text-center">
            <div class="mb-4 text-5xl">🪙</div>
            <p class="text-foreground mb-2 font-semibold">
              {page.emptyTitle}
            </p>
            <p class="text-muted-foreground text-sm">
              {page.emptyBody}
            </p>
          </div>
        )
      }
    </section>

    <!-- Información contextual - Dentro del contenedor principal -->
    <section class="border-border bg-card rounded-lg border p-6">
      <h3 class="text-foreground mb-2 text-sm font-semibold">
        ℹ️ {page.notes}
      </h3>
      <ul class="text-muted-foreground list-disc space-y-1 pl-4 text-xs">
        <li>{page.noteDelta}</li>
        <li>{page.noteRefund}</li>
        <li>{page.noteSpent}</li>
      </ul>
    </section>
  </div>

  <!-- Modal Crear Ticket -->
  <div
    id="create-ticket-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="mb-4 text-lg font-semibold text-white">🎟️ {page.modalTitle}</h3>
      <form id="create-ticket-form">
        <div class="mb-4">
          <label
            for="ticket-name"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            {page.name}
          </label>
          <div class="relative">
            <input
              type="text"
              id="ticket-name"
              name="ticketName"
              minlength="10"
              maxlength="24"
              placeholder={page.namePlaceholder}
              class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 uppercase text-white focus:border-transparent focus:outline-none focus:ring-2"
              required
            />
            <div
              id="ticket-check-icon"
              class="absolute right-3 top-1/2 hidden -translate-y-1/2"
            >
              <!-- Icons will be injected here -->
            </div>
          </div>
          <p class="mt-1 text-xs text-gray-400">
            {page.nameHelp}
          </p>
          <p id="ticket-availability" class="mt-1 text-xs"></p>
        </div>
        <div class="mb-4">
          <label
            for="ticket-uses"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            {page.initialUses}
          </label>
          <input
            type="number"
            id="ticket-uses"
            name="uses"
            min="1"
            value="1"
            max={maxUsesPerTicket}
            placeholder={`1-${maxUsesPerTicket}`}
            class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 text-white focus:border-transparent focus:outline-none focus:ring-2"
            required
            data-available-credits={availableCredits}
          />
          <p
            id="credits-help-text"
            class="mt-1 text-xs text-gray-400"
            data-original-help={creditsHelpText}
          >
            {creditsHelpText}
          </p>
        </div>
        <div class="mb-6">
          <label
            for="ticket-description"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            {page.descriptionLabel}
          </label>
          <textarea
            id="ticket-description"
            name="description"
            maxlength="100"
            rows="2"
            placeholder={page.descriptionPlaceholder}
            class="bg-background border-border focus:ring-primary text-foreground w-full rounded-lg border px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2"
          ></textarea>
        </div>
        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-create-ticket"
            class="btn-secondary flex-1"
          >
            {ui.cancel}
          </button>
          <button type="submit" class="btn-primary flex-1">
            {page.create}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Navegación interna eliminada: cubierta por las pestañas -->

  <!-- Ticket Action Modal -->
  <TicketActionModal availableCredits={availableCredits} />
</BuildersLayout>

<script>
  import { z } from 'astro/zod'
  import { BUILDERS_UI } from '@/consts/constants'
  import { publicCopy, interpolate } from '@/i18n'
  import { notify } from '@/utils/toast'
  import { readApiResponse } from '@/utils/api-client'

  const TicketCodeAvailabilitySchema = z.looseObject({
    available: z.boolean(),
    message: z.string().optional(),
  })

  const CreatedTicketSchema = z.looseObject({
    success: z.literal(true),
    ticketId: z.number().int().positive(),
    code: z.string().min(1),
    uses: z.number().int().positive(),
  })

  // ===== CONSTANTS =====
  const ALPHANUMERIC_REGEX = BUILDERS_UI.TICKET_VALIDATION.ALPHANUMERIC_REGEX
  const ONLY_NUMBERS_REGEX = BUILDERS_UI.TICKET_VALIDATION.ONLY_NUMBERS_REGEX
  const MIN_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MIN_LENGTH
  const MAX_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MAX_LENGTH

  const ticketsCopy = () => publicCopy().buildersArea.tickets

  function validateTicketName(name: string): string | null {
    const pageCopy = ticketsCopy()
    if (!name || name.trim().length === 0) {
      return pageCopy.nameRequired
    }
    if (name.length < MIN_TICKET_NAME_LENGTH) {
      return interpolate(pageCopy.minLength, {
        min: String(MIN_TICKET_NAME_LENGTH),
      })
    }
    if (name.length > MAX_TICKET_NAME_LENGTH) {
      return interpolate(pageCopy.maxLength, {
        max: String(MAX_TICKET_NAME_LENGTH),
      })
    }
    if (!ALPHANUMERIC_REGEX.test(name)) {
      return pageCopy.alphanumeric
    }
    if (ONLY_NUMBERS_REGEX.test(name)) {
      return pageCopy.onlyNumbers
    }
    return null
  }

  // Modal de crear ticket
  const createTicketBtn = document.getElementById('create-ticket-btn')
  const createTicketModal = document.getElementById('create-ticket-modal')
  const createTicketForm = document.getElementById(
    'create-ticket-form'
  ) as HTMLFormElement | null
  const cancelCreateTicket = document.getElementById('cancel-create-ticket')
  const ticketNameInput = document.getElementById(
    'ticket-name'
  ) as HTMLInputElement | null
  const ticketAvailabilityEl = document.getElementById('ticket-availability')
  const ticketCheckIcon = document.getElementById('ticket-check-icon')
  const ticketUsesInput = document.getElementById(
    'ticket-uses'
  ) as HTMLInputElement | null
  const creditsHelpText = document.getElementById(
    'credits-help-text'
  ) as HTMLParagraphElement | null
  const originalCreditsHelpText =
    creditsHelpText?.dataset.originalHelp ?? creditsHelpText?.textContent ?? ''

  // Debounce timer para validación en tiempo real
  let validationTimeout: ReturnType<typeof setTimeout> | null = null
  let isCodeAvailable = false

  // Validación en tiempo real del código del ticket
  ticketNameInput?.addEventListener('input', async e => {
    const input = e.target as HTMLInputElement
    const code = input.value.trim().toUpperCase()

    // Limpiar timeout anterior
    if (validationTimeout) {
      clearTimeout(validationTimeout)
    }

    // Resetear UI
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
      ticketCheckIcon.innerHTML = ''
    }
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
      ticketAvailabilityEl.className = 'mt-1 text-xs'
    }

    isCodeAvailable = false

    // Si el campo está vacío, no validar
    if (code.length === 0) return

    // Validación básica de formato
    const formatError = validateTicketName(code)
    if (formatError) {
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = formatError
        ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
      }
      return
    }

    // Mostrar estado de carga
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.remove('hidden')
      ticketCheckIcon.innerHTML = '<span class="text-gray-400">⏳</span>'
    }

    // Validar disponibilidad con debounce (500ms)
    validationTimeout = setTimeout(async () => {
      try {
        const response = await fetch(
          `/api/builders/tickets/check-code?code=${encodeURIComponent(code)}`
        )
        const result = await readApiResponse(
          response,
          TicketCodeAvailabilitySchema
        )

        if (response.ok && result.ok && result.data.available) {
          isCodeAvailable = true
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-green-400">✓</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent = `✓ ${ticketsCopy().codeAvailable}`
            ticketAvailabilityEl.className = 'mt-1 text-xs text-green-400'
          }
        } else {
          isCodeAvailable = false
          const errorMessage = result.ok
            ? result.data.message || ticketsCopy().codeUnavailable
            : result.kind === 'problem'
              ? result.problem.detail
              : result.kind === 'legacy_problem'
                ? result.message
                : ticketsCopy().checkUnavailable
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-red-400">✗</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent = errorMessage
            ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
          }
        }
      } catch (error) {
        // Error de red: no afirmar disponibilidad sin poder validarla.
        isCodeAvailable = false
        if (ticketCheckIcon) {
          ticketCheckIcon.classList.add('hidden')
        }
        if (ticketAvailabilityEl) {
          ticketAvailabilityEl.textContent = ticketsCopy().checkError
          ticketAvailabilityEl.className = 'mt-1 text-xs text-yellow-400'
        }
      }
    }, 500)
  })

  // Validación en tiempo real del campo de usos
  ticketUsesInput?.addEventListener('input', () => {
    const availableCredits = parseInt(
      ticketUsesInput.dataset.availableCredits || '0'
    )
    const maxAllowed = Math.min(availableCredits, 100)
    const currentValue = parseInt(ticketUsesInput.value) || 0

    // Si el valor excede el máximo permitido, ajustarlo automáticamente
    if (currentValue > maxAllowed) {
      ticketUsesInput.value = maxAllowed.toString()

      // Mostrar feedback visual temporal (usando textContent para prevenir XSS)
      if (creditsHelpText) {
        creditsHelpText.textContent = ''
        const warningSpan = document.createElement('span')
        warningSpan.className = 'text-yellow-400'
        warningSpan.textContent = `⚠️ ${interpolate(ticketsCopy().maxAllowed, {
          max: String(maxAllowed),
        })}`
        creditsHelpText.appendChild(warningSpan)
        setTimeout(() => {
          creditsHelpText.textContent = originalCreditsHelpText
        }, 2000)
      }
    }

    // Si el valor es menor que 1, ajustar a 1
    if (currentValue < 1 && ticketUsesInput.value !== '') {
      ticketUsesInput.value = '1'
    }
  })

  createTicketBtn?.addEventListener('click', () => {
    // No abrir modal si el botón está deshabilitado (sin créditos disponibles)
    if (
      createTicketBtn instanceof HTMLButtonElement &&
      createTicketBtn.disabled
    ) {
      notify('warning', ticketsCopy().createDisabled)
      return
    }
    createTicketModal?.classList.remove('hidden')
    createTicketModal?.classList.add('flex')
    ticketNameInput?.focus()
  })

  cancelCreateTicket?.addEventListener('click', () => {
    createTicketModal?.classList.add('hidden')
    createTicketModal?.classList.remove('flex')
    createTicketForm?.reset()
    // Limpiar mensajes de validación
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
    }
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
    }
  })

  // Submit del formulario
  createTicketForm?.addEventListener('submit', async e => {
    e.preventDefault()

    const formData = new FormData(e.target as HTMLFormElement)
    const ticketName = (formData.get('ticketName') as string)
      .toUpperCase()
      .trim()
    const uses = parseInt(formData.get('uses') as string)
    const description = formData.get('description') as string

    // Validar nombre
    const error = validateTicketName(ticketName)
    if (error) {
      notify('error', error)
      return
    }

    // Validar disponibilidad antes de enviar
    if (!isCodeAvailable) {
      notify('error', ticketsCopy().notValidated)
      return
    }

    // Validar usos (usar el elemento ya declarado al inicio del script)
    const maxCredits = parseInt(
      ticketUsesInput?.dataset.availableCredits || '0'
    )
    const effectiveMax = Math.min(maxCredits, 100)

    if (!uses || uses < 1) {
      notify('error', ticketsCopy().minUses)
      return
    }

    if (uses > effectiveMax) {
      notify(
        'error',
        interpolate(ticketsCopy().usesOverCredits, {
          max: String(effectiveMax),
          credits: String(maxCredits),
        })
      )
      return
    }

    try {
      const resp = await fetch('/api/builders/tickets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: ticketName,
          uses,
          description: description || null,
        }),
      })

      const result = await readApiResponse(resp, CreatedTicketSchema)

      if (resp.ok && result.ok) {
        notify(
          'success',
          interpolate(ticketsCopy().createdSuccess, { name: ticketName }),
          3000
        )
        createTicketModal?.classList.add('hidden')
        createTicketModal?.classList.remove('flex')
        createTicketForm?.reset()

        // Wait 3 seconds for user to see toast before reload
        setTimeout(() => {
          location.reload()
        }, 3000)
      } else {
        const pageCopy = ticketsCopy()
        const errorMessage = result.ok
          ? pageCopy.createFailed
          : result.kind === 'problem'
            ? result.problem.detail
            : result.kind === 'legacy_problem'
              ? result.message
              : pageCopy.invalidCreate
        notify('error', errorMessage)
      }
    } catch (error) {
      notify('error', publicCopy().ui.connectionError)
    }
  })

  // Cerrar modal al hacer clic fuera
  createTicketModal?.addEventListener('click', e => {
    if (e.target === createTicketModal) {
      createTicketModal.classList.add('hidden')
      createTicketModal.classList.remove('flex')
      createTicketForm?.reset()
      // Limpiar mensajes de validación
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = ''
      }
      if (ticketCheckIcon) {
        ticketCheckIcon.classList.add('hidden')
      }
    }
  })

  // ===== TICKET ACTION MODAL =====
  import { initializeTicketModals } from '@/lib/admin_ui/ticket-modal-handlers'

  // Inicializar modales una vez que el DOM esté listo
  initializeTicketModals(notify)

  // ===== COPY LINK HANDLER =====
  document.querySelectorAll('.copy-link-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const ticketCode = (btn as HTMLElement).dataset.ticketCode
      if (!ticketCode) return

      try {
        const ticketUrl = `${window.location.origin}/?ticket=${ticketCode}`
        await navigator.clipboard.writeText(ticketUrl)
        notify(
          'success',
          interpolate(ticketsCopy().copied, { url: ticketUrl }),
          2000
        )
      } catch (error) {
        console.error('Error copying to clipboard:', error)
        notify('error', ticketsCopy().copyError)
      }
    })
  })
</script>
