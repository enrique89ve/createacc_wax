---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import BuildersTabs from '@/components/ui/BuildersTabs.astro'
import TicketActionModal from '@/components/ui/TicketActionModal.astro'
import Toasts from '@/components/ui/Toasts.astro'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { ticketsRepository } from '@/lib/repositories/tickets-repository'
import { creditBalanceTracker } from '@/lib/credit-balance-tracker'
import type { BuilderUser } from '@/lib/admin/auth/helpers/auth-guards'
import type { TicketWithCreator } from '@/types/database'

// Autenticación centralizada - si no está autenticado, se redirige automáticamente
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Obtener tickets del usuario usando repository
let tickets: TicketWithCreator[] = []
let availableCredits = 0

// Asegurar que tenemos un BuilderUser válido
if (!currentUser || currentUser.role !== 'builder') {
  console.error('Invalid builder user:', currentUser)
} else {
  try {
    const builderUser = currentUser as BuilderUser
    tickets = await ticketsRepository.getBuilderTicketsWithCreator(
      builderUser.id
    )

    // Obtener créditos disponibles del builder usando credit-balance-tracker
    availableCredits = await creditBalanceTracker.getAvailableCredits(
      builderUser.username
    )
  } catch (error) {
    console.error('Error loading tickets:', error)
  }
}
---

<BuildersLayout title="Dashboard" currentPage="tickets">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h1 class="mb-2 text-3xl font-bold text-white">
        Hola {
          currentUser?.role === 'builder' ? currentUser.username : 'Builder'
        }! 👋
      </h1>
      <p class="text-gray-400">
        Gestiona tus tickets y crea cuentas Hive desde un solo lugar.
      </p>
    </div>
    <BuildersTabs active="tickets" />

    <!-- Tabla de Tickets del Builder -->
    <section
      class="mb-10 overflow-hidden rounded-lg border border-gray-700/60 bg-gray-900/40 p-0"
    >
      <div
        class="flex items-center justify-between border-b border-gray-700/60 px-6 py-4"
      >
        <h2 class="flex items-center gap-2 text-lg font-semibold text-white">
          🎟️ Mis Tickets
        </h2>
        <div class="flex items-center gap-3">
          <button
            id="create-ticket-btn"
            class="bg-primary rounded-lg px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
          >
            + Crear Ticket
          </button>
        </div>
      </div>
      {
        tickets.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-700 text-sm">
              <thead class="bg-gray-800/60">
                <tr>
                  <th class="px-4 py-2 text-left font-medium uppercase tracking-wide text-gray-300">
                    Código
                  </th>
                  <th class="px-4 py-2 text-left font-medium uppercase tracking-wide text-gray-300">
                    Créditos
                  </th>
                  <th class="px-4 py-2 text-left font-medium uppercase tracking-wide text-gray-300">
                    Estado
                  </th>
                  <th class="px-4 py-2 text-left font-medium uppercase tracking-wide text-gray-300">
                    Creado
                  </th>
                  <th class="px-4 py-2 text-left font-medium uppercase tracking-wide text-gray-300">
                    Acciones
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-700">
                {tickets.map(t => (
                  <tr class="hover:bg-gray-800/40">
                    <td class="px-4 py-2 align-top">
                      <div class="font-medium text-white">{t.code}</div>
                      {t.description && (
                        <div class="text-xs text-gray-400">{t.description}</div>
                      )}
                    </td>
                    <td class="px-4 py-2 align-top">
                      <span class="font-semibold text-white">{t.credits}</span>
                      <span class="text-gray-400">/{t.original_credits}</span>
                    </td>
                    <td class="px-4 py-2 align-top">
                      <span
                        class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${!t.is_active ? 'bg-red-500/20 text-red-300' : t.has_been_used ? 'bg-green-500/20 text-green-300' : 'bg-yellow-500/20 text-yellow-300'}`}
                      >
                        {!t.is_active
                          ? 'Sin créditos'
                          : t.has_been_used
                            ? 'En uso'
                            : 'Disponible'}
                      </span>
                    </td>
                    <td class="px-4 py-2 align-top text-gray-400">
                      {new Date(t.created_at).toLocaleDateString()}
                    </td>
                    <td class="space-x-3 px-4 py-2 align-top">
                      <button
                        class="ticket-update-btn text-xs font-medium text-blue-400 hover:text-blue-300"
                        data-ticket-id={t.id}
                        data-ticket-code={t.code}
                        data-ticket-credits={t.credits}
                        data-ticket-original={t.original_credits}
                      >
                        Actualizar
                      </button>
                      {!t.has_been_used && (
                        <button
                          class="ticket-delete-btn text-xs font-medium text-red-400 hover:text-red-300"
                          data-ticket-id={t.id}
                          data-ticket-code={t.code}
                          data-ticket-credits={t.credits}
                          data-ticket-original={t.original_credits}
                        >
                          Borrar
                        </button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="p-10 text-center">
            <div class="mb-4 text-5xl">🪙</div>
            <p class="mb-2 font-semibold text-white">Aún no tienes tickets</p>
            <p class="text-sm text-gray-400">
              Cuando crees tickets aparecerán aquí.
            </p>
          </div>
        )
      }
    </section>
  </div>

  <!-- Información contextual -->
  <div class="mt-4 rounded-lg border border-gray-700/60 bg-gray-900/40 p-6">
    <h3 class="mb-2 text-sm font-semibold text-white">ℹ️ Notas</h3>
    <ul class="list-disc space-y-1 pl-4 text-xs text-gray-400">
      <li>
        Actualizar créditos aplica un delta (positivo o negativo) sobre los
        créditos actuales.
      </li>
      <li>No puedes borrar un ticket que ya fue usado.</li>
      <li>El borrado devuelve los créditos originales a tu saldo.</li>
    </ul>
  </div>

  <!-- Modal Crear Ticket -->
  <div
    id="create-ticket-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="mb-4 text-lg font-semibold text-white">🎟️ Crear Ticket</h3>
      <form id="create-ticket-form">
        <div class="mb-4">
          <label
            for="ticket-name"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Nombre del Ticket
          </label>
          <div class="relative">
            <input
              type="text"
              id="ticket-name"
              name="ticketName"
              maxlength="16"
              placeholder="Ej: PROMO2025"
              class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 uppercase text-white focus:border-transparent focus:outline-none focus:ring-2"
              required
            />
            <div
              id="ticket-check-icon"
              class="absolute right-3 top-1/2 hidden -translate-y-1/2"
            >
              <!-- Icons will be injected here -->
            </div>
          </div>
          <p class="mt-1 text-xs text-gray-400">
            4-16 caracteres, letras y números (no solo números)
          </p>
          <p id="ticket-availability" class="mt-1 text-xs"></p>
        </div>
        <div class="mb-4">
          <label
            for="ticket-credits"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Créditos Iniciales
          </label>
          <input
            type="number"
            id="ticket-credits"
            name="credits"
            min="1"
            max="100"
            placeholder="1-100"
            class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 text-white focus:border-transparent focus:outline-none focus:ring-2"
            required
          />
          <p class="mt-1 text-xs text-gray-400">
            Máximo 100 créditos por ticket
          </p>
        </div>
        <div class="mb-6">
          <label
            for="ticket-description"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Descripción (opcional)
          </label>
          <textarea
            id="ticket-description"
            name="description"
            maxlength="100"
            rows="2"
            placeholder="Ej: Promoción especial 2025"
            class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 text-white focus:border-transparent focus:outline-none focus:ring-2"
          ></textarea>
        </div>
        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-create-ticket"
            class="flex-1 rounded-lg border border-gray-600 px-4 py-2 text-gray-300 hover:bg-gray-800"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="bg-primary flex-1 rounded-lg px-4 py-2 text-white hover:opacity-90"
          >
            Crear Ticket
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Navegación interna eliminada: cubierta por las pestañas -->

  <!-- Ticket Action Modal -->
  <TicketActionModal availableCredits={availableCredits} />

  <!-- Notification Toast -->
  <Toasts />
</BuildersLayout>

<script>
  import { BUILDERS_UI } from '@/consts/constants'
  import { notify } from '@/utils/toast'

  // ===== CONSTANTS =====
  const ONLY_NUMBERS_REGEX = BUILDERS_UI.TICKET_VALIDATION.ONLY_NUMBERS_REGEX
  const MIN_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MIN_LENGTH
  const MAX_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MAX_LENGTH

  function validateTicketName(name: string): string | null {
    if (!name || name.trim().length === 0) {
      return 'El nombre del ticket es requerido'
    }
    if (name.length < MIN_TICKET_NAME_LENGTH) {
      return `El nombre debe tener al menos ${MIN_TICKET_NAME_LENGTH} caracteres`
    }
    if (name.length > MAX_TICKET_NAME_LENGTH) {
      return `El nombre no puede exceder ${MAX_TICKET_NAME_LENGTH} caracteres`
    }
    if (ONLY_NUMBERS_REGEX.test(name)) {
      return 'No puede ser solo números'
    }
    return null
  }

  // Modal de crear ticket
  const createTicketBtn = document.getElementById('create-ticket-btn')
  const createTicketModal = document.getElementById('create-ticket-modal')
  const createTicketForm = document.getElementById(
    'create-ticket-form'
  ) as HTMLFormElement | null
  const cancelCreateTicket = document.getElementById('cancel-create-ticket')
  const ticketNameInput = document.getElementById(
    'ticket-name'
  ) as HTMLInputElement | null
  const ticketAvailabilityEl = document.getElementById('ticket-availability')
  const ticketCheckIcon = document.getElementById('ticket-check-icon')

  // Debounce timer para validación en tiempo real
  let validationTimeout: ReturnType<typeof setTimeout> | null = null
  let isCodeAvailable = false

  // Validación en tiempo real del código del ticket
  ticketNameInput?.addEventListener('input', async e => {
    const input = e.target as HTMLInputElement
    const code = input.value.trim().toUpperCase()

    // Limpiar timeout anterior
    if (validationTimeout) {
      clearTimeout(validationTimeout)
    }

    // Resetear UI
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
      ticketCheckIcon.innerHTML = ''
    }
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
      ticketAvailabilityEl.className = 'mt-1 text-xs'
    }

    isCodeAvailable = false

    // Si el campo está vacío, no validar
    if (code.length === 0) return

    // Validación básica de formato
    const formatError = validateTicketName(code)
    if (formatError) {
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = formatError
        ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
      }
      return
    }

    // Mostrar estado de carga
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.remove('hidden')
      ticketCheckIcon.innerHTML = '<span class="text-gray-400">⏳</span>'
    }

    // Validar disponibilidad con debounce (500ms)
    validationTimeout = setTimeout(async () => {
      try {
        const response = await fetch(
          `/api/builders/tickets/check-code?code=${encodeURIComponent(code)}`
        )
        const data = await response.json()

        if (data.available) {
          isCodeAvailable = true
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-green-400">✓</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent = '✓ Código disponible'
            ticketAvailabilityEl.className = 'mt-1 text-xs text-green-400'
          }
        } else {
          isCodeAvailable = false
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-red-400">✗</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent =
              data.error || data.message || 'Código no disponible'
            ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
          }
        }
      } catch (error) {
        // Error de red - no bloquear
        if (ticketCheckIcon) {
          ticketCheckIcon.classList.add('hidden')
        }
        if (ticketAvailabilityEl) {
          ticketAvailabilityEl.textContent = 'Error al verificar disponibilidad'
          ticketAvailabilityEl.className = 'mt-1 text-xs text-yellow-400'
        }
      }
    }, 500)
  })

  createTicketBtn?.addEventListener('click', () => {
    createTicketModal?.classList.remove('hidden')
    createTicketModal?.classList.add('flex')
    ticketNameInput?.focus()
  })

  cancelCreateTicket?.addEventListener('click', () => {
    createTicketModal?.classList.add('hidden')
    createTicketModal?.classList.remove('flex')
    createTicketForm?.reset()
    // Limpiar mensajes de validación
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
    }
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
    }
  })

  // Submit del formulario
  createTicketForm?.addEventListener('submit', async e => {
    e.preventDefault()

    const formData = new FormData(e.target as HTMLFormElement)
    const ticketName = (formData.get('ticketName') as string)
      .toUpperCase()
      .trim()
    const credits = parseInt(formData.get('credits') as string)
    const description = formData.get('description') as string

    // Validar nombre
    const error = validateTicketName(ticketName)
    if (error) {
      notify('error', error)
      return
    }

    // Validar disponibilidad antes de enviar
    if (!isCodeAvailable) {
      notify(
        'error',
        'El código del ticket no está disponible o no ha sido validado'
      )
      return
    }

    // Validar créditos
    if (!credits || credits < 1 || credits > 100) {
      notify('error', 'Los créditos deben estar entre 1 y 100')
      return
    }

    try {
      const resp = await fetch('/api/management/tickets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: ticketName,
          credits: credits,
          description: description || null,
        }),
      })

      const data = await resp.json()

      if (resp.ok && data.success) {
        notify('success', `Ticket "${ticketName}" creado exitosamente!`, 3000)
        createTicketModal?.classList.add('hidden')
        createTicketModal?.classList.remove('flex')
        createTicketForm?.reset()

        // Wait 3 seconds for user to see toast before reload
        setTimeout(() => {
          location.reload()
        }, 3000)
      } else {
        notify('error', data.error || 'Error al crear el ticket')
      }
    } catch (error) {
      notify('error', 'Error de conexión')
    }
  })

  // Cerrar modal al hacer clic fuera
  createTicketModal?.addEventListener('click', e => {
    if (e.target === createTicketModal) {
      createTicketModal.classList.add('hidden')
      createTicketModal.classList.remove('flex')
      createTicketForm?.reset()
      // Limpiar mensajes de validación
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = ''
      }
      if (ticketCheckIcon) {
        ticketCheckIcon.classList.add('hidden')
      }
    }
  })

  // ===== TICKET ACTION MODAL =====
  import { initializeTicketModals } from '@/lib/admin_ui/ticket-modal-handlers'

  // Inicializar modales una vez que el DOM esté listo
  initializeTicketModals(notify)
</script>
