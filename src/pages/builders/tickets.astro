---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import TicketActionModal from '@/components/ui/TicketActionModal.astro'
import { formatDate, formatShortDateTime } from '@/utils/date-formatters'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { ticketsRepository } from '@/lib/repositories/tickets-repository'
import { creditBalanceTracker } from '@/lib/credit-balance-tracker'
import type { BuilderUser } from '@/lib/admin/auth/helpers/auth-guards'
import type { TicketWithCreator } from '@/types/database'
import { UserRole } from '@/lib/roles'

// Autenticación centralizada - si no está autenticado, se redirige automáticamente
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Obtener tickets del usuario usando repository
let tickets: TicketWithCreator[] = []
let availableCredits = 0

// Asegurar que tenemos un BuilderUser válido
if (!currentUser || currentUser.role !== UserRole.Builder) {
  console.error('Invalid builder user:', currentUser)
} else {
  try {
    const builderUser = currentUser as BuilderUser
    tickets = await ticketsRepository.getBuilderTicketsWithCreator(
      builderUser.id
    )

    // Obtener créditos disponibles del builder usando credit-balance-tracker
    availableCredits = await creditBalanceTracker.getAvailableCredits(
      builderUser.username
    )
  } catch (error) {
    console.error('Error loading tickets:', error)
  }
}
---

<BuildersLayout title="Dashboard" currentPage="tickets">
  <div class="mx-auto max-w-7xl space-y-4 sm:space-y-6 px-3 sm:px-4 py-4 sm:py-6 lg:px-8">
    <PageHeader
      title="Gestión de Tickets"
      description="Gestiona tus tickets y crea cuentas Hive desde un solo lugar."
    />

    <!-- Tabla de Tickets del Builder -->
    <section
      class="border-border bg-card overflow-hidden rounded-lg border p-0"
    >
      <div
        class="border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b px-4 sm:px-6 py-3 sm:py-4"
      >
        <h2
          class="text-foreground flex items-center gap-2 text-base sm:text-lg font-semibold"
        >
          Mis Tickets
        </h2>
        <button
          id="create-ticket-btn"
          class:list={[
            'rounded-lg px-4 sm:px-6 py-2 text-sm font-medium transition-opacity w-full sm:w-auto',
            availableCredits > 0
              ? 'bg-primary text-white hover:opacity-90'
              : 'cursor-not-allowed bg-gray-600 text-gray-400 opacity-50',
          ]}
          disabled={availableCredits === 0}
          title={availableCredits === 0
            ? 'No tienes créditos disponibles para crear tickets'
            : 'Crear un nuevo ticket'}
        >
          + Crear Ticket
        </button>
      </div>

      {/* Advertencia cuando no hay créditos disponibles */}
      {
        availableCredits === 0 && (
          <div class="border-b border-yellow-600/30 bg-yellow-900/10 px-6 py-4">
            <div class="flex items-center gap-3">
              <span class="text-xl">⚠️</span>
              <div>
                <span class="text-sm font-medium text-yellow-400">
                  Sin créditos disponibles
                </span>
                <span class="mx-2 text-yellow-600">•</span>
                <span class="text-sm text-yellow-300/70">
                  Reclama créditos pendientes o contacta a un administrador
                </span>
              </div>
            </div>
          </div>
        )
      }

      {
        tickets.length > 0 ? (
          <>
            {/* Desktop Table (md and up) */}
            <div class="hidden md:block overflow-x-auto">
              <table class="divide-border min-w-full divide-y text-sm">
                <thead class="table-header">
                  <tr>
                    <th class="table-th text-left">Código</th>
                    <th class="table-th text-center">Créditos</th>
                    <th class="table-th text-center">Creado</th>
                    <th class="table-th text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-border divide-y">
                  {tickets.map(t => (
                    <tr class="hover:bg-muted/40">
                      <td class="px-4 py-3 align-middle">
                        <div class="text-foreground font-medium">{t.code}</div>
                        {t.description && (
                          <div class="text-muted-foreground text-xs">
                            {t.description}
                          </div>
                        )}
                      </td>
                      <td class="px-4 py-3 align-middle text-center">
                        <span class="text-foreground font-semibold">
                          {t.credits}
                        </span>
                        <span class="text-muted-foreground">
                          /{t.original_credits}
                        </span>
                      </td>
                      <td class="px-4 py-3 align-middle text-center text-muted-foreground">
                        {formatDate(t.created_at)}
                      </td>
                      <td class="px-4 py-3 align-middle">
                        <div class="flex items-center justify-center gap-2">
                          <button
                            class="copy-link-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary ring-1 ring-primary/20 hover:bg-primary/20 transition-all"
                            data-ticket-code={t.code}
                            title="Copiar link con ticket"
                          >
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            Copiar
                          </button>
                          <button
                            class="ticket-update-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-blue-500/10 px-3 py-1.5 text-xs font-medium text-blue-400 ring-1 ring-blue-500/20 hover:bg-blue-500/20 transition-all"
                            data-ticket-id={t.id}
                            data-ticket-code={t.code}
                            data-ticket-credits={t.credits}
                            data-ticket-original={t.original_credits}
                            title="Editar créditos"
                          >
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Editar
                          </button>
                          <button
                            class="ticket-delete-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-red-500/10 px-3 py-1.5 text-xs font-medium text-red-400 ring-1 ring-red-500/20 hover:bg-red-500/20 transition-all"
                            data-ticket-id={t.id}
                            data-ticket-code={t.code}
                            data-ticket-credits={t.credits}
                            data-ticket-original={t.original_credits}
                            title="Eliminar ticket"
                          >
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Borrar
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Mobile Cards (below md) */}
            <div class="md:hidden space-y-3 p-3">
              {tickets.map(t => (
                <div class="relative bg-muted/30 rounded-lg border border-border/50 overflow-hidden">
                  {/* Pestaña con código */}
                  <div class="bg-muted/60 px-3 py-1.5 border-b border-border/30">
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-semibold text-sm">{t.code}</span>
                      <span class="text-muted-foreground text-xs">
                        {formatShortDateTime(t.created_at)}
                      </span>
                    </div>
                    {t.description && (
                      <div class="text-muted-foreground text-xs truncate mt-0.5">
                        {t.description}
                      </div>
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="p-3 space-y-3">
                    {/* Créditos destacados */}
                    <div class="flex items-center justify-between">
                      <span class="text-muted-foreground text-xs uppercase tracking-wide">Créditos</span>
                      <div class="text-foreground font-semibold text-lg tabular-nums">
                        {t.credits}<span class="text-muted-foreground text-sm font-normal">/{t.original_credits}</span>
                      </div>
                    </div>

                    {/* Acciones compactas */}
                    <div class="flex gap-2">
                    {/* Copiar Link - Acción principal */}
                    <button
                      class="copy-link-btn flex-1 inline-flex items-center justify-center gap-1.5 rounded-md bg-primary/10 px-3 py-2 text-xs font-medium text-primary ring-1 ring-primary/20 hover:bg-primary/20 transition-all"
                      data-ticket-code={t.code}
                      title="Copiar link con ticket"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                      Copiar
                    </button>

                    {/* Editar */}
                    <button
                      class="ticket-update-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-blue-500/10 px-3 py-2 text-xs font-medium text-blue-400 ring-1 ring-blue-500/20 hover:bg-blue-500/20 transition-all"
                      data-ticket-id={t.id}
                      data-ticket-code={t.code}
                      data-ticket-credits={t.credits}
                      data-ticket-original={t.original_credits}
                      title="Actualizar créditos"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      Editar
                    </button>

                    {/* Borrar */}
                    <button
                      class="ticket-delete-btn inline-flex items-center justify-center gap-1.5 rounded-md bg-red-500/10 px-3 py-2 text-xs font-medium text-red-400 ring-1 ring-red-500/20 hover:bg-red-500/20 transition-all"
                      data-ticket-id={t.id}
                      data-ticket-code={t.code}
                      data-ticket-credits={t.credits}
                      data-ticket-original={t.original_credits}
                      title="Eliminar ticket"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      Borrar
                    </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="p-10 text-center">
            <div class="mb-4 text-5xl">🪙</div>
            <p class="text-foreground mb-2 font-semibold">
              Aún no tienes tickets
            </p>
            <p class="text-muted-foreground text-sm">
              Cuando crees tickets aparecerán aquí.
            </p>
          </div>
        )
      }
    </section>

    <!-- Información contextual - Dentro del contenedor principal -->
    <section class="border-border bg-card rounded-lg border p-6">
      <h3 class="text-foreground mb-2 text-sm font-semibold">ℹ️ Notas</h3>
      <ul class="text-muted-foreground list-disc space-y-1 pl-4 text-xs">
        <li>
          Actualizar créditos aplica un delta (positivo o negativo) sobre los
          créditos actuales.
        </li>
        <li>El borrado devuelve los créditos originales a tu saldo.</li>
        <li>
          Si el ticket ya fue usado para crear cuentas, se eliminará pero sin
          reembolso de créditos consumidos.
        </li>
      </ul>
    </section>
  </div>

  <!-- Modal Crear Ticket -->
  <div
    id="create-ticket-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      class="bg-card border-border mx-4 w-full max-w-md rounded-lg border p-6"
    >
      <h3 class="mb-4 text-lg font-semibold text-white">🎟️ Crear Ticket</h3>
      <form id="create-ticket-form">
        <div class="mb-4">
          <label
            for="ticket-name"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Nombre del Ticket
          </label>
          <div class="relative">
            <input
              type="text"
              id="ticket-name"
              name="ticketName"
              minlength="10"
              maxlength="24"
              placeholder="Ej: PROMO2025AB"
              class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 uppercase text-white focus:border-transparent focus:outline-none focus:ring-2"
              required
            />
            <div
              id="ticket-check-icon"
              class="absolute right-3 top-1/2 hidden -translate-y-1/2"
            >
              <!-- Icons will be injected here -->
            </div>
          </div>
          <p class="mt-1 text-xs text-gray-400">
            10-24 caracteres, letras y números (no solo números)
          </p>
          <p id="ticket-availability" class="mt-1 text-xs"></p>
        </div>
        <div class="mb-4">
          <label
            for="ticket-credits"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Créditos Iniciales
          </label>
          <input
            type="number"
            id="ticket-credits"
            name="credits"
            min="1"
            value="1"
            max={Math.min(availableCredits, 100)}
            placeholder={`1-${Math.min(availableCredits, 100)}`}
            class="bg-background border-border focus:ring-primary w-full rounded-lg border px-3 py-2 text-white focus:border-transparent focus:outline-none focus:ring-2"
            required
            data-available-credits={availableCredits}
          />
          <p id="credits-help-text" class="mt-1 text-xs text-gray-400">
            Tienes <span class="text-primary font-semibold"
              >{availableCredits}</span
            > créditos disponibles (máx. 100 por ticket)
          </p>
        </div>
        <div class="mb-6">
          <label
            for="ticket-description"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Descripción (opcional)
          </label>
          <textarea
            id="ticket-description"
            name="description"
            maxlength="100"
            rows="2"
            placeholder="Ej: Promoción especial 2025"
            class="bg-background border-border focus:ring-primary text-foreground w-full rounded-lg border px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2"
          ></textarea>
        </div>
        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-create-ticket"
            class="btn-secondary flex-1"
          >
            Cancelar
          </button>
          <button type="submit" class="btn-primary flex-1">
            Crear Ticket
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Navegación interna eliminada: cubierta por las pestañas -->

  <!-- Ticket Action Modal -->
  <TicketActionModal availableCredits={availableCredits} />
</BuildersLayout>

<script>
  import { BUILDERS_UI } from '@/consts/constants'
  import { notify } from '@/utils/toast'

  // ===== CONSTANTS =====
  const ALPHANUMERIC_REGEX = BUILDERS_UI.TICKET_VALIDATION.ALPHANUMERIC_REGEX
  const ONLY_NUMBERS_REGEX = BUILDERS_UI.TICKET_VALIDATION.ONLY_NUMBERS_REGEX
  const MIN_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MIN_LENGTH
  const MAX_TICKET_NAME_LENGTH = BUILDERS_UI.TICKET_VALIDATION.MAX_LENGTH

  function validateTicketName(name: string): string | null {
    if (!name || name.trim().length === 0) {
      return 'El nombre del ticket es requerido'
    }
    if (name.length < MIN_TICKET_NAME_LENGTH) {
      return `El nombre debe tener al menos ${MIN_TICKET_NAME_LENGTH} caracteres`
    }
    if (name.length > MAX_TICKET_NAME_LENGTH) {
      return `El nombre no puede exceder ${MAX_TICKET_NAME_LENGTH} caracteres`
    }
    if (!ALPHANUMERIC_REGEX.test(name)) {
      return 'Solo puede contener letras y números'
    }
    if (ONLY_NUMBERS_REGEX.test(name)) {
      return 'No puede ser solo números'
    }
    return null
  }

  // Modal de crear ticket
  const createTicketBtn = document.getElementById('create-ticket-btn')
  const createTicketModal = document.getElementById('create-ticket-modal')
  const createTicketForm = document.getElementById(
    'create-ticket-form'
  ) as HTMLFormElement | null
  const cancelCreateTicket = document.getElementById('cancel-create-ticket')
  const ticketNameInput = document.getElementById(
    'ticket-name'
  ) as HTMLInputElement | null
  const ticketAvailabilityEl = document.getElementById('ticket-availability')
  const ticketCheckIcon = document.getElementById('ticket-check-icon')
  const ticketCreditsInput = document.getElementById(
    'ticket-credits'
  ) as HTMLInputElement | null
  const creditsHelpText = document.getElementById(
    'credits-help-text'
  ) as HTMLParagraphElement | null
  const originalCreditsHelpText = creditsHelpText?.innerHTML ?? ''

  // Debounce timer para validación en tiempo real
  let validationTimeout: ReturnType<typeof setTimeout> | null = null
  let isCodeAvailable = false

  // Validación en tiempo real del código del ticket
  ticketNameInput?.addEventListener('input', async e => {
    const input = e.target as HTMLInputElement
    const code = input.value.trim().toUpperCase()

    // Limpiar timeout anterior
    if (validationTimeout) {
      clearTimeout(validationTimeout)
    }

    // Resetear UI
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
      ticketCheckIcon.innerHTML = ''
    }
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
      ticketAvailabilityEl.className = 'mt-1 text-xs'
    }

    isCodeAvailable = false

    // Si el campo está vacío, no validar
    if (code.length === 0) return

    // Validación básica de formato
    const formatError = validateTicketName(code)
    if (formatError) {
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = formatError
        ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
      }
      return
    }

    // Mostrar estado de carga
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.remove('hidden')
      ticketCheckIcon.innerHTML = '<span class="text-gray-400">⏳</span>'
    }

    // Validar disponibilidad con debounce (500ms)
    validationTimeout = setTimeout(async () => {
      try {
        const response = await fetch(
          `/api/builders/tickets/check-code?code=${encodeURIComponent(code)}`
        )
        const data = await response.json()

        if (data.available) {
          isCodeAvailable = true
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-green-400">✓</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent = '✓ Código disponible'
            ticketAvailabilityEl.className = 'mt-1 text-xs text-green-400'
          }
        } else {
          isCodeAvailable = false
          if (ticketCheckIcon) {
            ticketCheckIcon.innerHTML = '<span class="text-red-400">✗</span>'
          }
          if (ticketAvailabilityEl) {
            ticketAvailabilityEl.textContent =
              data.error || data.message || 'Código no disponible'
            ticketAvailabilityEl.className = 'mt-1 text-xs text-red-400'
          }
        }
      } catch (error) {
        // Error de red - no bloquear
        if (ticketCheckIcon) {
          ticketCheckIcon.classList.add('hidden')
        }
        if (ticketAvailabilityEl) {
          ticketAvailabilityEl.textContent = 'Error al verificar disponibilidad'
          ticketAvailabilityEl.className = 'mt-1 text-xs text-yellow-400'
        }
      }
    }, 500)
  })

  // Validación en tiempo real del campo de créditos
  ticketCreditsInput?.addEventListener('input', () => {
    const availableCredits = parseInt(
      ticketCreditsInput.dataset.availableCredits || '0'
    )
    const maxAllowed = Math.min(availableCredits, 100)
    const currentValue = parseInt(ticketCreditsInput.value) || 0

    // Si el valor excede el máximo permitido, ajustarlo automáticamente
    if (currentValue > maxAllowed) {
      ticketCreditsInput.value = maxAllowed.toString()

      // Mostrar feedback visual temporal (usando textContent para prevenir XSS)
      if (creditsHelpText) {
        creditsHelpText.textContent = ''
        const warningSpan = document.createElement('span')
        warningSpan.className = 'text-yellow-400'
        warningSpan.textContent = `⚠️ Máximo permitido: ${maxAllowed}`
        creditsHelpText.appendChild(warningSpan)
        setTimeout(() => {
          creditsHelpText.innerHTML = originalCreditsHelpText
        }, 2000)
      }
    }

    // Si el valor es menor que 1, ajustar a 1
    if (currentValue < 1 && ticketCreditsInput.value !== '') {
      ticketCreditsInput.value = '1'
    }
  })

  createTicketBtn?.addEventListener('click', () => {
    // No abrir modal si el botón está deshabilitado (sin créditos disponibles)
    if (
      createTicketBtn instanceof HTMLButtonElement &&
      createTicketBtn.disabled
    ) {
      notify('warning', 'No tienes créditos disponibles para crear tickets')
      return
    }
    createTicketModal?.classList.remove('hidden')
    createTicketModal?.classList.add('flex')
    ticketNameInput?.focus()
  })

  cancelCreateTicket?.addEventListener('click', () => {
    createTicketModal?.classList.add('hidden')
    createTicketModal?.classList.remove('flex')
    createTicketForm?.reset()
    // Limpiar mensajes de validación
    if (ticketAvailabilityEl) {
      ticketAvailabilityEl.textContent = ''
    }
    if (ticketCheckIcon) {
      ticketCheckIcon.classList.add('hidden')
    }
  })

  // Submit del formulario
  createTicketForm?.addEventListener('submit', async e => {
    e.preventDefault()

    const formData = new FormData(e.target as HTMLFormElement)
    const ticketName = (formData.get('ticketName') as string)
      .toUpperCase()
      .trim()
    const credits = parseInt(formData.get('credits') as string)
    const description = formData.get('description') as string

    // Validar nombre
    const error = validateTicketName(ticketName)
    if (error) {
      notify('error', error)
      return
    }

    // Validar disponibilidad antes de enviar
    if (!isCodeAvailable) {
      notify(
        'error',
        'El código del ticket no está disponible o no ha sido validado'
      )
      return
    }

    // Validar créditos (usar el elemento ya declarado al inicio del script)
    const maxCredits = parseInt(
      ticketCreditsInput?.dataset.availableCredits || '0'
    )
    const effectiveMax = Math.min(maxCredits, 100)

    if (!credits || credits < 1) {
      notify('error', 'Los créditos deben ser al menos 1')
      return
    }

    if (credits > effectiveMax) {
      notify(
        'error',
        `No puedes asignar más de ${effectiveMax} créditos (tienes ${maxCredits} disponibles)`
      )
      return
    }

    try {
      const resp = await fetch('/api/builders/tickets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: ticketName,
          credits: credits,
          description: description || null,
        }),
      })

      const data = await resp.json()

      if (resp.ok && data.success) {
        notify('success', `Ticket "${ticketName}" creado exitosamente!`, 3000)
        createTicketModal?.classList.add('hidden')
        createTicketModal?.classList.remove('flex')
        createTicketForm?.reset()

        // Wait 3 seconds for user to see toast before reload
        setTimeout(() => {
          location.reload()
        }, 3000)
      } else {
        notify('error', data.error || 'Error al crear el ticket')
      }
    } catch (error) {
      notify('error', 'Error de conexión')
    }
  })

  // Cerrar modal al hacer clic fuera
  createTicketModal?.addEventListener('click', e => {
    if (e.target === createTicketModal) {
      createTicketModal.classList.add('hidden')
      createTicketModal.classList.remove('flex')
      createTicketForm?.reset()
      // Limpiar mensajes de validación
      if (ticketAvailabilityEl) {
        ticketAvailabilityEl.textContent = ''
      }
      if (ticketCheckIcon) {
        ticketCheckIcon.classList.add('hidden')
      }
    }
  })

  // ===== TICKET ACTION MODAL =====
  import { initializeTicketModals } from '@/lib/admin_ui/ticket-modal-handlers'

  // Inicializar modales una vez que el DOM esté listo
  initializeTicketModals(notify)

  // ===== COPY LINK HANDLER =====
  document.querySelectorAll('.copy-link-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const ticketCode = (btn as HTMLElement).dataset.ticketCode
      if (!ticketCode) return

      try {
        const ticketUrl = `${window.location.origin}/?ticket=${ticketCode}`
        await navigator.clipboard.writeText(ticketUrl)
        notify('success', `Link copiado: ${ticketUrl}`, 2000)
      } catch (error) {
        console.error('Error copying to clipboard:', error)
        notify('error', 'Error al copiar el link')
      }
    })
  })
</script>
