---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import BuildersTabs from '@/components/ui/BuildersTabs.astro'
import BuildersCard from '@/components/ui/BuildersCard.astro'
import BuildersTable from '@/components/ui/BuildersTable.astro'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { buildersRepository } from '@/lib/repositories/builders-repository'

// Verificar autenticación y obtener usuario
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Obtener datos usando el servicio centralizado
// currentUser garantizado (ya se manejó el redirect arriba)
const username = (currentUser as any).username as string
const [accounts, stats] = await Promise.all([
  buildersRepository.getAccountsByUser(username),
  buildersRepository.getBuildersStats(username),
])

// Configurar columnas para la tabla de cuentas
const accountColumns = [
  {
    key: 'username',
    label: 'Usuario Hive',
    type: 'text' as const,
    width: 'w-40',
  },
  {
    key: 'ticket',
    label: 'Ticket',
    type: 'text' as const,
    width: 'w-32',
  },
  {
    key: 'ticket_type',
    label: 'Tipo de Ticket',
    type: 'badge' as const,
    badgeVariant: (value: string) => {
      const variants = {
        standard: 'info' as const,
        premium: 'success' as const,
        special: 'warning' as const,
      }
      return variants[value as keyof typeof variants] || ('info' as const)
    },
  },
  {
    key: 'public_key',
    label: 'Clave Pública',
    type: 'key' as const,
    truncate: true,
    width: 'w-48',
  },
  {
    key: 'creation_date',
    label: 'Fecha de Creación',
    type: 'date' as const,
  },
  {
    key: 'actions',
    label: 'Acciones',
    type: 'actions' as const,
    actions: [
      {
        label: 'Ver Detalles',
        icon: '👁️',
        onClick: 'viewAccountDetails',
        variant: 'primary' as const,
      },
      {
        label: 'Descargar Claves',
        icon: '💾',
        onClick: 'downloadKeys',
        variant: 'secondary' as const,
      },
    ],
  },
]

// Agrupar cuentas por tipo de ticket para estadísticas adicionales
const accountsByType = accounts.reduce(
  (acc, account) => {
    const type = account.ticket_type
    acc[type] = (acc[type] || 0) + 1
    return acc
  },
  {} as Record<string, number>
)
---

<BuildersLayout title="Cuentas Creadas - Builders" currentPage="accounts">
  <!-- Alinear con tickets: max-w-7xl, padding y título alineado izquierda -->
  <div class="mx-auto max-w-7xl space-y-10 px-4 py-6 sm:px-6 lg:px-8">
    <div>
      <h1 class="mb-2 text-3xl font-bold text-white">Cuentas Creadas</h1>
      <p class="text-gray-400">
        Historial completo de todas las cuentas Hive que has creado.
      </p>
    </div>
    <BuildersTabs active="accounts" />

    <!-- Cards de estadísticas -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <BuildersCard
        title="Total de Cuentas"
        value={stats.totalAccounts}
        description="Cuentas creadas exitosamente"
        icon="👥"
        variant="success"
      />

      <BuildersCard
        title="Cuentas Standard"
        value={accountsByType.standard || 0}
        description="Usando tickets estándar"
        icon="🎫"
        variant="info"
      />

      <BuildersCard
        title="Cuentas Premium"
        value={accountsByType.premium || 0}
        description="Usando tickets premium"
        icon="⭐"
        variant="warning"
      />

      <BuildersCard
        title="Tickets Activos"
        value={stats.totalActiveTickets}
        description={`Créditos restantes: ${stats.totalCreditsRemaining}`}
        icon="🎟️"
        variant="default"
      />
    </div>

    <!-- Tabla de Cuentas -->
    <BuildersTable
      title="Historial de Cuentas"
      data={accounts}
      columns={accountColumns}
      emptyMessage="No has creado cuentas aún"
      showSearch={true}
      searchPlaceholder="Buscar por usuario o ticket..."
    />

    <!-- Acciones Rápidas (alineadas al estilo de tickets, opcionales) -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <a
        href="/"
        class="group flex flex-col items-center space-y-4 rounded-lg border border-green-500/30 bg-green-600/20 p-8 text-green-400 transition-colors hover:bg-green-600/30"
      >
        <span class="text-6xl transition-transform group-hover:scale-110"
          >➕</span
        >
        <div class="text-center">
          <div class="mb-2 text-xl font-semibold">Crear Nueva Cuenta</div>
          <div class="text-sm opacity-80">
            Usar el formulario principal para crear más cuentas Hive
          </div>
        </div>
      </a>
      <a
        href="/builders/tickets"
        class="group flex flex-col items-center space-y-4 rounded-lg border border-blue-500/30 bg-blue-600/20 p-8 text-blue-400 transition-colors hover:bg-blue-600/30"
      >
        <span class="text-6xl transition-transform group-hover:scale-110"
          >🎟️</span
        >
        <div class="text-center">
          <div class="mb-2 text-xl font-semibold">Gestionar Tickets</div>
          <div class="text-sm opacity-80">Ver y administrar tus tickets</div>
        </div>
      </a>
    </div>
  </div>
</BuildersLayout>

<script>
  // Funciones para las acciones de la tabla
  function viewAccountDetails(accountId: string) {
    // Redirigir a la página de detalles
    window.location.href = `/details/${accountId}`
  }
</script>
