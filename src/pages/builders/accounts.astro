---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import StatCard from '@/components/ui/StatCard.astro'
import BuildersTable from '@/components/ui/BuildersTable.astro'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { usersRepository } from '@/lib/repositories/users-repository'

// Verificar autenticación y obtener usuario
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Obtener datos usando el servicio centralizado
// currentUser garantizado (ya se manejó el redirect arriba)
const username = (currentUser as any).username as string
const builder = await usersRepository.findByUsername(username)
const builderId = builder?.id

// Obtener cuentas y estadísticas
const [accounts, stats] = await Promise.all([
  builderId ? usersRepository.getAccountsByUser(builderId) : [],
  builderId
    ? usersRepository.getBuildersStats(builderId)
    : { totalAccounts: 0, totalActiveTickets: 0, totalCreditsRemaining: 0 },
])

// Obtener última cuenta creada para la 3ra card
const lastAccount = accounts.length > 0 ? accounts[0] : null

// Configurar columnas para la tabla de cuentas
const accountColumns = [
  {
    key: 'username',
    label: 'Usuario Hive',
    type: 'text' as const,
    width: 'w-1/3',
  },
  {
    key: 'ticket',
    label: 'Ticket',
    type: 'text' as const,
    width: 'w-1/3',
  },
  {
    key: 'creation_date',
    label: 'Fecha de Creación',
    type: 'date' as const,
    width: 'w-1/3',
  },
]
---

<BuildersLayout title="Cuentas Creadas - Builders" currentPage="accounts">
  <div class="mx-auto max-w-7xl space-y-4 sm:space-y-6 px-3 sm:px-4 py-4 sm:py-6 lg:px-8">
    <PageHeader
      title="Cuentas Creadas"
      description="Historial completo de todas las cuentas Hive que has creado."
    />

    <!-- Cards de estadísticas - Estilo Fintech -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <StatCard
        title="Total de cuentas"
        value={stats.totalAccounts}
        unit="cuentas"
        description="Cuentas creadas exitosamente"
      />

      <StatCard
        title="Tickets activos"
        value={stats.totalActiveTickets}
        unit="tickets"
        description={`Créditos restantes: ${stats.totalCreditsRemaining}`}
      />

      <StatCard
        title="Última cuenta creada"
        value={lastAccount?.username || 'N/A'}
        unit=""
        description="Cuenta más reciente"
        timestamp={lastAccount?.creation_date}
      />
    </section>

    <!-- Tabla de Cuentas -->
    <BuildersTable
      title="Historial de Cuentas"
      data={accounts}
      columns={accountColumns}
      emptyMessage="No has creado cuentas aún"
      showSearch={true}
      searchPlaceholder="Buscar por usuario o ticket..."
    />
  </div>
</BuildersLayout>
