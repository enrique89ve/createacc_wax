---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import StatCard from '@/components/ui/StatCard.astro'
import BuildersTable from '@/components/ui/BuildersTable.astro'
import { usersRepository } from '@/lib/repositories/users-repository'
import { DEFAULT_LOCALE, getMessages, interpolate } from '@/i18n'

const builderUser = Astro.locals.builderUser
const copy =
  Astro.locals.messages ?? getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const page = copy.buildersArea.accounts
const accountState = copy.states.account
if (!builderUser) return Astro.redirect('/builders/login')

let accounts: Awaited<ReturnType<typeof usersRepository.getAccountsByUser>> = []
let stats = {
  totalAccounts: 0,
  totalActiveTickets: 0,
  totalCreditsRemaining: 0,
}

if (builderUser) {
  const builderId = builderUser.username
  const [fetchedAccounts, fetchedStats] = await Promise.all([
    usersRepository.getAccountsByUser(builderId),
    usersRepository.getBuildersStats(builderId),
  ])
  accounts = fetchedAccounts
  stats = fetchedStats
}

// Obtener última cuenta creada para la 3ra card
const lastAccount = accounts.length > 0 ? accounts[0] : null

// Configurar columnas para la tabla de cuentas
const accountColumns = [
  {
    key: 'username',
    label: page.hiveUser,
    type: 'text' as const,
    width: 'w-1/3',
  },
  {
    key: 'status_label',
    label: copy.ui.status,
    format: (value: unknown) => {
      const code = String(value)
      if (code === 'SIMULATED') return accountState.simulated
      if (code === 'BROADCASTED') return accountState.broadcasted
      if (code === 'CONFIRMED') return accountState.confirmed
      if (code === 'FAILED') return accountState.failed
      return code
    },
    type: 'badge' as const,
    width: 'w-1/6',
    badgeVariant: (value: unknown) =>
      value === 'SIMULATED' || value === 'BROADCASTED'
        ? 'warning'
        : value === 'FAILED'
          ? 'danger'
          : 'success',
  },
  {
    key: 'ticket',
    label: 'Ticket',
    type: 'text' as const,
    width: 'w-1/4',
  },
  {
    key: 'creation_date',
    label: page.createdAt,
    type: 'date' as const,
    width: 'w-1/3',
  },
]
---

<BuildersLayout title={page.title} currentPage="accounts">
  <div
    class="mx-auto max-w-7xl space-y-4 px-3 py-4 sm:space-y-6 sm:px-4 sm:py-6 lg:px-8"
  >
    <PageHeader
      title={page.title}
      description={page.description}
    />

    <!-- Cards de estadísticas - Estilo Fintech -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <StatCard
        title={page.total}
        value={stats.totalAccounts}
        unit={page.accountsUnit}
        description={page.totalHelp}
      />

      <StatCard
        title={page.activeTickets}
        value={stats.totalActiveTickets}
        unit={page.ticketsUnit}
        description={interpolate(page.remaining, {
          count: String(stats.totalCreditsRemaining),
        })}
      />

      <StatCard
        title={page.last}
        value={lastAccount?.username || page.none}
        unit=""
        description={page.lastHelp}
        timestamp={lastAccount?.creation_date}
      />
    </section>

    <!-- Tabla de Cuentas -->
    <BuildersTable
      title={page.history}
      data={accounts}
      columns={accountColumns}
      emptyMessage={page.empty}
      showSearch
      searchPlaceholder={page.search}
    />
  </div>
</BuildersLayout>
