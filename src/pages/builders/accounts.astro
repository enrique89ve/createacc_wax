---
import BuildersLayout from '@/layouts/BuildersLayout.astro'
import BuildersTabs from '@/components/ui/BuildersTabs.astro'
import BuildersTable from '@/components/ui/BuildersTable.astro'
import { getAuthenticatedUser } from '@/lib/admin/auth/helpers/auth-guards'
import { usersRepository } from '@/lib/repositories/users-repository'

// Verificar autenticación y obtener usuario
const currentUser = await getAuthenticatedUser(Astro, 'builders')

// Si currentUser es una Response, significa que se está redirigiendo
if (currentUser instanceof Response) {
  return currentUser
}

// Obtener datos usando el servicio centralizado
// currentUser garantizado (ya se manejó el redirect arriba)
const username = (currentUser as any).username as string
const builder = await usersRepository.findByUsername(username)
const builderId = builder?.id

// Obtener cuentas y estadísticas
const [accounts, stats] = await Promise.all([
  builderId ? usersRepository.getAccountsByUser(builderId) : [],
  builderId
    ? usersRepository.getBuildersStats(builderId)
    : { totalAccounts: 0, totalActiveTickets: 0, totalCreditsRemaining: 0 },
])

// Configurar columnas para la tabla de cuentas
const accountColumns = [
  {
    key: 'username',
    label: 'Usuario Hive',
    type: 'text' as const,
    width: 'w-1/3',
  },
  {
    key: 'ticket',
    label: 'Ticket',
    type: 'text' as const,
    width: 'w-1/3',
  },
  {
    key: 'creation_date',
    label: 'Fecha de Creación',
    type: 'date' as const,
    width: 'w-1/3',
  },
]
---

<BuildersLayout title="Cuentas Creadas - Builders" currentPage="accounts">
  <!-- Alinear con tickets: max-w-7xl, padding y título alineado izquierda -->
  <div class="mx-auto max-w-7xl space-y-10 px-4 py-6 sm:px-6 lg:px-8">
    <div>
      <h1 class="mb-2 text-3xl font-bold text-white">Cuentas Creadas</h1>
      <p class="text-gray-400">
        Historial completo de todas las cuentas Hive que has creado.
      </p>
    </div>
    <BuildersTabs active="accounts" />

    <!-- Cards de estadísticas - Estilo Fintech -->
    <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <!-- Tarjeta 1: Total de Cuentas -->
      <div
        class="bg-card group relative overflow-hidden rounded-lg border border-gray-700/60 p-6 transition-all hover:border-gray-600/80"
      >
        <!-- Contenido principal -->
        <div class="mb-4">
          <p
            class="text-muted-foreground mb-1 text-xs font-medium uppercase tracking-wide"
          >
            Total de cuentas
          </p>
          <div class="flex items-baseline gap-2">
            <span
              class="text-foreground text-4xl font-semibold tabular-nums tracking-tight"
            >
              {stats.totalAccounts}
            </span>
            <span class="text-muted-foreground text-sm font-medium"
              >cuentas</span
            >
          </div>
        </div>

        <!-- Información secundaria -->
        <p class="text-muted-foreground mb-4 text-xs leading-relaxed">
          Cuentas creadas exitosamente
        </p>
      </div>

      <!-- Tarjeta 2: Tickets Activos -->
      <div
        class="bg-card group relative overflow-hidden rounded-lg border border-gray-700/60 p-6 transition-all hover:border-gray-600/80"
      >
        <!-- Contenido principal -->
        <div class="mb-4">
          <p
            class="text-muted-foreground mb-1 text-xs font-medium uppercase tracking-wide"
          >
            Tickets activos
          </p>
          <div class="flex items-baseline gap-2">
            <span
              class="text-foreground text-4xl font-semibold tabular-nums tracking-tight"
            >
              {stats.totalActiveTickets}
            </span>
            <span class="text-muted-foreground text-sm font-medium"
              >tickets</span
            >
          </div>
        </div>

        <!-- Información secundaria -->
        <p class="text-muted-foreground mb-4 text-xs leading-relaxed">
          Créditos restantes: {stats.totalCreditsRemaining}
        </p>
      </div>
    </section>

    <!-- Tabla de Cuentas -->
    <BuildersTable
      title="Historial de Cuentas"
      data={accounts}
      columns={accountColumns}
      emptyMessage="No has creado cuentas aún"
      showSearch={true}
      searchPlaceholder="Buscar por usuario o ticket..."
    />
  </div>
</BuildersLayout>
