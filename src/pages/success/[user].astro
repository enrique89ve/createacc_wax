---
import Layout from '@/layouts/Layout.astro'
import CreationStepper from '@/components/ui/CreationStepper.astro'
import Card from '@/components/ui/Card.astro'
import { validateAccountName } from '@/utils/validate-username'
import KeychainSection from '@/sections/success/KeychainSection.astro'
import AppsSection from '@/sections/success/AppsSection.astro'
import CommunityCTASection from '@/sections/success/CommunityCTASection.astro'
import type { CreationSession } from '@/types/auth'
import { shouldUseSecureCookie } from '@/utils/cookie-helpers'
import { signValue, verifySignedValue } from '@/lib/session-cookies'
import { DEFAULT_LOCALE, getMessages } from '@/i18n'
import { isSimulationMode } from '@/lib/hive-execution-mode'

const { user } = Astro.params

if (!user || typeof user !== 'string') {
  return Astro.redirect('/')
}

const usernameError = validateAccountName(user)
if (usernameError) {
  return Astro.redirect('/')
}

let allowAccess = false
const creationSession: CreationSession | undefined = Astro.locals.creation

if (
  creationSession &&
  creationSession.username === user &&
  creationSession.accountCreated
) {
  allowAccess = true
  try {
    const { clearCreationCookie } = await import('@/lib/session-cookies')
    clearCreationCookie(Astro.cookies)
  } catch (_error) {
    // Non-critical: session cleanup is best-effort; cookie will expire naturally
  }
  Astro.cookies.set('success_account', signValue(user), {
    httpOnly: true,
    sameSite: 'strict',
    path: `/success/${user}`,
    maxAge: 15 * 60,
    secure: shouldUseSecureCookie(Astro.request),
  })
} else {
  const cookie = Astro.cookies.get('success_account')
  if (cookie?.value) {
    const verifiedUser = verifySignedValue(cookie.value)
    if (verifiedUser && verifiedUser === user) {
      allowAccess = true
    }
  }
}

if (!allowAccess) {
  return Astro.redirect('/')
}

const copy =
  Astro.locals.messages ??
  getMessages(Astro.locals.locale ?? DEFAULT_LOCALE)
const simulated = isSimulationMode()
const successCopy = simulated ? copy.success.simulated : copy.success

Astro.response.headers.set('Cache-Control', 'private, no-store')
---

<Layout title={successCopy.title} description={successCopy.metaDescription}>
  <div class="pt-6">
    <CreationStepper />
  </div>
  <section
    class="flex min-h-screen w-full items-start justify-center px-4 py-16 md:items-center"
  >
    <div class="w-full max-w-2xl">
      <Card class="relative overflow-hidden p-8">
        <div
          aria-hidden="true"
          class="ring-success/15 pointer-events-none absolute inset-0 rounded-lg ring-1 ring-inset"
        >
        </div>
        <header class="mb-10 text-center">
          <div
            class="border-success/35 bg-success/10 text-success mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full border"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h1
            class="text-foreground mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {successCopy.welcomeTitle}
          </h1>
          <p
            class="text-muted-foreground mx-auto mb-4 max-w-xl text-sm leading-relaxed md:text-base"
          >
            {successCopy.accountCreatedLead}
            {
              simulated ? (
                <kbd class="border-success/40 bg-success/10 text-success inline-flex items-center rounded-md border px-2.5 py-0.5 text-base font-semibold shadow-sm">
                  @{user}
                </kbd>
              ) : (
                <a
                  href={`https://hivehub.dev/@${user}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus:ring-success/40 inline-block rounded focus:outline-none focus:ring-2"
                >
                  <kbd class="border-success/40 bg-success/10 text-success inline-flex items-center rounded-md border px-2.5 py-0.5 text-base font-semibold shadow-sm transition-transform will-change-transform hover:scale-105">
                    @{user}
                  </kbd>
                </a>
              )
            }
            {successCopy.accountCreatedTail}
          </p>
          <p class="text-muted-foreground text-sm md:text-base">
            {successCopy.readySubtitle}
          </p>
        </header>
        {
          !simulated && (
            <div class="mx-auto mt-8 flex max-w-sm justify-center">
              <a
                href="#keychain"
                class="bg-primary text-primary-foreground focus:ring-primary/40 hover:bg-primary/90 inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold shadow-sm transition-colors focus:outline-none focus:ring-2"
              >
                {copy.success.keychainCta} <span aria-hidden="true">↓</span>
              </a>
            </div>
          )
        }
      </Card>
      {!simulated && <KeychainSection />}
      {!simulated && <AppsSection />}
      <CommunityCTASection />
    </div>
  </section>
</Layout>
