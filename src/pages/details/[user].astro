---
import Layout from '@/layouts/Layout.astro'
import CreationStepper from '@/components/ui/CreationStepper.astro'
import AccountDetails from '@/components/AccountDetails.astro'
import { validateAccountName } from '@/utils/validate-username'
import type { CreationSession } from '@/types/auth'
import { logger } from '@/lib/logger'

const { user } = Astro.params

if (!user || typeof user !== 'string') {
  return Astro.redirect('/access-denied')
}

const usernameError = validateAccountName(user)
if (usernameError) {
  logger.warn('[details] Invalid username format in URL')
  return Astro.redirect('/access-denied')
}

const creationSession: CreationSession | undefined = Astro.locals.creation
if (!creationSession) {
  return Astro.redirect('/access-denied')
}

if (user !== creationSession.username) {
  return Astro.redirect('/access-denied')
}

if (creationSession.accountCreated) {
  return Astro.redirect(`/success/${encodeURIComponent(user)}`)
}
---

<Layout noindex>
  <div class="pt-6">
    <CreationStepper />
  </div>
  <div class="mt-10">
    <AccountDetails username={user} />
  </div>
</Layout>
