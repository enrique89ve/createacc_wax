{
  "name": "holahive-create-account-app",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run db:init && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:init": "tsx scripts/init-database.ts",
    "db:reset": "rm -f holahive.db && pnpm run db:init",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:quickstart": "pnpm run db:reset && pnpm run db:seed",
    "reconcile:pending": "tsx scripts/reconcile-pending.ts",
    "reconcile:pending:dry-run": "tsx scripts/reconcile-pending.ts --dry-run",
    "admin:setup": "tsx scripts/admin-setup.ts",
    "admin:create": "tsx scripts/admin-setup.ts create",
    "admin:reset": "tsx scripts/admin-setup.ts reset",
    "admin:check": "tsx scripts/admin-setup.ts check",
    "check": "astro check && tsc --noEmit && eslint .",
    "test": "vitest run",
    "wax:self-test": "tsx scripts/wax-self-test.ts",
    "test:simulation": "tsx scripts/test-account-simulation.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.3",
    "@fontsource-variable/sora": "^5.2.6",
    "@hiveio/beekeeper": "1.28.7-rc0",
    "@hiveio/wax": "2.0.2",
    "@libsql/client": "^0.15.12",
    "@libsql/kysely-libsql": "0.4.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/bcryptjs": "^3.0.0",
    "astro": "^7.2.3",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.7.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/set-cookie-parser": "^2.4.10",
    "@typescript-eslint/parser": "^8.39.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "neostandard": "^0.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.4",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
