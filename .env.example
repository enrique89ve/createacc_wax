# ==================================
# ENVIRONMENT CONFIGURATION
# ==================================
# Copy this file to .env.local and fill with your values
# The same .env.local works for both development and production

# ==================================
# Hive Blockchain Configuration
# ==================================
HIVE_CREATOR_ACCOUNT=your-creator-account
HIVE_DELEGATOR_ACCOUNT=your-delegator-account
HIVE_CREATOR_ACTIVE_KEY=5JNHfZY.....
HIVE_DELEGATOR_POSTING_KEY=5JNHfZY.....

# ==================================
# Database Configuration
# ==================================
# Mode 1 - Local SQLite (Dokploy/Docker): No config needed, defaults to file:holahive.db
# Mode 2 - Turso Cloud (Vercel/Serverless): Uncomment and fill both values
# DATABASE_URL=libsql://your-database-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
# Mode 3 - Embedded Replica (Dokploy + cloud backup): Set DATABASE_URL=file:replica.db + both Turso vars
# TURSO_SYNC_URL=libsql://your-database-org.turso.io

# ==================================
# Hive execution mode
# ==================================
# Hive RPC is always mainnet. This env only decides whether txs are broadcast.
# Dev (default): simulate — WAX/Beekeeper/DB run, no Hive broadcast
# Live:          broadcast + confirm
HIVE_TX_MODE=simulate
# HIVE_BROADCAST_CONFIRM=HIVE_MAINNET

# ==================================
# Auth Configuration
# ==================================
AUTH_SECRET=change-this-to-a-random-secret-min-32-chars
# Set to true ONLY behind a trusted reverse proxy that rewrites X-Forwarded-For/X-Real-IP
# Keep false by default to avoid spoofed IP headers affecting rate-limit logic
TRUST_PROXY_HEADERS=false

# ==================================
# Session Security Configuration
# ==================================
# Required for signing session cookies (HMAC-SHA256)
# Generate with: openssl rand -base64 64
# Must be at least 32 characters for production
SESSION_SECRET=generate-a-random-secret-at-least-64-characters-long-use-openssl-rand-base64-64

# ==================================
# Beekeeper Configuration
# ==================================
BEEKEEPER_WALLET_PASSWORD=your-secure-wallet-password

# ==================================
# Admin Setup (Optional)
# ==================================
# For automated admin creation via: pnpm admin:create
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=YourSecurePassword123!
