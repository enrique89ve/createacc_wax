# ==================================
# ENVIRONMENT CONFIGURATION
# ==================================
# Copy this file to .env.local and fill with your values
# The same .env.local works for both development and production

# ==================================
# Hive Blockchain Configuration
# ==================================
HIVE_CREATOR_ACCOUNT=your-creator-account
HIVE_DELEGATOR_ACCOUNT=your-delegator-account
HIVE_CREATOR_ACTIVE_KEY=5JNHfZY.....
HIVE_DELEGATOR_ACTIVE_KEY=5JNHfZY.....

# ==================================
# Environment Mode
# ==================================
# Development: MAINNET=false (uses testnet: api.fake.openhive.network)
# Production:  MAINNET=TRUE (uses mainnet with failover)
MAINNET=false

# ==================================
# Auth Configuration
# ==================================
AUTH_SECRET=change-this-to-a-random-secret-min-32-chars

# ==================================
# Beekeeper Configuration
# ==================================
BEEKEEPER_WALLET_PASSWORD=your-secure-wallet-password

# ==================================
# Admin Setup (Optional)
# ==================================
# For automated admin creation via: pnpm admin:create
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=YourSecurePassword123!